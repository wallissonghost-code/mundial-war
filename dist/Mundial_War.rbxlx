</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">MapGrid</string><ProtectedString name="Source">-- Mundial War · geographic grid shared by server and client.
-- Cells are numbered i = y*W + x + 1 (x, y zero-based). This module only holds geography;
-- ownership lives in the server's TerritoryService and the client's ClientState.
local MapGrid = {}
MapGrid.__index = MapGrid

local LAT_TOP = 84.0

local function decodeBase62(alphabet)
	local lookup = {}
	for k = 1, #alphabet do
		lookup[string.byte(alphabet, k)] = k - 1
	end
	return lookup
end

function MapGrid.new(data)
	local self = setmetatable({}, MapGrid)
	local W, H = data.W, data.H
	self.W, self.H, self.N = W, H, W * H
	self.countries = data.Countries
	self.country = {}   -- country index per cell (0 = water)
	self.land = {}      -- true for land
	self.coast = {}     -- land touching water
	self.polar = {}     -- row index -&gt; true beyond 66 degrees latitude
	self.latitude = {}  -- row index -&gt; latitude in degrees (cell centre)
	self.landCount = 0

	local lookup = decodeBase62(data.Alphabet)
	local country, land = self.country, self.land
	for y = 0, H - 1 do
		local row = data.Rows[y + 1]
		local x = 0
		for k = 1, #row, 4 do
			local b1, b2, b3, b4 = string.byte(row, k, k + 3)
			local id = lookup[b1] * 62 + lookup[b2]
			local len = lookup[b3] * 62 + lookup[b4]
			for c = x, x + len - 1 do
				local i = y * W + c + 1
				country[i] = id
				if id &gt; 0 then
					land[i] = true
					self.landCount = self.landCount + 1
				end
			end
			x = x + len
		end
		assert(x == W, "MapData row " .. y .. " has wrong width")
	end
	for i = 1, self.N do
		if land[i] then
			local x = (i - 1) % W
			if (x &gt; 0 and not land[i - 1]) or (x &lt; W - 1 and not land[i + 1])
				or (i &gt; W and not land[i - W]) or (i &lt;= self.N - W and not land[i + W]) then
				self.coast[i] = true
			end
		end
	end
	local ySpan = 2 * math.pi * H / W
	local yTop = 1.25 * math.log(math.tan(math.pi / 4 + 0.4 * math.rad(LAT_TOP)))
	for y = 0, H - 1 do
		local my = yTop - (y + 0.5) / H * ySpan
		local lat = math.deg(2.5 * math.atan(math.exp(0.8 * my)) - 0.625 * math.pi)
		self.latitude[y] = lat
		if math.abs(lat) &gt; 66 then
			self.polar[y] = true
		end
	end
	return self
end

function MapGrid:xy(i)
	return (i - 1) % self.W, (i - 1 - (i - 1) % self.W) / self.W
end

function MapGrid:index(x, y)
	if x &lt; 0 or y &lt; 0 or x &gt;= self.W or y &gt;= self.H then
		return nil
	end
	return y * self.W + x + 1
end

function MapGrid:valid(i)
	return type(i) == "number" and i == i and i % 1 == 0 and i &gt;= 1 and i &lt;= self.N
end

-- Writes the up-to-4 orthogonal neighbours of i into out[1..n] and returns n.
function MapGrid:neighbors(i, out)
	local W, n = self.W, 0
	local x = (i - 1) % W
	if x &gt; 0 then n = n + 1 out[n] = i - 1 end
	if x &lt; W - 1 then n = n + 1 out[n] = i + 1 end
	if i &gt; W then n = n + 1 out[n] = i - W end
	if i &lt;= self.N - W then n = n + 1 out[n] = i + W end
	return n
end

function MapGrid:distance(a, b)
	local W = self.W
	local dx = (a - 1) % W - (b - 1) % W
	local dy = ((a - 1) - (a - 1) % W) / W - ((b - 1) - (b - 1) % W) / W
	return math.sqrt(dx * dx + dy * dy)
end

function MapGrid:isPolar(i)
	local _, y = self:xy(i)
	return self.polar[y] == true
end

-- Calls fn(i) for every cell inside a disc; stops early if fn returns true.
function MapGrid:disc(center, radius, fn)
	local cx, cy = self:xy(center)
	local r = math.floor(radius)
	for y = math.max(0, cy - r), math.min(self.H - 1, cy + r) do
		for x = math.max(0, cx - r), math.min(self.W - 1, cx + r) do
			local dx, dy = x - cx, y - cy
			if dx * dx + dy * dy &lt;= radius * radius then
				if fn(y * self.W + x + 1) then
					return
				end
			end
		end
	end
end

-- Connected land masses (continents and islands): cell -&gt; mass id, plus sizes.
function MapGrid:landmasses()
	local mass, sizes, nb = {}, {}, {}
	local id = 0
	for start = 1, self.N do
		if self.land[start] and not mass[start] then
			id = id + 1
			local queue, head = { start }, 1
			mass[start] = id
			while head &lt;= #queue do
				local i = queue[head]
				head = head + 1
				local n = self:neighbors(i, nb)
				for k = 1, n do
					local j = nb[k]
					if self.land[j] and not mass[j] then
						mass[j] = id
						queue[#queue + 1] = j
					end
				end
			end
			sizes[id] = #queue
		end
	end
	return mass, sizes
end

function MapGrid:countryByCode(code)
	for index, c in ipairs(self.countries) do
		if c.code == code then
			return index, c
		end
	end
	return nil
end

return MapGrid
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Palette</string><ProtectedString name="Source">-- Mundial War · readable, non-neon colours (RGB 0..255). Shared so the server can
-- pick colours that differ from nearby nations and the client can paint them.
local Palette = {}

Palette.Water = { 46, 92, 138 }
Palette.WaterCoast = { 62, 112, 158 }
Palette.Neutral = { 214, 208, 192 }
Palette.NeutralPolar = { 228, 230, 228 }
Palette.NeutralCoast = { 198, 192, 176 }
Palette.CountryLine = { 188, 181, 163 }

Palette.Nations = {
	{ 66, 120, 196 }, { 196, 72, 68 }, { 72, 160, 92 }, { 222, 178, 60 }, { 142, 92, 182 },
	{ 46, 166, 168 }, { 218, 120, 50 }, { 190, 88, 150 }, { 120, 152, 52 }, { 96, 96, 168 },
	{ 168, 116, 76 }, { 70, 132, 120 }, { 206, 96, 112 }, { 148, 168, 214 }, { 112, 70, 60 },
	{ 230, 150, 140 }, { 86, 180, 220 }, { 160, 50, 90 }, { 180, 200, 110 }, { 58, 84, 120 },
	{ 214, 196, 120 }, { 120, 92, 140 }, { 60, 140, 70 }, { 236, 126, 86 }, { 104, 116, 84 },
	{ 176, 140, 200 }, { 146, 60, 46 }, { 90, 196, 150 }, { 200, 160, 100 }, { 70, 100, 70 },
	{ 156, 112, 120 }, { 110, 150, 180 }, { 230, 200, 80 }, { 130, 80, 40 }, { 160, 210, 190 },
	{ 100, 60, 120 }, { 190, 130, 60 }, { 60, 160, 200 }, { 210, 110, 170 }, { 140, 140, 60 },
}

function Palette.distance(a, b)
	local dr, dg, db = a[1] - b[1], a[2] - b[2], a[3] - b[3]
	-- weighted RGB distance; close enough to perceptual for picking contrasting neighbours
	return math.sqrt(2 * dr * dr + 4 * dg * dg + 3 * db * db)
end

function Palette.shade(c, factor)
	return {
		math.floor(math.max(0, math.min(255, c[1] * factor))),
		math.floor(math.max(0, math.min(255, c[2] * factor))),
		math.floor(math.max(0, math.min(255, c[3] * factor))),
	}
end

function Palette.mix(a, b, t)
	return {
		math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
		math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
		math.floor(a[3] + (b[3] - a[3]) * t + 0.5),
	}
end

return Palette
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Protocol</string><ProtectedString name="Source">-- Mundial War · names shared by client and server so remote traffic stays consistent.
local Protocol = {}

Protocol.CommandRemote = "MW_Command"   -- client -&gt; server: (action, a, b)
Protocol.EventRemote = "MW_Event"       -- server -&gt; client: { k = kind, ... }

Protocol.Actions = {
	Sync = "sync",
	Spawn = "spawn",           -- (cell)
	Target = "target",         -- (cell, percent) land expansion/attack, or naval when no land route
	Cancel = "cancel",         -- (orderId or nil = all)
	Build = "build",           -- (cell, kind)
	Warship = "warship",       -- (portCell) buy a defence boat
	Patrol = "patrol",         -- (boatId, waterCell)
	Upgrade = "upgrade",       -- (cell)
	Weapon = "weapon",         -- (cell, weaponKind, percent) percent is used by the air bridge
	Vote = "vote",             -- (modeName) during the vote phase
	Nuke = "nuke",             -- (cell)
	Airstrike = "airstrike",   -- (cell)
	Ally = "ally",             -- (nationId) request or accept
	Decline = "decline",       -- (nationId)
	BreakAlliance = "breakAlliance", -- (nationId)
	War = "war",               -- (nationId)
}

Protocol.Events = {
	Init = "init",
	Tick = "tick",
	Nations = "nations",
	Orders = "orders",
	Notice = "notice",
	Diplomacy = "diplomacy",
	Match = "match",
	Impact = "impact",
	Debug = "debug",
}

Protocol.Phases = { Waiting = "waiting", Spawn = "spawn", Playing = "playing", Ended = "ended" }

-- Owner snapshots travel as run-length pairs {owner, count, owner, count, ...}.
function Protocol.encodeRuns(owner, n)
	local out, k = {}, 0
	local i = 1
	while i &lt;= n do
		local v = owner[i]
		local j = i + 1
		while j &lt;= n and owner[j] == v do
			j = j + 1
		end
		out[k + 1] = v
		out[k + 2] = j - i
		k = k + 2
		i = j
	end
	return out
end

function Protocol.decodeRuns(runs, into)
	local i = 1
	for k = 1, #runs, 2 do
		local v, len = runs[k], runs[k + 1]
		for c = i, i + len - 1 do
			into[c] = v
		end
		i = i + len
	end
	return i - 1
end

function Protocol.clamp(v, lo, hi)
	if v &lt; lo then return lo end
	if v &gt; hi then return hi end
	return v
end

function Protocol.formatK(n)
	n = math.floor(n or 0)
	if n &gt;= 1000000 then
		return string.format("%.1fM", n / 1000000)
	elseif n &gt;= 10000 then
		return string.format("%.1fK", n / 1000)
	elseif n &gt;= 1000 then
		return string.format("%.2fK", n / 1000)
	end
	return tostring(n)
end

return Protocol
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000B"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000C"><Properties><string name="Name">MundialWar</string><ProtectedString name="Source">-- Mundial War · server bootstrap. Builds the world from the modules and drives it from Heartbeat.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("MundialWarShared")
local Config = require(Shared.GameConfig)

Players.CharacterAutoLoads = false   -- the nation is the character; no avatar walks on the map

local World = require(script.World)
local NetworkService = require(script.NetworkService)

local world = World.new({
	Config = Config,
	MapData = require(Shared.MapData),
	MapGrid = require(Shared.MapGrid),
	BuildingStats = require(Shared.BuildingStats),
	Palette = require(Shared.Palette),
	Protocol = require(Shared.Protocol),
	random = math.random,
	Services = {
		Territory = require(script.TerritoryService),
		Nations = require(script.NationService),
		Economy = require(script.EconomyService),
		Combat = require(script.CombatService),
		Buildings = require(script.BuildingService),
		Expansion = require(script.ExpansionService),
		Naval = require(script.NavalService),
		Strategic = require(script.StrategicService),
		Diplomacy = require(script.DiplomacyService),
		Bots = require(script.BotService),
		Match = require(script.MatchService),
		Commands = require(script.CommandService),
	},
})

NetworkService.start(world)

local failures = 0
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.25)   -- a long server hitch must not fast-forward the whole match
	local ok, err = pcall(function()
		world:step(dt, #Players:GetPlayers(), os.clock)
		NetworkService.flush(dt)
	end)
	if not ok then
		failures = failures + 1
		if failures &lt;= 20 or failures % 100 == 0 then
			warn("[MundialWar] simulation error #" .. failures .. ": " .. tostring(err))
		end
	end
end)

if Config.DEBUG_MODE then
	task.spawn(function()
		while true do
			task.wait(10)
			local s = world.stats
			if s.simCount &gt; 0 then
				print(string.format("[MundialWar] avg step %.2f ms, worst %.2f ms", s.simTime / s.simCount * 1000, s.worst * 1000))
				s.simTime, s.simCount, s.worst = 0, 0, 0
			end
		end
	end)
end
</ProtectedString><token name="RunContext">0</token></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">BotService</string><ProtectedString name="Source">-- Mundial War · AI nations (real countries at their capitals) and small tribes.
-- Each bot thinks on its own staggered schedule; nothing runs per frame for every bot.
local BotService = {}

local ctx, Config, Map, Territory
local bots = {}              -- nid -&gt; { nid, kind, nextThink, state, lastNaval, lastBuild }
local countryCells = nil     -- country index -&gt; list of cells
local coastCells = nil

BotService.States = {
	Expanding = "EXPANDING", Consolidating = "CONSOLIDATING", Defending = "DEFENDING",
	Attacking = "ATTACKING", Building = "BUILDING", Naval = "NAVAL", Recovering = "RECOVERING",
}
local S = BotService.States

function BotService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
	Territory = ctx.Territory
	countryCells, coastCells = {}, {}
	for i = 1, Map.N do
		local c = Map.country[i]
		if c &gt; 0 then
			local list = countryCells[c]
			if not list then list = {} countryCells[c] = list end
			list[#list + 1] = i
			if Map.coast[i] then coastCells[#coastCells + 1] = i end
		end
	end
end

function BotService.reset()
	bots = {}
end

function BotService.all()
	return bots
end

local function findSpawn(countryIndex, preferred)
	if ctx.Nations.canSpawnAt(preferred) then return preferred end
	local best, bestD = nil, math.huge
	for _, i in ipairs(countryCells[countryIndex] or {}) do
		local d = Map:distance(i, preferred)
		if d &lt; bestD and ctx.Nations.canSpawnAt(i) then best, bestD = i, d end
	end
	return best
end

local function thinkInterval(kind)
	if kind == "tribe" then return Config.Bots.TribeThinkInterval end
	if ctx.mode == "extreme" then return Config.Bots.ExtremeThinkInterval end
	return Config.Bots.ThinkInterval
end

local function register(n, kind, index, total)
	local interval = thinkInterval(kind)
	bots[n.id] = {
		nid = n.id, kind = kind, state = S.Expanding,
		nextThink = ctx.now() + interval * (index / math.max(1, total)),
		lastNaval = -1e9, lastAttack = -1e9,
	}
end

-- AI nations take the largest countries; tribes take random other countries.
function BotService.spawnAll()
	local list = {}
	for index, c in ipairs(Map.countries) do
		list[#list + 1] = { index = index, cells = c.cells }
	end
	table.sort(list, function(a, b) return a.cells &gt; b.cells end)
	local made = 0
	local plan = {}
	for _, entry in ipairs(list) do
		if made &gt;= Config.Bots.Nations then break end
		plan[#plan + 1] = { kind = "bot", index = entry.index }
		made = made + 1
	end
	local rest = {}
	for k = made + 1, #list do
		if list[k].cells &gt;= 12 then rest[#rest + 1] = list[k].index end
	end
	for k = #rest, 2, -1 do
		local j = math.floor(ctx.random() * k) + 1
		rest[k], rest[j] = rest[j], rest[k]
	end
	for k = 1, math.min(Config.Bots.Tribes, #rest) do
		plan[#plan + 1] = { kind = "tribe", index = rest[k] }
	end
	for order, p in ipairs(plan) do
		local country = Map.countries[p.index]
		local cell = findSpawn(p.index, country.capital)
		if cell then
			local name = p.kind == "bot" and country.name or ("Tribos de " .. country.name)
			local n = ctx.Nations.create(p.kind, name, cell, { country = p.index })
			if n then register(n, p.kind, order, #plan) end
		end
	end
end

-- Conquista Extrema: every country big enough starts as an AI nation that owns all of it.
function BotService.spawnCountries()
	local E = Config.Extreme
	local list = {}
	for index, c in ipairs(Map.countries) do
		if countryCells[index] and #countryCells[index] &gt;= E.MinCountryCells then list[#list + 1] = index end
	end
	for order, index in ipairs(list) do
		local c = Map.countries[index]
		local cells = countryCells[index]
		local n = ctx.Nations.create("bot", c.name, c.capital, {
			country = index, cells = cells, troops = E.BaseTroops + #cells * E.TroopsPerCell,
			gold = E.StartGold, oil = E.StartOil,
		})
		if n then register(n, "bot", order, #list) end
	end
end

-- A player left a country in Conquista Extrema: the AI governs it again.
function BotService.adopt(nid)
	local n = ctx.Nations.get(nid)
	if n and n.alive then register(n, "bot", 0, 1) end
end

-- A player took this nation over: stop its AI.
function BotService.release(nid)
	bots[nid] = nil
end

-- Alliance policy when someone asks a bot.
function BotService.considerAlliance(botId, requesterId)
	local bot, other = ctx.Nations.get(botId), ctx.Nations.get(requesterId)
	if not bot or not other then return false end
	local allies = #ctx.Diplomacy.allies(botId)
	if allies &gt;= 3 then return false end
	local b = bots[botId]
	if b and ctx.now() - b.lastAttack &lt; 20 and b.lastTarget == requesterId then return false end
	if bot.kind == "tribe" then return other.troops &gt;= bot.troops end
	return other.troops &gt;= bot.troops * 0.6 or ctx.random() &lt; 0.3
end

local function pickNeutralAnchor(n)
	-- prefer free land inside the bot's own country; sample instead of scanning everything
	local list = countryCells[n.country]
	if list and #list &gt; 0 then
		for _ = 1, 12 do
			local i = list[math.floor(ctx.random() * #list) + 1]
			if Territory.ownerOf(i) == 0 and ctx.Expansion.sameLandmass(n.id, i) then
				return i
			end
		end
	end
	local frontier, count = Territory.frontier(n.id, 0, {})
	if count == 0 then return nil end
	return frontier[math.floor(ctx.random() * count) + 1]
end

local function hasOrderAgainst(nid, target)
	for _, o in ipairs(ctx.Expansion.ordersOf(nid)) do
		if o.target == target then return true end
	end
	return false
end

local function underAttack(nid)
	local fronts = {}
	for _, o in ipairs(ctx.Expansion.activeOrders()) do
		if o.target == nid and o.front then fronts[#fronts + 1] = o end
	end
	return fronts
end

local function tryBuild(n, b, attacked)
	local Buildings = ctx.Buildings
	local wants = {}
	if Buildings.count(n.id, "city") &lt; 1 + math.floor(n.land / 400) then wants[#wants + 1] = "city" end
	if Buildings.count(n.id, "factory") &lt; 1 + math.floor(n.land / 600) then wants[#wants + 1] = "factory" end
	if attacked then
		if Buildings.count(n.id, "bunker") &lt; 1 + math.floor(n.land / 300) then wants[#wants + 1] = "bunker" end
		if Buildings.count(n.id, "tower") &lt; 1 + math.floor(n.land / 800) then wants[#wants + 1] = "tower" end
	end
	if Buildings.count(n.id, "port") &lt; 1 and b.landlocked then wants[#wants + 1] = "port" end
	if n.land &gt; 800 and Buildings.count(n.id, "artillery") &lt; 1 then wants[#wants + 1] = "artillery" end
	if n.land &gt; 1200 and Buildings.count(n.id, "airdefense") &lt; 1 then wants[#wants + 1] = "airdefense" end
	if n.kind == "bot" and n.land &gt; 1500 and Buildings.count(n.id, "tankfactory") &lt; 2 then wants[#wants + 1] = "tankfactory" end
	if ctx.mode == "extreme" then
		if Buildings.count(n.id, "oilwell") &lt; 1 + math.floor(n.land / 500) then wants[#wants + 1] = "oilwell" end
		if attacked then
			if Buildings.count(n.id, "wall") &lt; 2 + math.floor(n.land / 200) then table.insert(wants, 1, "wall") end
			if Buildings.count(n.id, "trench") &lt; 1 + math.floor(n.land / 400) then wants[#wants + 1] = "trench" end
		end
		if Buildings.count(n.id, "port") &gt; 0 and Buildings.count(n.id, "antinaval") &lt; 1 then wants[#wants + 1] = "antinaval" end
		if n.land &gt; 600 and Buildings.count(n.id, "flak") &lt; 1 then wants[#wants + 1] = "flak" end
	end
	for _, kind in ipairs(wants) do
		local cost = Buildings.cost(n.id, kind)
		if n.gold &gt;= cost then
			-- pick a spot: front-line kinds near the enemy, ports on the coast, others inland
			local owned = Territory.owned(n.id)
			local tries = 0
			for i in pairs(owned) do
				tries = tries + 1
				if tries &gt; 60 then break end
				local good
				if kind == "port" or kind == "antinaval" then good = Map.coast[i]
				elseif kind == "bunker" or kind == "tower" or kind == "wall" or kind == "trench" then good = Territory.borderCells(n.id)[i] and attacked ~= nil
				else good = not Territory.borderCells(n.id)[i] end
				if good and Buildings.canBuild(n.id, i, kind) then
					Buildings.build(n.id, i, kind)
					return true
				end
			end
		end
	end
	-- rich bots improve what they have, and coastal ones keep a defence boat
	if n.kind == "bot" then
		if Buildings.count(n.id, "port") &gt; 0 and n.gold &gt; Config.Naval.BoatGold * 3 and #ctx.Naval.boats() &lt; 400 then
			local mine = 0
			for _, boat in ipairs(ctx.Naval.boats()) do if boat.nation == n.id then mine = mine + 1 end end
			if mine &lt; 1 + math.floor(n.land / 1500) then
				local port = Buildings.ofKind(n.id, "port")[1]
				if ctx.Naval.buyBoat(n.id, port.cell) then return true end
			end
		end
		for _, kind in ipairs({ "city", "factory", "bunker", "airdefense", "port" }) do
			for _, building in ipairs(Buildings.ofKind(n.id, kind)) do
				local cost = Buildings.upgradeCost(building)
				if cost and n.gold &gt; cost * 2.5 then
					Buildings.upgrade(n.id, building.cell)
					return true
				end
			end
		end
	end
	return false
end

local function tryNaval(n, b)
	if ctx.now() - b.lastNaval &lt; 25 then return false end
	if ctx.Buildings.count(n.id, "port") &lt;= 0 then return false end
	if n.gold &lt; Config.Naval.TransportGold or n.troops &lt; 800 then return false end
	b.lastNaval = ctx.now()
	local ports = ctx.Buildings.ofKind(n.id, "port")
	local best, bestD = nil, math.huge
	for _ = 1, 40 do
		local i = coastCells[math.floor(ctx.random() * #coastCells) + 1]
		local o = Territory.ownerOf(i)
		if o ~= n.id and (o == 0 or (ctx.Diplomacy.canAttack(n.id, o) and ctx.Nations.get(o).troops &lt; n.troops * 0.5)) then
			local d = Map:distance(i, ports[1].cell)
			-- nearby shores only: a short search, and a realistic invasion
			if d &lt; bestD and d &lt; 120 then best, bestD = i, d end
		end
	end
	if best then
		local ok = ctx.Naval.launch(n.id, best, n.kind == "tribe" and 0.3 or 0.4, Config.Bots.NavalSearchLimit)
		return ok
	end
	return false
end

local function think(b)
	local n = ctx.Nations.get(b.nid)
	if not n or not n.alive then bots[b.nid] = nil return end
	local B = Config.Bots
	local percent = b.kind == "tribe" and B.TribeSendPercent or B.SendPercent
	local fullness = n.troops / math.max(1, n.maxTroops)
	local attacked = underAttack(n.id)
	local attackedBy = #attacked &gt; 0 and attacked[1].nation or nil

	-- building happens alongside any other state
	if ctx.now() &gt;= (b.nextBuild or 0) then
		b.nextBuild = ctx.now() + B.BuildInterval
		if n.gold &gt; 0 and tryBuild(n, b, attackedBy) then b.state = S.Building end
	end

	if attackedBy and n.troops &lt; (ctx.Nations.get(attackedBy) or n).troops then
		b.state = S.Defending
		-- counter-attack the invader if we can afford it
		if fullness &gt; 0.4 and not hasOrderAgainst(n.id, attackedBy) and ctx.Diplomacy.canAttack(n.id, attackedBy) then
			local front = attacked[1].front
			ctx.Expansion.issue(n.id, front, percent)
		end
		return
	end
	if fullness &lt; B.RecoverBelow then
		b.state = S.Recovering
		return
	end

	local neutralTouch = Territory.touches(n.id, 0)
	if neutralTouch and not hasOrderAgainst(n.id, 0) then
		local anchor = pickNeutralAnchor(n)
		local issued = anchor and ctx.Expansion.issue(n.id, anchor, percent)
		if not issued then
			-- the preferred spot is behind someone else: take any free land on our border
			local frontier, count = Territory.frontier(n.id, 0, {})
			if count &gt; 0 then
				issued = ctx.Expansion.issue(n.id, frontier[math.floor(ctx.random() * count) + 1], percent)
			end
		end
		if issued then
			b.state = S.Expanding
			return
		end
	end
	b.landlocked = not neutralTouch

	if not neutralTouch or fullness &gt; 0.8 then
		-- pick the weakest neighbour by troop density
		local best, bestScore = nil, math.huge
		for other in pairs(Territory.neighborsOf(n.id)) do
			local o = ctx.Nations.get(other)
			if o and o.alive and ctx.Diplomacy.canAttack(n.id, other) then
				local density = o.troops / math.max(1, o.land)
				if density &lt; bestScore then best, bestScore = other, density end
			end
		end
		if best and b.kind ~= "tribe" then
			local o = ctx.Nations.get(best)
			local sending = n.troops * percent
			if (n.troops &gt;= o.troops * B.AttackWhenStronger or sending / math.max(1, bestScore) &gt; 25)
				and not hasOrderAgainst(n.id, best) then
				local cell = Territory.frontier(n.id, best, {})[1]
				if cell then
					ctx.Expansion.issue(n.id, cell, percent)
					b.state = S.Attacking
					b.lastAttack = ctx.now()
					b.lastTarget = best
					return
				end
			end
		end
		if not neutralTouch and tryNaval(n, b) then
			b.state = S.Naval
			return
		end
	end
	if not neutralTouch then b.state = S.Consolidating end
end

function BotService.tick()
	if not ctx.Match.isPlaying() then return end
	local now = ctx.now()
	for _, b in pairs(bots) do
		if now &gt;= b.nextThink then
			b.nextThink = now + thinkInterval(b.kind)
			think(b)
		end
	end
end

function BotService.debugView()
	local out = {}
	for nid, b in pairs(bots) do out[#out + 1] = { nid, b.state } end
	return out
end

return BotService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">BuildingService</string><ProtectedString name="Source">-- Mundial War · structures: placement, levels, ownership on capture, area effects, EMP shutdown.
local BuildingService = {}

local ctx, Config, Map, Stats
local buildings = {}       -- cell -&gt; { kind, owner, cell, level, readyAt, active, disabledUntil }
local totals = {}          -- nid -&gt; { growth, capacity, gold, count = { kind = n } }
local chunks = {}          -- chunk key -&gt; { cell = true }
local disabled = {}        -- cell -&gt; true while an EMP keeps it off
local CHUNK = 16
local changes = {}         -- cell -&gt; building or false (for replication)
local EMPTY = { growth = 0, capacity = 0, gold = 0, oil = 0, attack = 0, count = {} }

function BuildingService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
	Stats = ctx.Stats
end

function BuildingService.reset()
	buildings, totals, chunks, changes, disabled = {}, {}, {}, {}, {}
end

local function chunkKey(cell)
	local x, y = Map:xy(cell)
	return math.floor(x / CHUNK) * 1000 + math.floor(y / CHUNK)
end

local function bucket(nid)
	local t = totals[nid]
	if not t then
		t = { growth = 0, capacity = 0, gold = 0, oil = 0, attack = 0, count = {} }
		totals[nid] = t
	end
	return t
end

-- Economic effect of one building (only while it is active).
local function economy(b, sign)
	if b.owner &lt;= 0 or not b.active then return end
	local t = bucket(b.owner)
	local level = b.level
	t.growth = t.growth + sign * (Stats.stat(Config, b.kind, level, "growth") or 0)
	t.capacity = t.capacity + sign * (Stats.stat(Config, b.kind, level, "capacity") or 0)
	t.gold = t.gold + sign * (Stats.stat(Config, b.kind, level, "gold") or 0)
	t.attack = t.attack + sign * (Stats.stat(Config, b.kind, level, "attackBonus") or 0)
	t.oil = t.oil + sign * (Stats.stat(Config, b.kind, level, "oil") or 0)
end

local function count(b, sign)
	if b.owner &lt;= 0 then return end
	local t = bucket(b.owner)
	t.count[b.kind] = (t.count[b.kind] or 0) + sign
end

local function changed(b)
	changes[b.cell] = b
end

function BuildingService.totals(nid)
	return totals[nid] or EMPTY
end

function BuildingService.count(nid, kind)
	local t = totals[nid]
	return t and t.count[kind] or 0
end

function BuildingService.at(cell)
	return buildings[cell]
end

function BuildingService.all()
	return buildings
end

function BuildingService.stat(b, field)
	return Stats.stat(Config, b.kind, b.level, field)
end

function BuildingService.cost(nid, kind)
	local def = Config.Buildings[kind]
	if not def then return nil end
	return math.floor(def.cost * (1 + Config.CostGrowth * BuildingService.count(nid, kind)))
end

-- Calls fn(building) for every structure within `radius` of `cell` (chunked lookup).
function BuildingService.near(cell, radius, fn)
	local x, y = Map:xy(cell)
	local r2 = radius * radius
	for cx = math.floor((x - radius) / CHUNK), math.floor((x + radius) / CHUNK) do
		for cy = math.floor((y - radius) / CHUNK), math.floor((y + radius) / CHUNK) do
			local set = chunks[cx * 1000 + cy]
			if set then
				for c in pairs(set) do
					local bx, by = Map:xy(c)
					if (bx - x) * (bx - x) + (by - y) * (by - y) &lt;= r2 then
						if fn(buildings[c]) then return end
					end
				end
			end
		end
	end
end

-- Strongest value of `field` among active `kind` buildings of `ownerNid` whose own reach
-- (radius at their level) covers `cell`; nil when none does. `lowest` picks the smallest
-- value instead (for multipliers where lower is stronger).
function BuildingService.covered(cell, kind, ownerNid, field, lowest)
	if BuildingService.count(ownerNid, kind) &lt;= 0 then return nil end
	local best = nil
	local cx, cy = Map:xy(cell)
	BuildingService.near(cell, Stats.maxStat(Config, kind, "radius"), function(b)
		if b.kind == kind and b.owner == ownerNid and b.active then
			local r = BuildingService.stat(b, "radius")
			local bx, by = Map:xy(b.cell)
			if (bx - cx) * (bx - cx) + (by - cy) * (by - cy) &lt;= r * r then
				local v = field and BuildingService.stat(b, field) or 1
				if best == nil or (lowest and v &lt; best) or (not lowest and v &gt; best) then best = v end
			end
		end
	end)
	return best
end

function BuildingService.canBuild(nid, cell, kind)
	local n = ctx.Nations.get(nid)
	local def = Config.Buildings[kind]
	if not ctx.Match.isPlaying() then return false, "Aguarde o início da partida." end
	if not n or not n.alive then return false, "Você não tem nação." end
	if not def then return false, "Construção inválida." end
	if def.mode and def.mode ~= ctx.mode then return false, def.name .. " só existe na Conquista Extrema." end
	if not Map:valid(cell) or ctx.Territory.ownerOf(cell) ~= nid then
		return false, "Construa em uma célula do seu território."
	end
	if buildings[cell] then return false, "Já existe uma construção aqui." end
	if def.coastal and not Map.coast[cell] then return false, "Porto só pode ficar no litoral." end
	if def.requires and BuildingService.count(nid, def.requires) &lt;= 0 then
		return false, "Requer " .. Config.Buildings[def.requires].name .. "."
	end
	local crowded = false
	BuildingService.near(cell, Config.MinBuildingSpacing, function()
		crowded = true
		return true
	end)
	if crowded then return false, "Muito perto de outra construção." end
	local cost = BuildingService.cost(nid, kind)
	if n.gold &lt; cost then return false, "Ouro insuficiente (" .. cost .. ")." end
	return true, cost
end

local function place(cell, kind, nid, level)
	local b = { kind = kind, owner = nid, cell = cell, level = level or 1, readyAt = 0, active = true }
	buildings[cell] = b
	local key = chunkKey(cell)
	chunks[key] = chunks[key] or {}
	chunks[key][cell] = true
	count(b, 1)
	economy(b, 1)
	changed(b)
	return b
end

function BuildingService.build(nid, cell, kind)
	local ok, costOrWhy = BuildingService.canBuild(nid, cell, kind)
	if not ok then return false, costOrWhy end
	local n = ctx.Nations.get(nid)
	n.gold = n.gold - costOrWhy
	place(cell, kind, nid, 1)
	return true, "Construção pronta: " .. Config.Buildings[kind].name .. "."
end

function BuildingService.upgradeCost(b)
	return Stats.upgradeCost(Config, b.kind, b.level)
end

function BuildingService.upgrade(nid, cell)
	local n = ctx.Nations.get(nid)
	local b = buildings[cell]
	if not ctx.Match.isPlaying() then return false, "Aguarde o início da partida." end
	if not n or not n.alive then return false, "Você não tem nação." end
	if not b or b.owner ~= nid then return false, "Selecione uma construção sua." end
	local cost = BuildingService.upgradeCost(b)
	if not cost then return false, "Já está no nível máximo." end
	if n.gold &lt; cost then return false, "Ouro insuficiente (" .. cost .. ")." end
	n.gold = n.gold - cost
	economy(b, -1)
	b.level = b.level + 1
	economy(b, 1)
	changed(b)
	return true, Config.Buildings[b.kind].name .. " agora é nível " .. b.level .. "."
end

function BuildingService.destroy(cell)
	local b = buildings[cell]
	if not b then return end
	economy(b, -1)
	count(b, -1)
	buildings[cell] = nil
	disabled[cell] = nil
	local set = chunks[chunkKey(cell)]
	if set then set[cell] = nil end
	changes[cell] = false
	if b.kind == "port" then ctx.Naval.onPortLost(cell) end
end

-- EMP: the building stops working until `untilTime`.
function BuildingService.disable(cell, untilTime)
	local b = buildings[cell]
	if not b then return end
	if b.active then
		economy(b, -1)
		b.active = false
	end
	b.disabledUntil = math.max(b.disabledUntil or 0, untilTime)
	disabled[cell] = true
	changed(b)
end

function BuildingService.tick()
	local now = ctx.now()
	for cell in pairs(disabled) do
		local b = buildings[cell]
		if not b then
			disabled[cell] = nil
		elseif now &gt;= (b.disabledUntil or 0) then
			b.active = true
			b.disabledUntil = nil
			economy(b, 1)
			disabled[cell] = nil
			changed(b)
		end
	end
end

-- Territory calls this for every ownership change: captured structures change hands
-- (keeping their level), structures on land that becomes neutral are destroyed.
function BuildingService.onOwnerChanged(cell, old, new)
	local b = buildings[cell]
	if not b then return end
	if new &lt;= 0 then
		BuildingService.destroy(cell)
		return
	end
	economy(b, -1)
	count(b, -1)
	b.owner = new
	count(b, 1)
	economy(b, 1)
	changed(b)
	if b.kind == "port" then ctx.Naval.onPortLost(cell) end
end

local function row(cell, b)
	if not b then return { cell, false, 0, 0, false } end
	return { cell, b.kind, b.owner, b.level, not b.active }
end

-- Replication rows: { cell, kind | false, owner, level, disabled }
function BuildingService.drainChanges()
	if next(changes) == nil then return nil end
	local out = {}
	for cell, b in pairs(changes) do
		out[#out + 1] = row(cell, b ~= false and buildings[cell] or nil)
	end
	changes = {}
	return out
end

function BuildingService.snapshot()
	local out = {}
	for cell, b in pairs(buildings) do out[#out + 1] = row(cell, b) end
	return out
end

function BuildingService.ofKind(nid, kind)
	local list = {}
	if BuildingService.count(nid, kind) &lt;= 0 then return list end
	for _, b in pairs(buildings) do
		if b.owner == nid and b.kind == kind then list[#list + 1] = b end
	end
	return list
end

return BuildingService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">CombatService</string><ProtectedString name="Source">-- Mundial War · cost of taking a cell and defensive area effects on fronts.
local CombatService = {}

local ctx, Config, Map
local pulseClock, artilleryClock = 0, 0

function CombatService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
end

function CombatService.reset()
	pulseClock, artilleryClock = 0, 0
end

-- Troops the attacker spends to take `cell`, and troops the defender loses.
function CombatService.cellCost(attackerId, cell, orderTroops, front)
	local E, C, B = Config.Expansion, Config.Combat, Config.Buildings
	local attacker = ctx.Nations.get(attackerId)
	local target = ctx.Territory.ownerOf(cell)
	local cost, defenderLoss = 0, 0
	if target == 0 then
		cost = E.NeutralBaseCost + Map:distance(cell, attacker.capital) * E.DistanceCostPerCell
		if Map:isPolar(cell) then cost = cost + E.PolarExtraCost end
	else
		local defender = ctx.Nations.get(target)
		local density = defender.troops / math.max(1, defender.land)
		cost = math.max(C.EnemyMinCost, density * C.DefenseDensityFactor)
		defenderLoss = density * C.DefenderLossFactor
		local Buildings = ctx.Buildings
		local bunker = Buildings.covered(cell, "bunker", target, "defense")
		if bunker then cost = cost * bunker end
		local wall = Buildings.covered(cell, "wall", target, "defense")
		if wall then cost = cost * wall end
		local shelter = Buildings.covered(cell, "trench", target, "shelter", true)
		if shelter then defenderLoss = defenderLoss * shelter end
		local mg = Buildings.covered(cell, "machinegun", target, "maxFactor")
		if mg then
			cost = cost * (1 + math.min(mg - 1, (orderTroops or 0) / B.machinegun.massDefense))
		end
		if Map:distance(cell, defender.capital) &lt;= C.CapitalRadius then cost = cost * C.CapitalDefense end
		local support = Buildings.covered(cell, "artillery", attackerId, "support", true)
		if support then cost = cost * support end
		local attack = Buildings.totals(attackerId).attack
		if attack &gt; 0 then
			cost = cost * math.max(B.tankfactory.attackFloor, 1 - attack)
		end
	end
	if front and not ctx.Territory.isMainland(attackerId, front) then
		cost = cost * C.ExclaveAttackFactor
	end
	return cost, defenderLoss
end

-- Sniper towers wear fronts down every second; artillery shells them periodically.
function CombatService.tick(dt)
	pulseClock = pulseClock + dt
	artilleryClock = artilleryClock + dt
	local doTower = pulseClock &gt;= 1
	local doArtillery = artilleryClock &gt;= Config.Buildings.artillery.interval
	if not doTower and not doArtillery then return end
	local B = Config.Buildings
	for _, order in ipairs(ctx.Expansion.activeOrders()) do
		if order.target &gt; 0 and order.front then
			local attrition = doTower and ctx.Buildings.covered(order.front, "tower", order.target, "attrition")
			if attrition then
				order.troops = order.troops * (1 - attrition * pulseClock)
			end
			local trench = doTower and ctx.Buildings.covered(order.front, "trench", order.target, "attrition")
			if trench then
				order.troops = order.troops * (1 - trench * pulseClock)
			end
			if doArtillery then
				-- the defender's artillery, or an ally of the defender, shells the front
				local shooters = ctx.Diplomacy.allies(order.target)
				shooters[#shooters + 1] = order.target
				for _, nid in ipairs(shooters) do
					local damage = nid ~= order.nation and ctx.Buildings.covered(order.front, "artillery", nid, "damage")
					if damage then
						order.troops = order.troops * (1 - damage)
						break
					end
				end
			end
		end
	end
	if doTower then pulseClock = 0 end
	if doArtillery then artilleryClock = 0 end
end

return CombatService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">CommandService</string><ProtectedString name="Source">-- Mundial War · validates and routes every client intention. Pure Lua (no Roblox APIs) so the
-- anti-cheat rules are unit tested. The client never decides anything: it only asks.
local CommandService = {}

local ctx, Config
local buckets = {}   -- userId -&gt; { tokens, at }

function CommandService.init(context)
	ctx = context
	Config = ctx.Config
end

function CommandService.forget(userId)
	buckets[userId] = nil
end

-- Token bucket: CommandsPerSecond sustained, CommandBurst peak.
local function allow(userId, clock)
	local N = Config.Network
	local b = buckets[userId]
	if not b then
		b = { tokens = N.CommandBurst, at = clock }
		buckets[userId] = b
	end
	b.tokens = math.min(N.CommandBurst, b.tokens + (clock - b.at) * N.CommandsPerSecond)
	b.at = clock
	if b.tokens &lt; 1 then return false end
	b.tokens = b.tokens - 1
	return true
end

local function isInt(v)
	return type(v) == "number" and v == v and v % 1 == 0 and v &gt; -1e9 and v &lt; 1e9
end

local function isPercent(v)
	return type(v) == "number" and v == v and v &gt;= 0.01 and v &lt;= 1
end

-- Returns ok, message (message may be nil for silent actions).
function CommandService.handle(userId, displayName, action, a, b, clock, c)
	if type(action) ~= "string" then return false, nil end
	if not allow(userId, clock or ctx.now()) then return false, nil end
	local A = ctx.Protocol.Actions
	local Map = ctx.Map
	local nation = ctx.Nations.forUser(userId)
	local nid = nation and nation.alive and nation.id or nil

	if action == A.Vote then
		if type(a) ~= "string" then return false, "Modo inválido." end
		return ctx.Match.vote(userId, a)
	end

	if action == A.Spawn then
		if nid then return false, "Você já tem uma nação." end
		if not ctx.Match.canSpawn() then return false, "Não é possível fundar uma nação agora." end
		if not isInt(a) or not Map:valid(a) then return false, "Célula inválida." end
		if not ctx.Nations.canRespawn(userId) then return false, "Aguarde alguns segundos para renascer." end
		local name = type(displayName) == "string" and string.sub(displayName, 1, 24) or "Jogador"
		if ctx.mode == "extreme" then
			local n, why = ctx.Nations.takeover(userId, name, a)
			if not n then return false, why end
			return true, "Você agora governa " .. n.name .. "."
		end
		local n, why = ctx.Nations.create("player", name, a, { userId = userId })
		if not n then return false, why end
		return true, "Nação fundada! Capital em " .. ((Map.countries[Map.country[a]] or {}).name or "terra livre") .. "."
	end

	if not nid then return false, "Escolha um ponto no mapa para fundar sua nação." end

	if action == A.Target then
		if not isInt(a) or not Map:valid(a) then return false, "Célula inválida." end
		if not isPercent(b) then return false, "Percentual inválido." end
		local ok, msg, hint = ctx.Expansion.issue(nid, a, b)
		if ok then return true, msg end
		if hint == "naval" and Map.land[a] then
			if ctx.Buildings.count(nid, "port") &gt; 0 then
				return ctx.Naval.launch(nid, a, b)
			end
			return false, "Sem ligação por terra. Construa um porto para invadir pelo mar."
		end
		return false, msg
	elseif action == A.Cancel then
		if a ~= nil and not isInt(a) then return false, nil end
		ctx.Expansion.cancel(nid, a)
		return true, "Avanço cancelado; sobreviventes voltaram."
	elseif action == A.Build then
		if not isInt(a) or not Map:valid(a) then return false, "Célula inválida." end
		if type(b) ~= "string" or not Config.Buildings[b] then return false, "Construção inválida." end
		return ctx.Buildings.build(nid, a, b)
	elseif action == A.Warship then
		if not isInt(a) or not Map:valid(a) then return false, "Célula inválida." end
		return ctx.Naval.buyBoat(nid, a)
	elseif action == A.Patrol then
		if not isInt(a) or not isInt(b) or not Map:valid(b) then return false, "Ponto inválido." end
		return ctx.Naval.patrol(nid, a, b)
	elseif action == A.Upgrade then
		if not isInt(a) or not Map:valid(a) then return false, "Célula inválida." end
		return ctx.Buildings.upgrade(nid, a)
	elseif action == A.Weapon or action == A.Nuke or action == A.Airstrike then
		if not isInt(a) or not Map:valid(a) then return false, "Alvo inválido." end
		local kind = action == A.Nuke and "atomic" or action == A.Airstrike and "airstrike" or b
		if type(kind) ~= "string" or not Config.Weapons[kind] then return false, "Arma inválida." end
		return ctx.Strategic.launch(nid, a, kind, c)
	elseif action == A.Ally or action == A.Decline or action == A.BreakAlliance or action == A.War then
		if not isInt(a) or not ctx.Nations.get(a) or a == nid then return false, "Nação inválida." end
		if action == A.Ally then return ctx.Diplomacy.requestAlliance(nid, a) end
		if action == A.Decline then return ctx.Diplomacy.decline(nid, a) end
		if action == A.BreakAlliance then return ctx.Diplomacy.breakAlliance(nid, a) end
		return ctx.Diplomacy.declareWar(nid, a)
	end
	return false, nil
end

return CommandService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">DiplomacyService</string><ProtectedString name="Source">-- Mundial War · alliances and wars.
-- Default relation is neutral: you may attack a neutral nation (that declares war).
-- Allies cannot attack each other until the alliance is cancelled.
local DiplomacyService = {}

local ctx
local relations = {}      -- "a:b" -&gt; { kind = "ally" | "war", since }
local matrix = {}         -- a -&gt; b -&gt; kind (fast lookups for the simulation's hot loops)
local requests = {}       -- to -&gt; { from -&gt; expires }
local brokeAt = {}        -- "a:b" -&gt; time alliance was cancelled

local function key(a, b)
	if a &gt; b then a, b = b, a end
	return a .. ":" .. b
end

function DiplomacyService.init(context)
	ctx = context
end

function DiplomacyService.reset()
	relations, requests, brokeAt, matrix = {}, {}, {}, {}
end

local function setRelation(a, b, value)
	relations[key(a, b)] = value
	local kind = value and value.kind or nil
	matrix[a] = matrix[a] or {}
	matrix[b] = matrix[b] or {}
	matrix[a][b] = kind
	matrix[b][a] = kind
end

function DiplomacyService.relation(a, b)
	if a == b then return "self" end
	local row = matrix[a]
	return row and row[b] or "neutral"
end

function DiplomacyService.allied(a, b)
	return a ~= b and DiplomacyService.relation(a, b) == "ally"
end

function DiplomacyService.canAttack(a, b)
	if b == 0 then return true end
	if a == b then return false end
	return DiplomacyService.relation(a, b) ~= "ally"
end

local function notifyPair(a, b)
	local payload = { k = ctx.Protocol.Events.Diplomacy, a = a, b = b, rel = DiplomacyService.relation(a, b) }
	ctx.emit(nil, payload)
end

function DiplomacyService.declareWar(a, b)
	local na, nb = ctx.Nations.get(a), ctx.Nations.get(b)
	if not na or not nb or not na.alive or not nb.alive or a == b then
		return false, "Nação inválida."
	end
	local r = relations[key(a, b)]
	if r and r.kind == "war" then return true, "Vocês já estão em guerra." end
	if r and r.kind == "ally" then brokeAt[key(a, b)] = ctx.now() end
	setRelation(a, b, { kind = "war", since = ctx.now() })
	if requests[a] then requests[a][b] = nil end
	if requests[b] then requests[b][a] = nil end
	notifyPair(a, b)
	ctx.notify(b, na.name .. " declarou guerra a você!", "war")
	return true, "Guerra declarada contra " .. nb.name .. "."
end

-- Called by expansion when an attack starts; silently turns neutral into war.
function DiplomacyService.ensureWar(a, b)
	if b &gt; 0 and DiplomacyService.relation(a, b) == "neutral" then
		DiplomacyService.declareWar(a, b)
	end
end

local function makeAlliance(a, b)
	setRelation(a, b, { kind = "ally", since = ctx.now() })
	if requests[a] then requests[a][b] = nil end
	if requests[b] then requests[b][a] = nil end
	-- allies stop fighting each other immediately; troops in the field go home
	ctx.Expansion.cancelAgainst(a, b)
	ctx.Expansion.cancelAgainst(b, a)
	notifyPair(a, b)
end

-- Request an alliance, or accept one if the other side already asked.
function DiplomacyService.requestAlliance(a, b)
	local na, nb = ctx.Nations.get(a), ctx.Nations.get(b)
	if not na or not nb or not na.alive or not nb.alive or a == b then
		return false, "Nação inválida."
	end
	if DiplomacyService.allied(a, b) then return false, "Vocês já são aliados." end
	local broke = brokeAt[key(a, b)]
	if broke and ctx.now() - broke &lt; ctx.Config.Diplomacy.BreakCooldown then
		return false, "Aliança rompida há pouco. Aguarde."
	end
	local now = ctx.now()
	local incoming = requests[a] and requests[a][b]
	if incoming and incoming &gt; now then
		makeAlliance(a, b)
		ctx.notify(b, na.name .. " aceitou a aliança.", "ally")
		return true, "Aliança formada com " .. nb.name .. "."
	end
	if nb.kind ~= "player" then
		if ctx.Bots.considerAlliance(b, a) then
			makeAlliance(a, b)
			return true, nb.name .. " aceitou a aliança."
		end
		return false, nb.name .. " recusou a aliança."
	end
	requests[b] = requests[b] or {}
	requests[b][a] = now + ctx.Config.Diplomacy.RequestSeconds
	ctx.emit(b, { k = ctx.Protocol.Events.Diplomacy, request = a, expires = ctx.Config.Diplomacy.RequestSeconds })
	return true, "Pedido de aliança enviado a " .. nb.name .. "."
end

function DiplomacyService.decline(a, b)
	if requests[a] and requests[a][b] then
		requests[a][b] = nil
		ctx.notify(b, (ctx.Nations.get(a) or { name = "?" }).name .. " recusou a aliança.", "info")
		return true, "Pedido recusado."
	end
	return false, "Não há pedido dessa nação."
end

function DiplomacyService.breakAlliance(a, b)
	if not DiplomacyService.allied(a, b) then return false, "Vocês não são aliados." end
	setRelation(a, b, nil)
	brokeAt[key(a, b)] = ctx.now()
	notifyPair(a, b)
	ctx.notify(b, (ctx.Nations.get(a) or { name = "?" }).name .. " cancelou a aliança.", "war")
	return true, "Aliança cancelada."
end

function DiplomacyService.removeNation(id)
	for k in pairs(relations) do
		local a, b = string.match(k, "^(%d+):(%d+)$")
		a, b = tonumber(a), tonumber(b)
		if a == id or b == id then setRelation(a, b, nil) end
	end
	requests[id] = nil
	for _, list in pairs(requests) do list[id] = nil end
end

function DiplomacyService.pendingFor(id)
	local out = {}
	local now = ctx.now()
	for from, expires in pairs(requests[id] or {}) do
		if expires &gt; now then out[#out + 1] = { from = from, left = expires - now } end
	end
	return out
end

function DiplomacyService.snapshot()
	local out = {}
	for k, r in pairs(relations) do
		local a, b = string.match(k, "^(%d+):(%d+)$")
		out[#out + 1] = { tonumber(a), tonumber(b), r.kind }
	end
	return out
end

function DiplomacyService.allies(id)
	local out = {}
	for k, r in pairs(relations) do
		if r.kind == "ally" then
			local a, b = string.match(k, "^(%d+):(%d+)$")
			a, b = tonumber(a), tonumber(b)
			if a == id then out[#out + 1] = b elseif b == id then out[#out + 1] = a end
		end
	end
	return out
end

function DiplomacyService.tick()
	local now = ctx.now()
	for to, list in pairs(requests) do
		for from, expires in pairs(list) do
			if expires &lt;= now then list[from] = nil end
		end
	end
end

return DiplomacyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source">-- Mundial War · troop generation, capacity and gold.
local EconomyService = {}

local ctx

function EconomyService.init(context)
	ctx = context
end

function EconomyService.maxTroops(n)
	local T = ctx.Config.Troops
	local b = ctx.Buildings.totals(n.id)
	return T.BaseCapacity + n.land * T.CapacityPerCell + b.capacity
end

function EconomyService.troopRate(n, maxTroops)
	local T = ctx.Config.Troops
	local b = ctx.Buildings.totals(n.id)
	local raw = T.BaseGrowth + n.land * T.GrowthPerCell + b.growth
	local room = 1 - n.troops / maxTroops
	if room &lt;= 0 then return 0 end
	return raw * room ^ T.SaturationPower
end

function EconomyService.goldRate(n)
	local G = ctx.Config.Gold
	local b = ctx.Buildings.totals(n.id)
	return G.Base + n.land * G.PerCell + b.gold
end

function EconomyService.tick(dt)
	if not ctx.Match.isPlaying() then return end
	for _, n in pairs(ctx.Nations.all()) do
		if n.alive then
			local maxTroops = EconomyService.maxTroops(n)
			local rate = EconomyService.troopRate(n, maxTroops)
			n.maxTroops = maxTroops
			n.troopRate = rate
			n.goldRate = EconomyService.goldRate(n)
			if n.troops &lt; maxTroops then
				n.troops = math.min(maxTroops, n.troops + rate * dt)
			end
			n.gold = n.gold + n.goldRate * dt
			if ctx.mode == "extreme" then
				local O = ctx.Config.Oil
				n.oilRate = O.Base + n.land * O.PerCell + ctx.Buildings.totals(n.id).oil
				n.oil = (n.oil or 0) + n.oilRate * dt
			end
		end
	end
end

function EconomyService.spendGold(n, amount)
	if n.gold + 1e-6 &lt; amount then return false end
	n.gold = n.gold - amount
	return true
end

return EconomyService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">ExpansionService</string><ProtectedString name="Source">-- Mundial War · expansion orders: the "click → front advances → territory grows" loop.
--
-- An order holds troops taken from the reserve once. Every simulation tick it captures a
-- few cells of its target owner (0 = neutral) that touch the nation, chosen to form an
-- organic front: a fan that grows from the border point nearest the click, inside a cone
-- aimed at the click (wider with more troops), preferring cells already hugged by our
-- territory so no holes are left behind.
local ExpansionService = {}

local ctx, Config, Map, Territory
local orders = {}          -- list of active orders
local nextOrderId = 1
local candidates, scores = {}, {}

function ExpansionService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
	Territory = ctx.Territory
end

function ExpansionService.reset()
	orders = {}
	nextOrderId = 1
end

function ExpansionService.activeOrders()
	return orders
end

function ExpansionService.ordersOf(nid)
	local out = {}
	for _, o in ipairs(orders) do
		if o.nation == nid then out[#out + 1] = o end
	end
	return out
end

local function findOrder(nid, target)
	for _, o in ipairs(orders) do
		if o.nation == nid and o.target == target then return o end
	end
	return nil
end

local function finish(o, refund)
	o.done = true
	local n = ctx.Nations.get(o.nation)
	if refund and n and n.alive and o.troops &gt; 0 then
		n.troops = n.troops + math.floor(o.troops)
	end
	o.troops = 0
end

local function sweep()
	local k = 1
	for i = 1, #orders do
		local o = orders[i]
		if not o.done then
			orders[k] = o
			k = k + 1
		end
	end
	for i = k, #orders do orders[i] = nil end
end

-- Nearest border cell of the nation to `cell` (where the arrow starts on the client).
local function nearestOwnBorder(nid, cell)
	local best, bestD = nil, math.huge
	for i in pairs(Territory.borderCells(nid) or {}) do
		local d = Map:distance(i, cell)
		if d &lt; bestD then best, bestD = i, d end
	end
	return best
end

-- True when the nation owns land on the same landmass as `cell` (land path exists).
function ExpansionService.sameLandmass(nid, cell)
	local mass = ctx.Landmass[cell]
	if not mass then return false end
	for i in pairs(Territory.borderCells(nid) or {}) do
		if ctx.Landmass[i] == mass then return true end
	end
	local n = ctx.Nations.get(nid)
	return n ~= nil and ctx.Landmass[n.capital] == mass and Territory.ownerOf(n.capital) == nid
end

-- Validates a land order without changing anything. Returns ok, reasonOrTarget.
function ExpansionService.validate(nid, cell, percent)
	local n = ctx.Nations.get(nid)
	if not ctx.Match.isPlaying() then return false, "A expansão começa após a fase de escolha." end
	if not n or not n.alive then return false, "Você ainda não tem nação." end
	if not Map:valid(cell) then return false, "Célula inválida." end
	if type(percent) ~= "number" or percent ~= percent or percent &lt; 0.01 or percent &gt; 1 then
		return false, "Percentual inválido."
	end
	local target = Territory.ownerOf(cell)
	if target == -1 then return false, "A água não pode ser conquistada. Use um porto." end
	if target == nid then return false, "Esse território já é seu." end
	if target &gt; 0 and not ctx.Diplomacy.canAttack(nid, target) then
		return false, "Aliados não podem se atacar. Cancele a aliança antes."
	end
	if not ExpansionService.sameLandmass(nid, cell) then
		return false, "Sem ligação por terra. Use um porto para atravessar o mar.", "naval"
	end
	if not Territory.touches(nid, target) then
		if target == 0 then return false, "Não há terra livre na sua fronteira.", "blocked" end
		return false, "Sem fronteira com essa nação. Use um porto.", "naval"
	end
	if not Territory.reachable(nid, cell, Config.Expansion.ReachSearchLimit) then
		if target == 0 then
			return false, "Caminho bloqueado por outra nação. Ataque-a ou escolha terra livre ligada à sua fronteira.", "blocked"
		end
		return false, "Essa parte de " .. ctx.Nations.get(target).name .. " não encosta em você. Use um porto.", "naval"
	end
	return true, target
end

-- Starts or reinforces an order with troops that already left the reserve.
function ExpansionService.start(nid, target, cell, troops)
	local existing = findOrder(nid, target)
	if existing then
		existing.troops = existing.troops + troops
		existing.anchor = cell
		existing.origin = nearestOwnBorder(nid, cell) or existing.origin
		existing.originCell = existing.origin or existing.originCell
		return existing
	end
	local o = {
		id = nextOrderId, nation = nid, target = target, troops = troops, sent = troops,
		anchor = cell, origin = nearestOwnBorder(nid, cell), front = nil, carry = 0,
		started = ctx.now(),
	}
	nextOrderId = nextOrderId + 1
	o.originCell = o.origin or cell
	o.front = o.origin
	orders[#orders + 1] = o
	if target &gt; 0 then ctx.Diplomacy.ensureWar(nid, target) end
	return o
end

function ExpansionService.issue(nid, cell, percent)
	local ok, targetOrWhy, hint = ExpansionService.validate(nid, cell, percent)
	if not ok then return false, targetOrWhy, hint end
	local target = targetOrWhy
	local n = ctx.Nations.get(nid)
	local existing = findOrder(nid, target)
	if not existing then
		local count = 0
		for _, o in ipairs(orders) do
			if o.nation == nid then count = count + 1 end
		end
		if count &gt;= Config.Expansion.MaxOrdersPerNation then
			return false, "Limite de " .. Config.Expansion.MaxOrdersPerNation .. " frentes ativas. Cancele uma."
		end
	end
	local troops = math.floor(n.troops * percent)
	if troops &lt; Config.Expansion.MinTroopsToSend then
		return false, "Tropas insuficientes para enviar."
	end
	n.troops = n.troops - troops
	local o = ExpansionService.start(nid, target, cell, troops)
	local targetName = target == 0 and "terra livre" or ctx.Nations.get(target).name
	return true, (existing and "Reforço enviado: " or "Avanço iniciado: ") .. troops .. " tropas → " .. targetName, o
end

function ExpansionService.cancel(nid, orderId)
	for _, o in ipairs(orders) do
		if o.nation == nid and (orderId == nil or o.id == orderId) then
			finish(o, true)
		end
	end
	sweep()
end

function ExpansionService.cancelAll(nid, refund)
	for _, o in ipairs(orders) do
		if o.nation == nid then finish(o, refund) end
	end
	sweep()
end

function ExpansionService.cancelAgainst(nid, target)
	for _, o in ipairs(orders) do
		if o.nation == nid and o.target == target then finish(o, true) end
	end
	sweep()
end

local function advance(o, dt)
	local E = Config.Expansion
	local n = ctx.Nations.get(o.nation)
	if not n or not n.alive then finish(o, false) return end
	if o.target &gt; 0 then
		local t = ctx.Nations.get(o.target)
		if not t or not t.alive or not ctx.Diplomacy.canAttack(o.nation, o.target) then
			finish(o, true)
			return
		end
	end
	if o.troops &lt; E.MinTroopsToSend * 0.5 then finish(o, true) return end

	-- look only near the fan first; fall back to the whole border when that area is used up
	local sqTroops = math.sqrt(math.max(0, o.troops))
	local reach = Map:distance(o.originCell, o.anchor) + E.FrontSearchMargin + sqTroops / 4
	local _, count = Territory.frontierNear(o.nation, o.target, o.originCell, reach, candidates)
	if count == 0 then
		_, count = Territory.frontier(o.nation, o.target, candidates)
	end
	if count == 0 then finish(o, true) return end

	-- Fan-shaped front: grow outward from where the order left our border (origin), inside a
	-- cone aimed at the clicked point. Distance from the origin keeps the front even (no spear),
	-- the cone keeps it pointed at the target, own-neighbour bonus closes notches (no holes).
	local sq = math.sqrt(math.max(0, o.troops))
	local cone = math.rad(math.min(E.FrontConeMax, E.FrontConeBase + sq / E.FrontConeTroopDivisor))
	local W = Map.W
	local ox, oy = (o.originCell - 1) % W, ((o.originCell - 1) - (o.originCell - 1) % W) / W
	local tx, ty = (o.anchor - 1) % W - ox, ((o.anchor - 1) - (o.anchor - 1) % W) / W - oy
	local L = math.sqrt(tx * tx + ty * ty)
	local m = count
	for k = 1, count do
		local c = candidates[k]
		local vx, vy = (c - 1) % W - ox, ((c - 1) - (c - 1) % W) / W - oy
		local r = math.sqrt(vx * vx + vy * vy)
		local penalty = 0
		if L &gt;= 1 and r &gt;= 2 then
			local cosang = (vx * tx + vy * ty) / (r * L)
			if cosang &lt; -1 then cosang = -1 elseif cosang &gt; 1 then cosang = 1 end
			local excess = math.acos(cosang) - cone
			if excess &gt; 0 then penalty = excess * r * E.ConePenalty end
		end
		scores[k] = r + penalty - E.OwnNeighborWeight * Territory.ownNeighborCount(c, o.nation)
			+ ctx.random() * E.Jitter
	end

	local rate = math.min(E.CellsPerTickMax, E.CellsPerTickBase + sq / E.CellsPerTickTroopDivisor)
	if o.target &gt; 0 then rate = rate * E.EnemyRateFactor end
	o.carry = o.carry + rate * dt / Config.Tick.Simulation
	local want = math.floor(o.carry)
	o.carry = o.carry - want
	if want &lt;= 0 then return end

	local taken = 0
	for t = 1, math.min(want, m) do
		-- partial selection: best remaining score
		local best = t
		for k = t + 1, m do
			if scores[k] &lt; scores[best] then best = k end
		end
		candidates[t], candidates[best] = candidates[best], candidates[t]
		scores[t], scores[best] = scores[best], scores[t]
		local cell = candidates[t]
		if Territory.ownerOf(cell) == o.target then
			local cost, loss = ctx.Combat.cellCost(o.nation, cell, o.troops, o.front)
			if cost &gt; o.troops then
				o.stalled = true
				break
			end
			o.troops = o.troops - cost
			if o.target &gt; 0 then
				local d = ctx.Nations.get(o.target)
				d.troops = math.max(0, d.troops - loss)
			end
			Territory.setOwner(cell, o.nation)
			o.front = cell
			taken = taken + 1
		end
	end
	if taken &gt; 0 then o.stalled = false end
	if o.stalled then
		-- not enough troops for the cheapest cell left: the order ends, survivors go home
		finish(o, true)
	end
end

function ExpansionService.tick(dt)
	if not ctx.Match.isPlaying() then return end
	for i = 1, #orders do
		local o = orders[i]
		if not o.done then advance(o, dt) end
	end
	sweep()
end

-- Compact public view for clients: { id, nation, target, troops, front, anchor, origin }
function ExpansionService.publicView()
	local out = {}
	for _, o in ipairs(orders) do
		out[#out + 1] = { o.id, o.nation, o.target, math.floor(o.troops), o.front or 0, o.anchor, o.origin or 0 }
	end
	return out
end

return ExpansionService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">-- Mundial War · round life cycle:
-- waiting → vote (choose the game mode) → spawn → playing → ended → vote …
local MatchService = {}

local ctx, Config
local phase, phaseEnds, round, winner = "waiting", 0, 0, nil
local votes = {}          -- userId -&gt; mode

function MatchService.init(context)
	ctx = context
	Config = ctx.Config
	ctx.mode = ctx.mode or Config.ModeOrder[1]
end

function MatchService.phase()
	return phase
end

function MatchService.round()
	return round
end

function MatchService.winner()
	return winner
end

function MatchService.mode()
	return ctx.mode
end

function MatchService.isPlaying()
	return phase == "playing"
end

function MatchService.canSpawn()
	return phase == "spawn" or (phase == "playing" and Config.Match.AllowRespawn)
end

function MatchService.timeLeft()
	return math.max(0, phaseEnds - ctx.now())
end

local function tally()
	local counts = {}
	for _, m in ipairs(Config.ModeOrder) do counts[m] = 0 end
	for _, m in pairs(votes) do counts[m] = (counts[m] or 0) + 1 end
	return counts
end

function MatchService.publicView()
	return { phase = phase, round = round, left = MatchService.timeLeft(), winner = winner, mode = ctx.mode, votes = tally() }
end

local function announce()
	local view = MatchService.publicView()
	view.k = ctx.Protocol.Events.Match
	ctx.emit(nil, view)
end

local function resetWorld()
	ctx.Territory.reset()
	ctx.Nations.reset()
	ctx.Buildings.reset()
	ctx.Expansion.reset()
	ctx.Naval.reset()
	ctx.Strategic.reset()
	ctx.Diplomacy.reset()
	ctx.Combat.reset()
	ctx.Bots.reset()
end

-- Places the AI for the chosen mode and opens the spawn phase.
local function startSpawn()
	phase = "spawn"
	phaseEnds = ctx.now() + Config.Match.SpawnPhaseSeconds
	if ctx.mode == "extreme" then
		ctx.Bots.spawnCountries()
	else
		ctx.Bots.spawnAll()
	end
	ctx.fullResync = true
	announce()
end

function MatchService.beginRound()
	resetWorld()
	round = round + 1
	winner = nil
	votes = {}
	if (Config.Match.VoteSeconds or 0) &lt;= 0 then
		startSpawn()
		return
	end
	phase = "vote"
	phaseEnds = ctx.now() + Config.Match.VoteSeconds
	ctx.fullResync = true
	announce()
end

function MatchService.vote(userId, mode)
	if phase ~= "vote" then return false, "A votação já terminou." end
	if not Config.Modes[mode] then return false, "Modo inválido." end
	votes[userId] = mode
	announce()
	return true, "Voto registrado: " .. Config.Modes[mode].name .. "."
end

local function closeVote()
	local counts = tally()
	local best, bestCount = Config.ModeOrder[1], -1
	for _, m in ipairs(Config.ModeOrder) do
		if counts[m] &gt; bestCount then best, bestCount = m, counts[m] end
	end
	ctx.mode = best
	startSpawn()
end

-- Tests and tools: choose the mode directly.
function MatchService.setMode(mode)
	assert(Config.Modes[mode], "unknown mode " .. tostring(mode))
	ctx.mode = mode
	if phase == "vote" then
		votes = {}
		closeVote()
	end
end

function MatchService.toWaiting()
	resetWorld()
	phase = "waiting"
	winner = nil
	votes = {}
	ctx.fullResync = true
	announce()
end

-- Skips the rest of the vote/spawn phases (tests, and the preview's "start now" button).
function MatchService.startPlaying()
	if phase == "vote" then closeVote() end
	if phase == "spawn" then
		phase = "playing"
		phaseEnds = 0
		announce()
	end
end

function MatchService.tick(humanCount)
	local now = ctx.now()
	if phase == "waiting" then
		if humanCount &gt; 0 then MatchService.beginRound() end
		return
	end
	if humanCount == 0 and ctx.realPlayers then
		MatchService.toWaiting()
		return
	end
	if phase == "vote" then
		local voted = 0
		for _ in pairs(votes) do voted = voted + 1 end
		if now &gt;= phaseEnds or (humanCount &gt; 0 and voted &gt;= humanCount) then closeVote() end
	elseif phase == "spawn" then
		if now &gt;= phaseEnds then MatchService.startPlaying() end
	elseif phase == "playing" then
		ctx.Nations.checkEliminations()
		local landCount = ctx.Map.landCount
		for _, n in pairs(ctx.Nations.all()) do
			if n.alive and n.land / landCount &gt;= Config.Match.VictoryPercent then
				winner = { id = n.id, name = n.name, share = n.land / landCount }
				phase = "ended"
				phaseEnds = now + Config.Match.EndScreenSeconds
				ctx.Expansion.reset()
				announce()
				return
			end
		end
	elseif phase == "ended" then
		if now &gt;= phaseEnds then MatchService.beginRound() end
	end
end

return MatchService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">NationService</string><ProtectedString name="Source">-- Mundial War · players, AI nations and tribes: identity, colour, capital, life cycle.
local NationService = {}

local ctx
local nations = {}       -- id -&gt; nation
local byUser = {}        -- userId -&gt; nation id
local nextId = 1
local lastDeath = {}     -- userId -&gt; time of elimination (respawn cooldown)

function NationService.init(context)
	ctx = context
end

function NationService.reset()
	nations, byUser, nextId = {}, {}, 1
	lastDeath = {}
end

function NationService.get(id)
	return nations[id]
end

function NationService.all()
	return nations
end

function NationService.forUser(userId)
	local id = byUser[userId]
	return id and nations[id] or nil
end

function NationService.alive(id)
	local n = nations[id]
	return n ~= nil and n.alive
end

local function pickColor(capital)
	local Palette, Map = ctx.Palette, ctx.Map
	local used = {}
	local nearby = {}
	for _, n in pairs(nations) do
		if n.alive then
			used[n.color] = (used[n.color] or 0) + 1
			if Map:distance(n.capital, capital) &lt; 120 then
				nearby[#nearby + 1] = Palette.Nations[n.color]
			end
		end
	end
	local best, bestScore = 1, -math.huge
	for index, c in ipairs(Palette.Nations) do
		local score = 0
		local minD = 1000
		for _, other in ipairs(nearby) do
			minD = math.min(minD, Palette.distance(c, other))
		end
		score = minD - (used[index] or 0) * 400 + ctx.random() * 5
		if score &gt; bestScore then best, bestScore = index, score end
	end
	return best
end

-- Checks a spawn cell: land, neutral and far enough from every other capital.
function NationService.canSpawnAt(cell)
	local Map, Territory = ctx.Map, ctx.Territory
	if not Map:valid(cell) or not Map.land[cell] then
		return false, "Escolha uma célula de terra."
	end
	if Territory.ownerOf(cell) ~= 0 then
		return false, "Essa terra já tem dono."
	end
	local minD = ctx.Config.Spawn.MinCapitalDistance
	for _, n in pairs(nations) do
		if n.alive and Map:distance(n.capital, cell) &lt; minD then
			return false, "Muito perto da capital de " .. n.name .. "."
		end
	end
	return true
end

function NationService.canRespawn(userId)
	local t = lastDeath[userId]
	if not t then return true end
	return ctx.now() - t &gt;= ctx.Config.Match.RespawnCooldown
end

-- Creates a nation with its capital and a small starting disc of neutral land.
-- Creates a nation with its capital and starting land: a small disc of neutral land, or
-- (Conquista Extrema) a whole country passed as info.cells with its own troops/gold/oil.
function NationService.create(kind, name, cell, info)
	local Config = ctx.Config
	info = info or {}
	if not info.cells then
		local ok, why = NationService.canSpawnAt(cell)
		if not ok then return nil, why end
	end
	local id = nextId
	nextId = nextId + 1
	local troops = info.troops or (kind == "player" and Config.Spawn.PlayerStartTroops
		or kind == "bot" and Config.Spawn.BotStartTroops or Config.Spawn.TribeStartTroops)
	local n = {
		id = id, kind = kind, name = name, userId = info.userId,
		country = info.country or ctx.Map.country[cell],
		troops = troops, gold = info.gold or Config.Gold.StartGold, oil = info.oil or 0, land = 0, capital = cell,
		labelCell = cell, labelSize = 1, alive = true, color = pickColor(cell),
		built = {}, spawnedAt = ctx.now(), maxTroops = Config.Troops.BaseCapacity,
		troopRate = 0, goldRate = 0, oilRate = 0, kills = 0,
	}
	nations[id] = n
	if n.userId then byUser[n.userId] = id end
	ctx.Territory.register(id)
	if info.cells then
		for _, i in ipairs(info.cells) do
			if ctx.Territory.ownerOf(i) == 0 then ctx.Territory.setOwner(i, id) end
		end
	else
		ctx.Map:disc(cell, Config.Spawn.StartRadius, function(i)
			if ctx.Territory.ownerOf(i) == 0 then
				ctx.Territory.setOwner(i, id)
			end
		end)
	end
	ctx.emit(nil, { k = ctx.Protocol.Events.Nations, add = NationService.publicInfo(n) })
	return n
end

-- Conquista Extrema: when a player leaves, the AI takes the country back instead of erasing it.
function NationService.returnToAI(id)
	local n = nations[id]
	if not n or not n.alive or not n.userId then return end
	byUser[n.userId] = nil
	n.userId = nil
	n.kind = "bot"
	n.name = string.gsub(n.name, " %(.*%)$", "")
	ctx.Bots.adopt(id)
	ctx.emit(nil, { k = ctx.Protocol.Events.Nations, add = NationService.publicInfo(n) })
end

-- Conquista Extrema: a player takes command of the AI country that owns `cell`.
function NationService.takeover(userId, displayName, cell)
	local Map = ctx.Map
	if not Map:valid(cell) or not Map.land[cell] then return nil, "Clique num país." end
	local id = ctx.Territory.ownerOf(cell)
	local n = nations[id]
	if not n or not n.alive then return nil, "Esse lugar não pertence a nenhum país. Escolha um país colorido." end
	if n.kind == "player" then return nil, n.name .. " já é governado por outro jogador." end
	ctx.Bots.release(id)
	n.kind = "player"
	n.userId = userId
	n.name = n.name .. " (" .. displayName .. ")"
	byUser[userId] = id
	ctx.emit(nil, { k = ctx.Protocol.Events.Nations, add = NationService.publicInfo(n) })
	return n
end

function NationService.publicInfo(n)
	return {
		id = n.id, kind = n.kind, name = n.name, userId = n.userId, color = n.color,
		capital = n.capital, country = n.country, alive = n.alive,
	}
end

-- Called when a nation reaches zero land or its player leaves.
function NationService.eliminate(id, reason)
	local n = nations[id]
	if not n or not n.alive then return end
	n.alive = false
	n.troops = 0
	ctx.Expansion.cancelAll(id, false)
	ctx.Naval.removeNation(id)
	ctx.Diplomacy.removeNation(id)
	ctx.Territory.releaseAll(id)
	if n.userId then
		lastDeath[n.userId] = ctx.now()
		byUser[n.userId] = nil
	end
	ctx.emit(nil, { k = ctx.Protocol.Events.Nations, remove = id, reason = reason })
end

function NationService.checkEliminations()
	for id, n in pairs(nations) do
		if n.alive and n.land &lt;= 0 then
			NationService.eliminate(id, "conquered")
		end
	end
end

function NationService.countAlive(kind)
	local c = 0
	for _, n in pairs(nations) do
		if n.alive and (kind == nil or n.kind == kind) then c = c + 1 end
	end
	return c
end

return NationService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">NavalService</string><ProtectedString name="Source">-- Mundial War · ports, troop transports across water, defence boats, amphibious landings.
local NavalService = {}

local ctx, Config, Map, Territory
local fleets = {}        -- list of { id, nation, troops, path, progress, target }
local boats = {}         -- list of { id, nation, port, level, x, y, hp, center, path, step, waypoint }
local cargos = {}        -- list of { id, nation, port, path, progress, value }
local portTimers = {}    -- port cell -&gt; next time it sends a cargo ship
local cargoClock = 0
local waterBody = nil    -- cell -&gt; connected water body id
local nextId = 1
local visit, prev, vstamp = {}, {}, 0
local nb = {}

function NavalService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
	Territory = ctx.Territory
	-- connected water bodies, so a boat is only sent where it can actually sail
	waterBody = {}
	local id, scratch = 0, {}
	for start = 1, Map.N do
		if not Map.land[start] and not waterBody[start] then
			id = id + 1
			local queue, head = { start }, 1
			waterBody[start] = id
			while head &lt;= #queue do
				local i = queue[head]
				head = head + 1
				local n = Map:neighbors(i, scratch)
				for k = 1, n do
					local j = scratch[k]
					if not Map.land[j] and not waterBody[j] then
						waterBody[j] = id
						queue[#queue + 1] = j
					end
				end
			end
		end
	end
end

function NavalService.reset()
	fleets, boats, cargos, portTimers, nextId, cargoClock = {}, {}, {}, {}, 1, 0
end

function NavalService.cargos()
	return cargos
end

function NavalService.fleets()
	return fleets
end

function NavalService.boats()
	return boats
end

local function waterNeighbor(cell)
	local n = Map:neighbors(cell, nb)
	for k = 1, n do
		if not Map.land[nb[k]] then return nb[k] end
	end
	return nil
end

-- Breadth-first search over water from the target shore back to any of the nation's ports.
-- Returns the water path ordered port -&gt; target, or nil.
function NavalService.route(nid, targetCell, limit)
	local ports = ctx.Buildings.ofKind(nid, "port")
	if #ports == 0 then return nil, "Construa um porto no litoral primeiro." end
	vstamp = vstamp + 1
	local goal = {}
	for _, p in ipairs(ports) do
		local n = Map:neighbors(p.cell, nb)
		for k = 1, n do
			if not Map.land[nb[k]] then goal[nb[k]] = true end
		end
	end
	local queue, head = {}, 1
	local n = Map:neighbors(targetCell, nb)
	for k = 1, n do
		local j = nb[k]
		if not Map.land[j] and visit[j] ~= vstamp then
			visit[j] = vstamp
			prev[j] = 0
			queue[#queue + 1] = j
		end
	end
	local scratch = {}
	while head &lt;= #queue do
		if limit and head &gt; limit then break end
		local i = queue[head]
		head = head + 1
		if goal[i] then
			local path = {}
			while i ~= 0 do
				path[#path + 1] = i
				i = prev[i]
			end
			return path
		end
		local m = Map:neighbors(i, scratch)
		for k = 1, m do
			local j = scratch[k]
			if not Map.land[j] and visit[j] ~= vstamp then
				visit[j] = vstamp
				prev[j] = i
				queue[#queue + 1] = j
			end
		end
	end
	return nil, "Nenhuma rota marítima a partir dos seus portos."
end

function NavalService.launch(nid, cell, percent, searchLimit)
	local N = Config.Naval
	local n = ctx.Nations.get(nid)
	if not ctx.Match.isPlaying() then return false, "Aguarde o início da partida." end
	if not n or not n.alive then return false, "Você não tem nação." end
	if not Map:valid(cell) or not Map.land[cell] then return false, "Escolha uma costa como destino." end
	if not Map.coast[cell] then return false, "O desembarque precisa ser numa célula de litoral." end
	if type(percent) ~= "number" or percent ~= percent or percent &lt; 0.01 or percent &gt; 1 then
		return false, "Percentual inválido."
	end
	local owner = Territory.ownerOf(cell)
	if owner == nid then return false, "Essa costa já é sua." end
	if owner &gt; 0 and not ctx.Diplomacy.canAttack(nid, owner) then return false, "Não é possível invadir um aliado." end
	local active = 0
	for _, f in ipairs(fleets) do
		if f.nation == nid then active = active + 1 end
	end
	if active &gt;= N.MaxFleetsPerNation then return false, "Limite de frotas em viagem atingido." end
	local troops = math.floor(n.troops * percent)
	if troops &lt; N.MinTroops then return false, "A frota precisa de pelo menos " .. N.MinTroops .. " tropas." end
	if n.gold &lt; N.TransportGold then return false, "Transporte custa " .. N.TransportGold .. " de ouro." end
	local path, why = NavalService.route(nid, cell, searchLimit)
	if not path then return false, why end
	n.gold = n.gold - N.TransportGold
	n.troops = n.troops - troops
	if owner &gt; 0 then ctx.Diplomacy.ensureWar(nid, owner) end
	local fleet = { id = nextId, nation = nid, troops = troops, path = path, progress = 1, target = cell }
	nextId = nextId + 1
	fleets[#fleets + 1] = fleet
	ctx.emit(nil, { k = ctx.Protocol.Events.Orders, fleet = { fleet.id, nid, troops, path, N.Speed, cell } })
	return true, "Frota a caminho com " .. troops .. " tropas."
end

local function boatCell(b)
	return Map:index(math.floor(b.x), math.floor(b.y))
end

-- Water path between two water cells (BFS, nil when not connected).
local function waterPath(from, to)
	if waterBody[from] ~= waterBody[to] then return nil end
	vstamp = vstamp + 1
	local queue, head = { from }, 1
	visit[from] = vstamp
	prev[from] = 0
	local scratch = {}
	while head &lt;= #queue do
		local i = queue[head]
		head = head + 1
		if i == to then
			local rev = {}
			while i ~= 0 do rev[#rev + 1] = i i = prev[i] end
			local path = {}
			for k = #rev, 1, -1 do path[#path + 1] = rev[k] end
			return path
		end
		local m = Map:neighbors(i, scratch)
		for k = 1, m do
			local j = scratch[k]
			if not Map.land[j] and visit[j] ~= vstamp then
				visit[j] = vstamp
				prev[j] = i
				queue[#queue + 1] = j
			end
		end
	end
	return nil
end

function NavalService.boatsAt(portCell)
	local c = 0
	for _, b in ipairs(boats) do if b.port == portCell then c = c + 1 end end
	return c
end

-- Defence boat: bought at one of your ports; patrols around that port until you send it elsewhere.
-- Air bridge: troops fly in a straight line from an air base, ignoring water.
function NavalService.launchAir(nid, fromCell, targetCell, troops)
	local ax, ay = Map:xy(fromCell)
	local bx, by = Map:xy(targetCell)
	local steps = math.max(1, math.floor(math.max(math.abs(bx - ax), math.abs(by - ay))))
	local path = {}
	for k = 0, steps do
		local t = k / steps
		path[#path + 1] = Map:index(math.floor(ax + (bx - ax) * t + 0.5), math.floor(ay + (by - ay) * t + 0.5))
	end
	local fleet = { id = nextId, nation = nid, troops = troops, path = path, progress = 1, target = targetCell,
		air = true, speed = Config.Naval.AirliftSpeed }
	nextId = nextId + 1
	fleets[#fleets + 1] = fleet
	local owner = Territory.ownerOf(targetCell)
	if owner &gt; 0 then ctx.Diplomacy.ensureWar(nid, owner) end
	ctx.emit(nil, { k = ctx.Protocol.Events.Orders, fleet = { fleet.id, nid, troops, path, fleet.speed, targetCell, true } })
	return fleet
end

function NavalService.buyBoat(nid, portCell)
	local N = Config.Naval
	local n = ctx.Nations.get(nid)
	if not ctx.Match.isPlaying() then return false, "Aguarde o início da partida." end
	if not n or not n.alive then return false, "Você não tem nação." end
	local port = ctx.Buildings.at(portCell)
	if not port or port.kind ~= "port" or port.owner ~= nid then return false, "Selecione um porto seu." end
	local limit = ctx.Buildings.stat(port, "boats")
	if NavalService.boatsAt(portCell) &gt;= limit then return false, "Este porto já tem " .. limit .. " barcos. Melhore o porto para ter mais." end
	if n.gold &lt; N.BoatGold then return false, "Barco de defesa custa " .. N.BoatGold .. " de ouro." end
	local water = waterNeighbor(portCell)
	if not water then return false, "Porto sem acesso à água." end
	n.gold = n.gold - N.BoatGold
	local x, y = Map:xy(water)
	boats[#boats + 1] = {
		id = nextId, nation = nid, port = portCell, level = port.level, x = x + 0.5, y = y + 0.5,
		hp = N.BoatHealth, center = water, path = nil, step = 1, waypoint = nil,
	}
	nextId = nextId + 1
	return true, "Barco de defesa lançado. Clique nele e depois na água para escolher onde patrulhar."
end

function NavalService.patrol(nid, boatId, cell)
	if not Map:valid(cell) or Map.land[cell] then return false, "Escolha um ponto na água." end
	for _, b in ipairs(boats) do
		if b.id == boatId then
			if b.nation ~= nid then return false, "Esse barco não é seu." end
			local here = boatCell(b)
			local path = here and waterPath(here, cell)
			if not path then return false, "O barco não alcança esse ponto por água." end
			b.center, b.path, b.step, b.waypoint = cell, path, 1, nil
			return true, "Barco a caminho da nova patrulha."
		end
	end
	return false, "Barco não encontrado."
end

function NavalService.onPortLost(portCell)
	-- boats already at sea keep fighting for their nation; the port just stops building more
end

function NavalService.removeNation(nid)
	local k = 1
	for i = 1, #fleets do
		if fleets[i].nation ~= nid then fleets[k] = fleets[i] k = k + 1 end
	end
	for i = k, #fleets do fleets[i] = nil end
	k = 1
	for i = 1, #boats do
		if boats[i].nation ~= nid then boats[k] = boats[i] k = k + 1 end
	end
	for i = k, #boats do boats[i] = nil end
	k = 1
	for i = 1, #cargos do
		if cargos[i].nation ~= nid then cargos[k] = cargos[i] k = k + 1 end
	end
	for i = k, #cargos do cargos[i] = nil end
end

local function boatRange(b) return Config.Naval.BoatRange + (b.level - 1) end
local function boatDamage(b) return Config.Naval.BoatDamage + 4 * (b.level - 1) end

local function moveBoat(b, dt)
	local N = Config.Naval
	local tx, ty
	if b.path and b.step &lt;= #b.path then
		local x, y = Map:xy(b.path[b.step])
		tx, ty = x + 0.5, y + 0.5
	else
		b.path = nil
		if not b.waypoint then
			-- pick a nearby water cell on the patrol circle
			local cx, cy = Map:xy(b.center)
			for _ = 1, 8 do
				local a = ctx.random() * math.pi * 2
				local r = N.BoatOrbit * (0.5 + ctx.random() * 0.5)
				local c = Map:index(math.floor(cx + 0.5 + math.cos(a) * r), math.floor(cy + 0.5 + math.sin(a) * r))
				if c and not Map.land[c] and waterBody[c] == waterBody[b.center] then b.waypoint = c break end
			end
			b.waypoint = b.waypoint or b.center
		end
		local x, y = Map:xy(b.waypoint)
		tx, ty = x + 0.5, y + 0.5
	end
	local dx, dy = tx - b.x, ty - b.y
	local d = math.sqrt(dx * dx + dy * dy)
	local stepLen = N.BoatSpeed * dt
	if d &lt;= stepLen then
		b.x, b.y = tx, ty
		if b.path then b.step = b.step + 1 else b.waypoint = nil end
	else
		b.x, b.y = b.x + dx / d * stepLen, b.y + dy / d * stepLen
	end
end

-- Boats fight enemy boats, wear down enemy transports and raid gold from enemy ports in reach.
-- Boats fight enemy boats (every tick) and, once per second, wear down transports, raid
-- enemy ports and take fire from anti-naval batteries. The slow checks run on a 1 s pulse
-- against short lists (ports, batteries) instead of a spatial query per boat per tick.
local slowPulse = 0
local function boatCombat(dt)
	local N = Config.Naval
	local Diplomacy = ctx.Diplomacy
	for _, b in ipairs(boats) do
		local range = boatRange(b)
		local r2 = range * range
		local target, best = nil, math.huge
		for _, o in ipairs(boats) do
			if o.nation ~= b.nation and o.hp &gt; 0 then
				local d = (o.x - b.x) ^ 2 + (o.y - b.y) ^ 2
				if d &lt;= r2 and d &lt; best and Diplomacy.relation(b.nation, o.nation) == "war" then target, best = o, d end
			end
		end
		if target then target.hp = target.hp - boatDamage(b) * dt end
	end
	slowPulse = slowPulse + dt
	if slowPulse &gt;= 1 and #boats + #fleets &gt; 0 then
		local step = slowPulse
		slowPulse = 0
		local ports, batteries = {}, {}
		for _, bld in pairs(ctx.Buildings.all()) do
			if bld.active then
				if bld.kind == "port" then
					local x, y = Map:xy(bld.cell)
					ports[#ports + 1] = { owner = bld.owner, x = x + 0.5, y = y + 0.5 }
				elseif bld.kind == "antinaval" then
					local x, y = Map:xy(bld.cell)
					local r = ctx.Buildings.stat(bld, "radius")
					batteries[#batteries + 1] = { owner = bld.owner, x = x + 0.5, y = y + 0.5, r2 = r * r, damage = ctx.Buildings.stat(bld, "damage") }
				end
			end
		end
		for _, b in ipairs(boats) do
			local range = boatRange(b)
			local r2 = range * range
			for _, f in ipairs(fleets) do
				if not f.air and f.nation ~= b.nation then
					local px, py = Map:xy(f.path[math.min(#f.path, math.floor(f.progress))])
					if (px + 0.5 - b.x) ^ 2 + (py + 0.5 - b.y) ^ 2 &lt;= r2 and Diplomacy.relation(b.nation, f.nation) == "war" then
						f.troops = f.troops * (1 - N.BoatTransportDamage * step)
					end
				end
			end
			local owner = ctx.Nations.get(b.nation)
			for _, p in ipairs(ports) do
				if p.owner ~= b.nation and (p.x - b.x) ^ 2 + (p.y - b.y) ^ 2 &lt;= r2 and Diplomacy.relation(b.nation, p.owner) == "war" then
					local victim = ctx.Nations.get(p.owner)
					if victim and owner then
						local take = math.min(victim.gold, N.BoatGoldSteal * step)
						victim.gold = victim.gold - take
						owner.gold = owner.gold + take
					end
				end
			end
			local dmg = 0
			for _, a in ipairs(batteries) do
				if a.owner ~= b.nation and (a.x - b.x) ^ 2 + (a.y - b.y) ^ 2 &lt;= a.r2 and Diplomacy.relation(a.owner, b.nation) == "war" then
					if a.damage &gt; dmg then dmg = a.damage end
				end
			end
			if dmg &gt; 0 then b.hp = b.hp - dmg * step end
		end
		if #batteries &gt; 0 then
			for _, f in ipairs(fleets) do
				if not f.air then
					local px, py = Map:xy(f.path[math.min(#f.path, math.floor(f.progress))])
					for _, a in ipairs(batteries) do
						if a.owner ~= f.nation and (a.x - px - 0.5) ^ 2 + (a.y - py - 0.5) ^ 2 &lt;= a.r2 and Diplomacy.relation(a.owner, f.nation) == "war" then
							f.troops = f.troops * (1 - N.BoatTransportDamage * step)
							break
						end
					end
				end
			end
		end
	end
	local k = 1
	for i = 1, #boats do
		local b = boats[i]
		if b.hp &gt; 0 then
			boats[k] = b
			k = k + 1
		else
			ctx.notify(b.nation, "Um barco de defesa seu foi afundado.", "bad")
		end
	end
	for i = k, #boats do boats[i] = nil end
end

-- Trade run for a cargo ship: out to a water cell about CargoTripCells away and back.
local function tradeRoute(portCell)
	local start = waterNeighbor(portCell)
	if not start then return nil end
	local N = Config.Naval
	vstamp = vstamp + 1
	local queue, head = { start }, 1
	visit[start] = vstamp
	prev[start] = 0
	local far, farD = start, 0
	local sx, sy = Map:xy(start)
	local scratch = {}
	local limit = math.floor(math.pi * N.CargoTripCells * N.CargoTripCells)
	while head &lt;= #queue and #queue &lt; limit do
		local i = queue[head]
		head = head + 1
		local x, y = Map:xy(i)
		local d = (x - sx) ^ 2 + (y - sy) ^ 2
		if d &gt; farD and ctx.random() &lt; 0.6 then far, farD = i, d end
		local m = Map:neighbors(i, scratch)
		for k = 1, m do
			local j = scratch[k]
			if not Map.land[j] and visit[j] ~= vstamp then
				visit[j] = vstamp
				prev[j] = i
				queue[#queue + 1] = j
			end
		end
	end
	if far == start then return nil end
	local back = {}
	local i = far
	while i ~= 0 do back[#back + 1] = i i = prev[i] end
	local path = {}
	for k = #back, 1, -1 do path[#path + 1] = back[k] end      -- port -&gt; far
	for k = 2, #back do path[#path + 1] = back[k] end          -- far -&gt; port
	return path
end

local capturePulse = 0
local NO_BOATS = {}
local function cargoTick(dt)
	local N = Config.Naval
	cargoClock = cargoClock + dt
	if cargoClock &gt;= 1 then
		cargoClock = 0
		local now = ctx.now()
		local atSea = {}
		for _, c in ipairs(cargos) do atSea[c.port] = (atSea[c.port] or 0) + 1 end
		for cell, b in pairs(ctx.Buildings.all()) do
			if b.kind == "port" and b.active and b.owner &gt; 0 then
				local nextAt = portTimers[cell]
				if not nextAt then
					portTimers[cell] = now + N.CargoInterval * (0.3 + ctx.random() * 0.7)
				elseif now &gt;= nextAt and (atSea[cell] or 0) &lt; b.level * N.CargoPerPortLevel then
					portTimers[cell] = now + N.CargoInterval
					local path = tradeRoute(cell)
					if path then
						cargos[#cargos + 1] = { id = nextId, nation = b.owner, port = cell, path = path, progress = 1,
							value = N.CargoValue + N.CargoValuePerLevel * (b.level - 1) }
						nextId = nextId + 1
					end
				end
			end
		end
	end
	local k = 1
	capturePulse = capturePulse + dt
	local checkCaptures = capturePulse &gt;= 0.5 and #boats &gt; 0
	if capturePulse &gt;= 0.5 then capturePulse = 0 end
	for i = 1, #cargos do
		local c = cargos[i]
		local keep = ctx.Nations.alive(c.nation)
		if keep then
			c.progress = c.progress + N.CargoSpeed * dt
			local pos = c.path[math.min(#c.path, math.floor(c.progress))]
			local px, py = Map:xy(pos)
			-- an enemy defence boat in reach captures the cargo (checked twice a second)
			for _, b in ipairs(checkCaptures and boats or NO_BOATS) do
				if b.nation ~= c.nation and ctx.Diplomacy.relation(b.nation, c.nation) == "war" then
					local r = boatRange(b)
					if (px + 0.5 - b.x) ^ 2 + (py + 0.5 - b.y) ^ 2 &lt;= r * r then
						local captor = ctx.Nations.get(b.nation)
						local prize = math.floor(c.value * N.CargoCaptureFactor)
						if captor then captor.gold = captor.gold + prize end
						ctx.notify(b.nation, "💰 Navio de carga capturado: +" .. prize .. " de ouro.", "good")
						ctx.notify(c.nation, "Um navio de carga seu foi capturado.", "bad")
						keep = false
						break
					end
				end
			end
			if keep and c.progress &gt;= #c.path then
				local n = ctx.Nations.get(c.nation)
				local port = ctx.Buildings.at(c.port)
				if n and port and port.owner == c.nation then n.gold = n.gold + c.value end
				keep = false
			end
		end
		if keep then
			cargos[k] = c
			k = k + 1
		end
	end
	for i = k, #cargos do cargos[i] = nil end
end

-- Cargo rows for clients: { id, nation, cell }
function NavalService.cargoView()
	local out = {}
	for _, c in ipairs(cargos) do
		out[#out + 1] = { c.id, c.nation, c.path[math.min(#c.path, math.floor(c.progress))] }
	end
	return out
end

local function land(f)
	local C = Config.Combat
	local n = ctx.Nations.get(f.nation)
	local owner = Territory.ownerOf(f.target)
	if owner == f.nation then
		n.troops = n.troops + f.troops
		return
	end
	if owner &gt; 0 and not ctx.Diplomacy.canAttack(f.nation, owner) then
		n.troops = n.troops + f.troops
		ctx.notify(f.nation, "A frota voltou: o destino virou aliado.", "info")
		return
	end
	local cost, loss = ctx.Combat.cellCost(f.nation, f.target, f.troops, nil)
	cost = cost * C.LandingCostFactor
	if owner &gt; 0 and not f.air then
		local battery = ctx.Buildings.covered(f.target, "antinaval", owner, "landing")
		if battery then cost = cost * battery end
	end
	if f.troops &gt;= cost then
		if owner &gt; 0 then
			local d = ctx.Nations.get(owner)
			d.troops = math.max(0, d.troops - loss)
			ctx.notify(owner, n.name .. (f.air and " lançou paraquedistas no seu território!" or " desembarcou no seu litoral!"), "war")
		end
		Territory.setOwner(f.target, f.nation)
		local remaining = math.floor(f.troops - cost)
		if remaining &gt;= Config.Expansion.MinTroopsToSend then
			ctx.Expansion.start(f.nation, owner, f.target, remaining)
		elseif remaining &gt; 0 then
			n.troops = n.troops + remaining
		end
		ctx.notify(f.nation, "Desembarque concluído.", "good")
	else
		if owner &gt; 0 then
			local d = ctx.Nations.get(owner)
			d.troops = math.max(0, d.troops - f.troops * C.MinFailedLandingDamage)
		end
		ctx.notify(f.nation, "O desembarque fracassou: a defesa era forte demais.", "bad")
	end
end

function NavalService.tick(dt)
	if not ctx.Match.isPlaying() then return end
	local N = Config.Naval
	local k = 1
	for i = 1, #fleets do
		local f = fleets[i]
		local n = ctx.Nations.get(f.nation)
		local keep = n ~= nil and n.alive
		if keep then
			f.progress = f.progress + (f.speed or N.Speed) * dt
			if f.troops &lt; 1 then
				ctx.notify(f.nation, "Sua frota foi afundada.", "bad")
				keep = false
			elseif f.progress &gt;= #f.path then
				if f.air and ctx.Strategic.intercepts(f.nation, f.target, true) then
					f.troops = f.troops * (1 - N.AirliftInterceptLoss)
					ctx.notify(f.nation, "A antiaérea inimiga atingiu sua ponte aérea.", "bad")
				end
				land(f)
				keep = false
			end
		end
		if keep then
			fleets[k] = f
			k = k + 1
		else
			ctx.emit(nil, { k = ctx.Protocol.Events.Orders, fleetEnd = f.id })
		end
	end
	for i = k, #fleets do fleets[i] = nil end
	for _, b in ipairs(boats) do
		if ctx.Nations.alive(b.nation) then moveBoat(b, dt) end
	end
	boatCombat(dt)
	cargoTick(dt)
end

-- Boat rows for clients: { id, nation, x, y, health, patrolCell, level }
function NavalService.boatView()
	local out = {}
	for _, b in ipairs(boats) do
		out[#out + 1] = { b.id, b.nation, math.floor(b.x * 10) / 10, math.floor(b.y * 10) / 10, math.floor(b.hp), b.center, b.level }
	end
	return out
end

function NavalService.publicView()
	local out = {}
	for _, f in ipairs(fleets) do
		out[#out + 1] = { f.id, f.nation, math.floor(f.troops), f.progress }
	end
	return out
end

function NavalService.snapshot()
	local fl, ws = {}, {}
	for _, f in ipairs(fleets) do
		fl[#fl + 1] = { f.id, f.nation, math.floor(f.troops), f.path, f.speed or Config.Naval.Speed, f.target, f.progress, f.air == true }
	end
	return fl, NavalService.boatView()
end

return NavalService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">NetworkService</string><ProtectedString name="Source">-- Mundial War · Roblox side of replication: remotes, join sync, batched broadcasts.
-- All decisions are made by World/CommandService; this module only moves data.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkService = {}

local world, ctx, Protocol, Config
local commandRemote, eventRemote
local ready = {}            -- player -&gt; true once the client asked for its first sync
local clocks = { delta = 0, nations = 0, orders = 0, private = 0 }

local function remote(name)
	local folder = ReplicatedStorage:FindFirstChild("MundialWarRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "MundialWarRemotes"
		folder.Parent = ReplicatedStorage
	end
	local r = folder:FindFirstChild(name)
	if not r then
		r = Instance.new("RemoteEvent")
		r.Name = name
		r.Parent = folder
	end
	return r
end

local function playerForNation(nid)
	local n = ctx.Nations.get(nid)
	if not n or not n.userId then return nil end
	return Players:GetPlayerByUserId(n.userId)
end

local function sendInit(player)
	eventRemote:FireClient(player, world:initPayload(player.UserId))
end

local function broadcast(payload)
	for player in pairs(ready) do
		if player.Parent then eventRemote:FireClient(player, payload) end
	end
end

function NetworkService.start(theWorld)
	world = theWorld
	ctx = world.ctx
	Protocol = ctx.Protocol
	Config = ctx.Config
	ctx.realPlayers = true
	commandRemote = remote(Protocol.CommandRemote)
	eventRemote = remote(Protocol.EventRemote)

	commandRemote.OnServerEvent:Connect(function(player, action, a, b, c)
		if action == Protocol.Actions.Sync then
			if ready[player] and ready[player] &gt; os.clock() - 2 then return end -- sync spam guard
			ready[player] = os.clock()
			sendInit(player)
			return
		end
		local ok, message = ctx.Commands.handle(player.UserId, player.DisplayName, action, a, b, os.clock(), c)
		if message then
			eventRemote:FireClient(player, { k = Protocol.Events.Notice, text = message, kind = ok and "good" or "bad" })
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		ready[player] = nil
		ctx.Commands.forget(player.UserId)
		local n = ctx.Nations.forUser(player.UserId)
		if n and n.alive then
			if ctx.mode == "extreme" then
				ctx.Nations.returnToAI(n.id)
			else
				ctx.Nations.eliminate(n.id, "left")
			end
		end
	end)
end

function NetworkService.flush(dt)
	-- events produced by the simulation (notices, diplomacy, launches, match changes)
	for _, item in ipairs(world:drainOutbox()) do
		if item.to == nil then
			broadcast(item.payload)
		else
			local player = playerForNation(item.to)
			if player and ready[player] then eventRemote:FireClient(player, item.payload) end
		end
	end
	if ctx.fullResync then
		ctx.fullResync = false
		world:deltaPayload() -- discard: the init snapshot already contains it
		for player in pairs(ready) do
			if player.Parent then sendInit(player) end
		end
	end

	local T = Config.Tick
	clocks.delta = clocks.delta + dt
	clocks.nations = clocks.nations + dt
	clocks.orders = clocks.orders + dt
	clocks.private = clocks.private + dt
	if clocks.delta &gt;= T.TerritoryDelta then
		clocks.delta = 0
		local payload = world:deltaPayload()
		if payload then broadcast(payload) end
	end
	if clocks.orders &gt;= T.PublicOrders then
		clocks.orders = 0
		broadcast(world:ordersPayload())
	end
	if clocks.nations &gt;= T.PublicNations then
		clocks.nations = 0
		broadcast(world:nationsPayload())
	end
	if clocks.private &gt;= T.TerritoryDelta then
		clocks.private = 0
		for player in pairs(ready) do
			local payload = world:privatePayload(player.UserId)
			if payload and player.Parent then eventRemote:FireClient(player, payload) end
		end
	end
end

return NetworkService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">StrategicService</string><ProtectedString name="Source">-- Mundial War · strategic weapons fired from air bases or silos: air strike, cluster, fire
-- bomb, EMP, atomic, hydrogen, End of an Era (multiple warheads) and the air bridge.
-- Air defence stops missiles and aircraft; the flak building stops aircraft only; nothing
-- stops the End of an Era.
local StrategicService = {}

local ctx, Config, Map, Territory
local missiles = {}
local fires = {}         -- { id, nation, center, radius, max, grow, endsAt, troopBurn, pulse }
local nextId = 1

function StrategicService.init(context)
	ctx = context
	Config = ctx.Config
	Map = ctx.Map
	Territory = ctx.Territory
end

function StrategicService.reset()
	missiles, fires, nextId = {}, {}, 1
end

function StrategicService.fires()
	return fires
end

function StrategicService.missiles()
	return missiles
end

-- Nearest ready launcher of the right kind (and level) that reaches the target.
local function pickLauncher(nid, weapon, target)
	local best, bestD = nil, math.huge
	local now = ctx.now()
	local why = "Aguarde a recarga do lançador."
	for _, b in ipairs(ctx.Buildings.ofKind(nid, weapon.launcher)) do
		if not b.active then
			why = "Seu lançador está desligado por um EMP."
		elseif weapon.minLevel and b.level &lt; weapon.minLevel then
			why = "Requer " .. Config.Buildings[weapon.launcher].name .. " nível " .. weapon.minLevel .. "."
		elseif b.readyAt &lt;= now then
			local d = Map:distance(b.cell, target)
			local range = ctx.Buildings.stat(b, "range")
			if range and d &gt; range then
				why = "Alvo fora do alcance da base aérea (" .. math.floor(range) .. " células)."
			elseif d &lt; bestD then
				best, bestD = b, d
			end
		end
	end
	return best, bestD, why
end

local function addMissile(nid, kind, from, to, speed)
	local m = { id = nextId, kind = kind, nation = nid, from = from, to = to, progress = 0,
		distance = math.max(1, Map:distance(from, to)), speed = speed }
	nextId = nextId + 1
	missiles[#missiles + 1] = m
	ctx.emit(nil, { k = ctx.Protocol.Events.Impact, launch = { m.id, kind, nid, m.from, m.to, m.speed } })
	return m
end

-- End of an Era: besides the chosen target, the capitals of up to (warheads-1) other
-- nations at war with the launcher, nearest first.
local function extraTargets(nid, cell, count, skip)
	local list = {}
	for id, other in pairs(ctx.Nations.all()) do
		if other.alive and id ~= nid and id ~= skip and ctx.Diplomacy.relation(nid, id) == "war"
			and Territory.ownerOf(other.capital) == id then
			list[#list + 1] = { cell = other.capital, d = Map:distance(other.capital, cell) }
		end
	end
	table.sort(list, function(a, b) return a.d &lt; b.d end)
	local out = {}
	for k = 1, math.min(count, #list) do out[k] = list[k].cell end
	return out
end

function StrategicService.launch(nid, cell, kind, percent)
	local weapon = Config.Weapons[kind]
	local n = ctx.Nations.get(nid)
	if not weapon then return false, "Arma inválida." end
	if weapon.mode and weapon.mode ~= ctx.mode then return false, weapon.name .. " só existe na Conquista Extrema." end
	if not ctx.Match.isPlaying() then return false, "Aguarde o início da partida." end
	if not n or not n.alive then return false, "Você não tem nação." end
	if not Map:valid(cell) then return false, "Alvo inválido." end
	local owner = Territory.ownerOf(cell)
	if owner == nid then return false, "Esse alvo é seu." end
	if owner &gt; 0 and ctx.Diplomacy.allied(nid, owner) then return false, "Não é possível atacar um aliado." end
	if kind == "airstrike" and owner &lt;= 0 then return false, "Ataque aéreo precisa de um alvo inimigo." end
	if weapon.troops and owner == -1 then return false, "As tropas precisam pousar em terra." end
	if ctx.Buildings.count(nid, weapon.launcher) &lt;= 0 then
		return false, "Requer " .. Config.Buildings[weapon.launcher].name .. "."
	end
	local launcher, distance, why = pickLauncher(nid, weapon, cell)
	if not launcher then return false, why end
	local oil = ctx.mode == "extreme" and weapon.oil or 0
	if n.gold &lt; weapon.gold then return false, weapon.name .. " custa " .. weapon.gold .. " de ouro." end
	if oil &gt; 0 and (n.oil or 0) &lt; oil then return false, weapon.name .. " precisa de " .. oil .. " de petróleo." end
	local troops = 0
	if weapon.troops then
		if type(percent) ~= "number" or percent ~= percent or percent &lt; 0.01 or percent &gt; 1 then return false, "Percentual inválido." end
		local N = Config.Naval
		local cap = N.AirliftMaxTroops + N.AirliftMaxPerLevel * (launcher.level - 1)
		troops = math.min(cap, math.floor(n.troops * percent))
		if troops &lt; N.MinTroops then return false, "A ponte aérea precisa de pelo menos " .. N.MinTroops .. " tropas." end
	end
	n.gold = n.gold - weapon.gold
	if oil &gt; 0 then n.oil = n.oil - oil end
	local factor = ctx.Buildings.stat(launcher, "cooldownFactor") or 1
	launcher.readyAt = ctx.now() + weapon.cooldown * factor
	if weapon.troops then
		n.troops = n.troops - troops
		ctx.Naval.launchAir(nid, launcher.cell, cell, troops)
		return true, "Ponte aérea: " .. troops .. " tropas a caminho."
	end
	if owner &gt; 0 then ctx.Diplomacy.ensureWar(nid, owner) end
	addMissile(nid, kind, launcher.cell, cell, weapon.speed)
	if weapon.warheads then
		for _, extra in ipairs(extraTargets(nid, cell, weapon.warheads - 1, owner)) do
			addMissile(nid, kind, launcher.cell, extra, weapon.speed)
			local victim = Territory.ownerOf(extra)
			if victim &gt; 0 then ctx.notify(victim, weapon.icon .. " " .. weapon.name .. " de " .. n.name .. " a caminho!", "war") end
		end
	end
	if owner &gt; 0 then
		ctx.notify(owner, weapon.icon .. " " .. weapon.name .. " de " .. n.name .. " a caminho!", "war")
	end
	return true, weapon.name .. " lançada."
end

-- Kept for older callers: the atomic bomb and the air strike.
function StrategicService.launchNuke(nid, cell) return StrategicService.launch(nid, cell, "atomic") end
function StrategicService.launchAirstrike(nid, cell) return StrategicService.launch(nid, cell, "airstrike") end

-- Anti-air of the target's owner (and allies) may shoot it down: air defence stops missiles
-- and aircraft, flak stops aircraft only, the End of an Era cannot be stopped.
function StrategicService.intercepts(attacker, targetCell, aircraft)
	local owner = Territory.ownerOf(targetCell)
	if owner &lt;= 0 then return false end
	local defenders = ctx.Diplomacy.allies(owner)
	defenders[#defenders + 1] = owner
	local isDefender = {}
	for _, d in ipairs(defenders) do isDefender[d] = true end
	local hit = false
	local tx, ty = Map:xy(targetCell)
	local reach = math.max(ctx.Stats.maxStat(Config, "airdefense", "radius"), ctx.Stats.maxStat(Config, "flak", "radius"))
	ctx.Buildings.near(targetCell, reach, function(b)
		if (b.kind == "airdefense" or (b.kind == "flak" and aircraft)) and b.active and isDefender[b.owner] and b.owner ~= attacker then
			local r = ctx.Buildings.stat(b, "radius")
			local bx, by = Map:xy(b.cell)
			if (bx - tx) ^ 2 + (by - ty) ^ 2 &lt;= r * r and ctx.random() &lt; ctx.Buildings.stat(b, "intercept") then
				hit = true
				return true
			end
		end
	end)
	return hit
end

local function intercepted(m)
	local w = Config.Weapons[m.kind]
	if w.unstoppable then return false end
	return StrategicService.intercepts(m.nation, m.to, w.aircraft == true)
end

local function startFire(nid, cell, spec)
	fires[#fires + 1] = { id = nextId, nation = nid, center = cell, radius = 1, max = spec.radius, grow = spec.grow,
		endsAt = ctx.now() + spec.seconds, troopBurn = spec.troopBurn, pulse = 0 }
	nextId = nextId + 1
end

local function impact(m)
	local w = Config.Weapons[m.kind]
	local radius = w.radius
	-- structures
	local struck = {}
	ctx.Buildings.near(m.to, radius, function(b)
		if b.owner ~= m.nation and not ctx.Diplomacy.allied(m.nation, b.owner) then struck[#struck + 1] = b.cell end
	end)
	for _, cell in ipairs(struck) do
		if w.destroys then
			ctx.Buildings.destroy(cell)
		elseif w.disable then
			ctx.Buildings.disable(cell, ctx.now() + w.disable)
		end
	end
	if w.destroys and w.disable then
		-- End of an Era: the EMP ring reaches beyond the blast
		ctx.Buildings.near(m.to, radius * 1.6, function(b)
			if b.owner ~= m.nation and not ctx.Diplomacy.allied(m.nation, b.owner) then
				ctx.Buildings.disable(b.cell, ctx.now() + w.disable)
			end
		end)
	end
	if w.fire then startFire(m.nation, m.to, w.fire) end
	-- troops
	if w.troopKill then
		local hits, fallout = {}, {}
		Map:disc(m.to, radius, function(i)
			local o = Territory.ownerOf(i)
			if o &gt; 0 and o ~= m.nation and not ctx.Diplomacy.allied(m.nation, o) then
				hits[o] = (hits[o] or 0) + 1
				if w.fallout and Map:distance(i, m.to) &lt;= w.fallout then fallout[#fallout + 1] = i end
			end
		end)
		for o, count in pairs(hits) do
			local victim = ctx.Nations.get(o)
			if victim then
				local density = victim.troops / math.max(1, victim.land)
				victim.troops = math.max(0, victim.troops - density * count * w.troopKill)
				ctx.notify(o, w.icon .. " " .. w.name .. " atingiu seu território!", "war")
			end
		end
		for _, i in ipairs(fallout) do Territory.setOwner(i, 0) end
		for _, o in ipairs(ctx.Expansion.activeOrders()) do
			if o.front and o.nation ~= m.nation and Map:distance(o.front, m.to) &lt;= radius then
				o.troops = o.troops * (w.fallout and 0.2 or 0.5)
			end
		end
	elseif w.troopShare then
		local o = Territory.ownerOf(m.to)
		local victim = o &gt; 0 and ctx.Nations.get(o)
		if victim then victim.troops = victim.troops * (1 - w.troopShare) end
	end
	if w.disable then
		local o = Territory.ownerOf(m.to)
		if o &gt; 0 then ctx.notify(o, "⚡ EMP: construções desligadas por " .. w.disable .. " s.", "war") end
	end
	if w.fire then
		local o = Territory.ownerOf(m.to)
		if o &gt; 0 then ctx.notify(o, "🔥 Incêndio no seu território!", "war") end
	end
end

function StrategicService.tick(dt)
	if not ctx.Match.isPlaying() then return end
	local k = 1
	for i = 1, #missiles do
		local m = missiles[i]
		m.progress = m.progress + m.speed * dt
		if m.progress &gt;= m.distance then
			local stopped = intercepted(m)
			if stopped then
				ctx.notify(m.nation, "Seu ataque foi interceptado pela defesa antiaérea.", "bad")
			else
				impact(m)
			end
			ctx.emit(nil, { k = ctx.Protocol.Events.Impact, hit = { m.id, m.kind, m.to, stopped } })
		else
			missiles[k] = m
			k = k + 1
		end
	end
	for i = k, #missiles do missiles[i] = nil end
	-- fires spread slowly, burn troops every second and destroy structures they reach
	local now = ctx.now()
	k = 1
	for i = 1, #fires do
		local f = fires[i]
		f.radius = math.min(f.max, f.radius + f.grow * dt)
		f.pulse = f.pulse + dt
		if f.pulse &gt;= 1 then
			f.pulse = f.pulse - 1
			local hits = {}
			Map:disc(f.center, f.radius, function(c)
				local o = Territory.ownerOf(c)
				if o &gt; 0 and o ~= f.nation and not ctx.Diplomacy.allied(f.nation, o) then hits[o] = (hits[o] or 0) + 1 end
			end)
			for o, count in pairs(hits) do
				local victim = ctx.Nations.get(o)
				if victim then
					local density = victim.troops / math.max(1, victim.land)
					victim.troops = math.max(0, victim.troops - density * count * f.troopBurn)
				end
			end
			local burned = {}
			ctx.Buildings.near(f.center, f.radius, function(b)
				if b.owner ~= f.nation and not ctx.Diplomacy.allied(f.nation, b.owner) then burned[#burned + 1] = b.cell end
			end)
			for _, c in ipairs(burned) do ctx.Buildings.destroy(c) end
			for _, o in ipairs(ctx.Expansion.activeOrders()) do
				if o.front and o.nation ~= f.nation and Map:distance(o.front, f.center) &lt;= f.radius then
					o.troops = o.troops * (1 - f.troopBurn * 0.5)
				end
			end
		end
		if now &lt; f.endsAt then
			fires[k] = f
			k = k + 1
		end
	end
	for i = k, #fires do fires[i] = nil end
end

-- Fire rows for clients: { id, centerCell, radius }
function StrategicService.fireView()
	local out = {}
	for _, f in ipairs(fires) do out[#out + 1] = { f.id, f.center, math.floor(f.radius * 10) / 10 } end
	return out
end

function StrategicService.snapshot()
	local out = {}
	for _, m in ipairs(missiles) do
		out[#out + 1] = { m.id, m.kind, m.nation, m.from, m.to, m.speed, m.progress }
	end
	return out
end

return StrategicService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">TerritoryService</string><ProtectedString name="Source">-- Mundial War · authoritative ownership of every cell.
-- owner[i]: -1 water (never ownable), 0 neutral land, &gt;0 nation id.
-- Keeps per-nation owned/border sets so nothing ever scans the whole map per capture.
local TerritoryService = {}

local ctx, Map
local owner = {}
local ownedBy, border = {}, {}
local changes, changeCount = {}, 0
local recentClaims = {}       -- nid -&gt; list of recently claimed cells (enclave detection seeds)
local seen, stamp = {}, 0     -- reusable visit marks
local compMark, compStamp = {}, 0 -- component id per owned cell (0 = not analysed yet)
local nb, nbOuter = {}, {}
local borderChunks = {}       -- nid -&gt; chunk key -&gt; { cell = true } (spatial index of border cells)
local dirty = {}              -- nid -&gt; true when its territory changed since the last analysis
local CHUNK = 16

TerritoryService.owner = owner

function TerritoryService.init(context)
	ctx = context
	Map = ctx.Map
	TerritoryService.reset()
end

function TerritoryService.reset()
	for i = 1, Map.N do
		owner[i] = Map.land[i] and 0 or -1
		compMark[i] = 0
		seen[i] = 0
	end
	stamp, compStamp = 0, 0
	ownedBy, border, recentClaims, borderChunks, dirty = {}, {}, {}, {}, {}
	changes, changeCount = {}, 0
end

function TerritoryService.register(nid)
	ownedBy[nid] = {}
	border[nid] = {}
	recentClaims[nid] = {}
	borderChunks[nid] = {}
	dirty[nid] = true
end

function TerritoryService.unregister(nid)
	ownedBy[nid], border[nid], recentClaims[nid], borderChunks[nid], dirty[nid] = nil, nil, nil, nil, nil
end

local function chunkOf(i)
	local x = (i - 1) % Map.W
	local y = (i - 1 - x) / Map.W
	return math.floor(x / CHUNK) * 1000 + math.floor(y / CHUNK)
end

local function setBorder(id, i, on)
	local set = border[id]
	if not set or (set[i] == true) == on then return end
	local chunks = borderChunks[id]
	local key = chunkOf(i)
	if on then
		set[i] = true
		local c = chunks[key]
		if not c then c = {} chunks[key] = c end
		c[i] = true
	else
		set[i] = nil
		local c = chunks[key]
		if c then c[i] = nil end
	end
end

function TerritoryService.ownerOf(i)
	return owner[i]
end

function TerritoryService.owned(nid)
	return ownedBy[nid]
end

function TerritoryService.borderCells(nid)
	return border[nid]
end

local function refreshBorder(i)
	local id = owner[i]
	if id &lt;= 0 then return end
	if not border[id] then return end
	local n = Map:neighbors(i, nb)
	for k = 1, n do
		local o = owner[nb[k]]
		if o ~= -1 and o ~= id then
			setBorder(id, i, true)
			return
		end
	end
	setBorder(id, i, false)
end

-- The single place where ownership changes. Water is rejected here, so no code path
-- can ever give a nation a water cell.
function TerritoryService.setOwner(i, nid)
	local old = owner[i]
	if old == nid or old == -1 or old == nil then
		return false
	end
	local nations = ctx.Nations
	if old &gt; 0 then
		local set = ownedBy[old]
		if set then set[i] = nil end
		setBorder(old, i, false)
		dirty[old] = true
		local n = nations.get(old)
		if n then
			n.land = n.land - 1
			if n.capital == i then n.capitalLost = true end
		end
	end
	owner[i] = nid
	if nid &gt; 0 then
		ownedBy[nid][i] = true
		dirty[nid] = true
		local n = nations.get(nid)
		n.land = n.land + 1
		local recent = recentClaims[nid]
		if #recent &lt; 512 then recent[#recent + 1] = i end
	end
	compMark[i] = 0
	changes[i] = nid
	changeCount = changeCount + 1
	refreshBorder(i)
	local n = Map:neighbors(i, nbOuter)
	for k = 1, n do
		refreshBorder(nbOuter[k])
	end
	ctx.Buildings.onOwnerChanged(i, old, nid)
	return true
end

-- Cells owned by `target` (0 = neutral) that touch nation `nid`. Uses a stamp array so
-- duplicates are skipped without allocating a set.
function TerritoryService.frontier(nid, target, out)
	out = out or {}
	local count = 0
	stamp = stamp + 1
	local set = border[nid]
	if not set then return out, 0 end
	for i in pairs(set) do
		local n = Map:neighbors(i, nb)
		for k = 1, n do
			local j = nb[k]
			if owner[j] == target and seen[j] ~= stamp then
				seen[j] = stamp
				count = count + 1
				out[count] = j
			end
		end
	end
	for k = count + 1, #out do out[k] = nil end
	return out, count
end

-- Same as frontier, but only from border cells within `radius` of `center` (chunk index).
-- Expansion uses it so a huge empire does not rescan its whole border every tick.
function TerritoryService.frontierNear(nid, target, center, radius, out)
	out = out or {}
	local count = 0
	stamp = stamp + 1
	local chunks = borderChunks[nid]
	if not chunks then return out, 0 end
	local W = Map.W
	local cx = (center - 1) % W
	local cy = (center - 1 - cx) / W
	local r2 = radius * radius
	for kx = math.floor((cx - radius) / CHUNK), math.floor((cx + radius) / CHUNK) do
		for ky = math.floor((cy - radius) / CHUNK), math.floor((cy + radius) / CHUNK) do
			local set = chunks[kx * 1000 + ky]
			if set then
				for i in pairs(set) do
					local x = (i - 1) % W
					local y = (i - 1 - x) / W
					if (x - cx) * (x - cx) + (y - cy) * (y - cy) &lt;= r2 then
						local n = Map:neighbors(i, nb)
						for k = 1, n do
							local j = nb[k]
							if owner[j] == target and seen[j] ~= stamp then
								seen[j] = stamp
								count = count + 1
								out[count] = j
							end
						end
					end
				end
			end
		end
	end
	for k = count + 1, #out do out[k] = nil end
	return out, count
end

function TerritoryService.touches(nid, target)
	local set = border[nid]
	if not set then return false end
	for i in pairs(set) do
		local n = Map:neighbors(i, nb)
		for k = 1, n do
			if owner[nb[k]] == target then return true end
		end
	end
	return false
end

-- True when `cell` connects to nation `nid` through cells owned by `target` (the same
-- owner as `cell`): the order has a real land route instead of jumping over someone else.
-- Bounded flood fill from the clicked cell; very large regions are accepted as connected.
function TerritoryService.reachable(nid, cell, limit)
	local target = owner[cell]
	if target == nil or target == -1 or target == nid then return false end
	stamp = stamp + 1
	local queue, head = { cell }, 1
	seen[cell] = stamp
	local nb2 = {}
	while head &lt;= #queue do
		local i = queue[head]
		head = head + 1
		local n = Map:neighbors(i, nb2)
		for k = 1, n do
			local j = nb2[k]
			local o = owner[j]
			if o == nid then return true end
			if o == target and seen[j] ~= stamp then
				seen[j] = stamp
				queue[#queue + 1] = j
			end
		end
		if #queue &gt; limit then return true end
	end
	return false
end

-- Owners (other than nid, neutral or water) that share a land border with nid.
function TerritoryService.neighborsOf(nid)
	local result = {}
	local set = border[nid]
	if not set then return result end
	for i in pairs(set) do
		local n = Map:neighbors(i, nb)
		for k = 1, n do
			local o = owner[nb[k]]
			if o &gt; 0 and o ~= nid then result[o] = (result[o] or 0) + 1 end
		end
	end
	return result
end

function TerritoryService.ownNeighborCount(i, nid)
	local n = Map:neighbors(i, nb)
	local c = 0
	for k = 1, n do
		if owner[nb[k]] == nid then c = c + 1 end
	end
	return c
end

-- Annexes neutral pockets fully enclosed by a single nation (and water). Keeps territory
-- solid: expansion never leaves holes behind.
function TerritoryService.fillEnclaves(nid)
	local recent = recentClaims[nid]
	if not recent or #recent == 0 then return 0 end
	recentClaims[nid] = {}
	local limit = ctx.Config.Expansion.EnclaveMaxCells
	local annexed = 0
	local nb2 = {}
	for _, c in ipairs(recent) do
		local n = Map:neighbors(c, nb2)
		local seeds = { nb2[1], nb2[2], nb2[3], nb2[4] }
		for k = 1, n do
			local s = seeds[k]
			if owner[s] == 0 then
				stamp = stamp + 1
				local region, queue, head, enclosed = {}, { s }, 1, true
				seen[s] = stamp
				while head &lt;= #queue do
					local i = queue[head]
					head = head + 1
					region[#region + 1] = i
					if #region &gt; limit then enclosed = false break end
					local m = Map:neighbors(i, nb)
					if m &lt; 4 then enclosed = false break end   -- map edge: not enclosed
					for q = 1, m do
						local j = nb[q]
						local o = owner[j]
						if o == 0 then
							if seen[j] ~= stamp then
								seen[j] = stamp
								queue[#queue + 1] = j
							end
						elseif o ~= nid and o ~= -1 then
							enclosed = false
							break
						end
					end
					if not enclosed then break end
				end
				if enclosed then
					for _, i in ipairs(region) do
						TerritoryService.setOwner(i, nid)
						annexed = annexed + 1
					end
				end
			end
		end
	end
	recentClaims[nid] = {}
	return annexed
end

-- Connected components of one nation: label anchor (centroid of the largest block),
-- block size, and which block holds the capital (anything else is an exclave).
function TerritoryService.analyze(nid)
	local n = ctx.Nations.get(nid)
	local set = ownedBy[nid]
	if not n or not set then return end
	-- unchanged territory keeps its label and exclave map
	if not dirty[nid] and not n.capitalLost then return end
	dirty[nid] = nil
	local W = Map.W
	local bestSize, bestCell, capComp = 0, nil, nil
	local largestComp = nil
	local passStart = compStamp + 1
	for start in pairs(set) do
		if compMark[start] &lt; passStart then
			compStamp = compStamp + 1
			local id = compStamp
			local queue, head, sx, sy = { start }, 1, 0, 0
			compMark[start] = id
			while head &lt;= #queue do
				local i = queue[head]
				head = head + 1
				local x = (i - 1) % W
				sx = sx + x
				sy = sy + (i - 1 - x) / W
				local m = Map:neighbors(i, nb)
				for q = 1, m do
					local j = nb[q]
					if owner[j] == nid and compMark[j] ~= id then
						compMark[j] = id
						queue[#queue + 1] = j
					end
				end
			end
			if compMark[n.capital] == id then capComp = id end
			if #queue &gt; bestSize then
				bestSize = #queue
				largestComp = id
				local cx, cy = sx / #queue, sy / #queue
				local bestD = math.huge
				for _, i in ipairs(queue) do
					local x = (i - 1) % W
					local y = (i - 1 - x) / W
					local d = (x - cx) * (x - cx) + (y - cy) * (y - cy)
					if d &lt; bestD then bestD, bestCell = d, i end
				end
			end
		end
	end
	if bestCell then
		n.labelCell, n.labelSize = bestCell, bestSize
		if n.capitalLost or owner[n.capital] ~= nid then
			n.capital = bestCell
			n.capitalLost = false
			capComp = largestComp
		end
		n.mainComp = capComp or largestComp
	end
end

-- True when the cell's nation reaches it over land from its capital (stale marks count as connected).
function TerritoryService.isMainland(nid, i)
	local n = ctx.Nations.get(nid)
	if not n or not n.mainComp then return true end
	local m = compMark[i]
	if m == 0 then return true end   -- claimed after the last analysis: assume connected
	return m == n.mainComp
end

function TerritoryService.releaseAll(nid)
	local set = ownedBy[nid]
	if not set then return end
	local list = {}
	for i in pairs(set) do list[#list + 1] = i end
	for _, i in ipairs(list) do
		TerritoryService.setOwner(i, 0)
	end
end

function TerritoryService.drainChanges()
	if changeCount == 0 then return nil end
	local flat, k = {}, 0
	for i, o in pairs(changes) do
		flat[k + 1] = i
		flat[k + 2] = o
		k = k + 2
	end
	changes, changeCount = {}, 0
	return flat
end

function TerritoryService.snapshotRuns()
	return ctx.Protocol.encodeRuns(owner, Map.N)
end

function TerritoryService.landShare(nid)
	local n = ctx.Nations.get(nid)
	return n and n.land / Map.landCount or 0
end

return TerritoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">World</string><ProtectedString name="Source">-- Mundial War · wires the services together and runs the fixed-step scheduler.
-- Pure Lua: init.server.lua feeds it Roblox time and players; tests feed it a fake clock.
local World = {}
World.__index = World

local SERVICE_ORDER = {
	"Territory", "Nations", "Economy", "Combat", "Buildings", "Expansion", "Naval",
	"Strategic", "Diplomacy", "Bots", "Match", "Commands",
}

-- deps: { Config, MapData, MapGrid, Palette, Protocol, Services = { Territory = module, ... }, random }
function World.new(deps)
	local self = setmetatable({}, World)
	local ctx = {
		Config = deps.Config, Palette = deps.Palette, Protocol = deps.Protocol,
		Map = deps.Map or deps.MapGrid.new(deps.MapData),
		Stats = deps.BuildingStats,
		random = deps.random or math.random,
		outbox = {},
		fullResync = false,
		mode = deps.mode,
	}
	self.time = 0
	ctx.now = function() return self.time end
	ctx.Landmass = deps.Landmass or ctx.Map:landmasses()
	-- emit(nil, payload) broadcasts; emit(nationId, payload) targets that nation's player
	ctx.emit = function(to, payload)
		ctx.outbox[#ctx.outbox + 1] = { to = to, payload = payload }
	end
	ctx.notify = function(to, text, kind)
		ctx.emit(to, { k = ctx.Protocol.Events.Notice, text = text, kind = kind or "info" })
	end
	ctx.Territory = deps.Services.Territory
	ctx.Nations = deps.Services.Nations
	ctx.Economy = deps.Services.Economy
	ctx.Combat = deps.Services.Combat
	ctx.Buildings = deps.Services.Buildings
	ctx.Expansion = deps.Services.Expansion
	ctx.Naval = deps.Services.Naval
	ctx.Strategic = deps.Services.Strategic
	ctx.Diplomacy = deps.Services.Diplomacy
	ctx.Bots = deps.Services.Bots
	ctx.Match = deps.Services.Match
	ctx.Commands = deps.Services.Commands
	for _, name in ipairs(SERVICE_ORDER) do
		ctx[name].init(ctx)
	end
	for _, name in ipairs({ "Nations", "Buildings", "Expansion", "Naval", "Strategic", "Diplomacy", "Combat", "Bots" }) do
		ctx[name].reset()
	end
	self.ctx = ctx
	self.timers = { sim = 0, econ = 0, comp = 0, encl = 0 }
	self.enclaveQueue, self.analyzeQueue = {}, {}
	self.stats = { simTime = 0, simCount = 0, worst = 0 }
	return self
end

-- Advances the world by dt seconds. `clock` (optional) measures CPU time for stats.
function World:step(dt, humanCount, clock)
	local ctx, T = self.ctx, self.ctx.Config.Tick
	self.time = self.time + dt
	ctx.Match.tick(humanCount or 0)
	local t = self.timers
	t.sim = t.sim + dt
	t.econ = t.econ + dt
	t.comp = t.comp + dt
	t.encl = t.encl + dt
	local started = clock and clock()
	while t.sim &gt;= T.Simulation do
		t.sim = t.sim - T.Simulation
		ctx.Expansion.tick(T.Simulation)
		ctx.Combat.tick(T.Simulation)
		ctx.Naval.tick(T.Simulation)
		ctx.Strategic.tick(T.Simulation)
		ctx.Buildings.tick()
		ctx.Bots.tick()
	end
	if t.econ &gt;= T.Economy then
		ctx.Economy.tick(t.econ)
		ctx.Diplomacy.tick()
		t.econ = 0
	end
	-- territory analysis is spread over several steps (a few nations per step) so a world
	-- with dozens of empires never produces a long single frame
	if t.encl &gt;= T.EnclaveFill then
		t.encl = 0
		if ctx.Match.isPlaying() then
			for id, n in pairs(ctx.Nations.all()) do
				if n.alive then self.enclaveQueue[#self.enclaveQueue + 1] = id end
			end
		end
	end
	if t.comp &gt;= T.Components then
		t.comp = 0
		for id, n in pairs(ctx.Nations.all()) do
			if n.alive then self.analyzeQueue[#self.analyzeQueue + 1] = id end
		end
	end
	for _ = 1, 3 do
		local id = table.remove(self.enclaveQueue)
		if not id then break end
		if ctx.Nations.alive(id) then ctx.Territory.fillEnclaves(id) end
	end
	for _ = 1, 3 do
		local id = table.remove(self.analyzeQueue)
		if not id then break end
		if ctx.Nations.alive(id) then ctx.Territory.analyze(id) end
	end
	if started then
		local spent = clock() - started
		self.stats.simTime = self.stats.simTime + spent
		self.stats.simCount = self.stats.simCount + 1
		if spent &gt; self.stats.worst then self.stats.worst = spent end
	end
end

function World:drainOutbox()
	local out = self.ctx.outbox
	self.ctx.outbox = {}
	return out
end

-- Everything a client needs when it joins (or after a new round).
function World:initPayload(userId)
	local ctx = self.ctx
	local nations = {}
	for _, n in pairs(ctx.Nations.all()) do
		if n.alive then nations[#nations + 1] = ctx.Nations.publicInfo(n) end
	end
	local you = ctx.Nations.forUser(userId)
	local fleets, boats = ctx.Naval.snapshot()
	return {
		k = ctx.Protocol.Events.Init,
		owners = ctx.Territory.snapshotRuns(),
		nations = nations,
		buildings = ctx.Buildings.snapshot(),
		relations = ctx.Diplomacy.snapshot(),
		fleets = fleets, boats = boats,
		missiles = ctx.Strategic.snapshot(),
		fires = ctx.Strategic.fireView(),
		cargos = ctx.Naval.cargoView(),
		match = ctx.Match.publicView(),
		you = you and you.alive and you.id or nil,
		debug = ctx.Config.DEBUG_MODE,
	}
end

-- Frequent public payload: territory delta + building changes (batched).
function World:deltaPayload()
	local ctx = self.ctx
	local cells = ctx.Territory.drainChanges()
	local builds = ctx.Buildings.drainChanges()
	if not cells and not builds then return nil end
	return { k = ctx.Protocol.Events.Tick, d = cells, b = builds }
end

-- Per-nation public numbers: { id, troops, land, labelCell, labelSize, capital }
function World:nationsPayload()
	local ctx = self.ctx
	local list = {}
	for _, n in pairs(ctx.Nations.all()) do
		if n.alive then
			list[#list + 1] = { n.id, math.floor(n.troops), n.land, n.labelCell or n.capital, n.labelSize or 1, n.capital }
		end
	end
	return { k = ctx.Protocol.Events.Nations, list = list, match = ctx.Match.publicView() }
end

function World:ordersPayload()
	local ctx = self.ctx
	local payload = {
		k = ctx.Protocol.Events.Orders,
		orders = ctx.Expansion.publicView(),
		fleets = ctx.Naval.publicView(),
		boats = ctx.Naval.boatView(),
		cargos = ctx.Naval.cargoView(),
		fires = ctx.Strategic.fireView(),
	}
	if ctx.Config.DEBUG_MODE then payload.bots = ctx.Bots.debugView() end
	return payload
end

-- Private numbers for one player's HUD.
function World:privatePayload(userId)
	local ctx = self.ctx
	local n = ctx.Nations.forUser(userId)
	if not n or not n.alive then return nil end
	local costs = {}
	for kind in pairs(ctx.Config.Buildings) do costs[kind] = ctx.Buildings.cost(n.id, kind) end
	local cooldowns = {}
	for _, kind in ipairs({ "silo", "airfield" }) do
		local best = nil
		for _, b in ipairs(ctx.Buildings.ofKind(n.id, kind)) do
			local left = math.max(0, b.readyAt - ctx.now())
			if not best or left &lt; best then best = left end
		end
		cooldowns[kind] = best
	end
	return {
		k = "me", id = n.id, troops = math.floor(n.troops), max = math.floor(n.maxTroops),
		rate = n.troopRate, gold = math.floor(n.gold), goldRate = n.goldRate, land = n.land,
		oil = math.floor(n.oil or 0), oilRate = n.oilRate or 0, mode = ctx.mode,
		share = n.land / ctx.Map.landCount, costs = costs, cooldowns = cooldowns,
		requests = ctx.Diplomacy.pendingFor(n.id),
	}
end

return World
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000001B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000001C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000001D"><Properties><string name="Name">MundialWar</string><ProtectedString name="Source">-- Mundial War · client bootstrap: full-screen strategic map, HUD, input and replication.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("MundialWarShared")
local Config = require(Shared.GameConfig)
local Protocol = require(Shared.Protocol)
local Palette = require(Shared.Palette)
local MapGrid = require(Shared.MapGrid)
local BuildingStats = require(Shared.BuildingStats)

local ClientState = require(script.ClientState)
local MapRenderer = require(script.MapRenderer)
local CameraController = require(script.CameraController)
local OverlayRenderer = require(script.OverlayRenderer)
local InputController = require(script.InputController)
local HUD = require(script.HUD)
local DebugOverlay = require(script.DebugOverlay)

local player = Players.LocalPlayer
local Events, Actions = Protocol.Events, Protocol.Actions

-- The avatar is identity only: no character, no 3D camera, no default HUD clutter.
task.spawn(function()
	-- core scripts may not be ready on the first frames; retry briefly
	for _ = 1, 10 do
		local ok = pcall(function()
			for _, kind in ipairs({ Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu }) do
				StarterGui:SetCoreGuiEnabled(kind, false)
			end
		end)
		if ok then break end
		task.wait(0.5)
	end
end)
local camera3d = workspace.CurrentCamera
camera3d.CameraType = Enum.CameraType.Scriptable
camera3d.CFrame = CFrame.new(0, 10000, 0) * CFrame.Angles(math.rad(90), 0, 0)

local remotes = ReplicatedStorage:WaitForChild("MundialWarRemotes")
local commandRemote = remotes:WaitForChild(Protocol.CommandRemote)
local eventRemote = remotes:WaitForChild(Protocol.EventRemote)

local Map = MapGrid.new(require(Shared.MapData))
local state = ClientState.new(Map, Protocol, Config, Palette, BuildingStats)

-- Screen layout: the ocean-coloured viewport is the whole screen; the world frame moves inside it.
local gui = Instance.new("ScreenGui")
gui.Name = "MundialWar"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local viewport = Instance.new("Frame")
viewport.Name = "Viewport"
viewport.Size = UDim2.fromScale(1, 1)
viewport.BackgroundColor3 = Color3.fromRGB(Palette.Water[1], Palette.Water[2], Palette.Water[3])
viewport.BorderSizePixel = 0
viewport.ClipsDescendants = true
viewport.Parent = gui

local world = Instance.new("Frame")
world.Name = "World"
world.BackgroundTransparency = 1
world.Parent = viewport

local camera = CameraController.new(viewport, world, Map, Config)
local renderer = MapRenderer.new(state, world)
local overlay = OverlayRenderer.new(state, camera, world)
local debugOverlay = nil

local function send(action, a, b, c)
	commandRemote:FireServer(action, a, b, c)
end

-- Interaction state ------------------------------------------------------------------------
local mode = nil          -- nil | "build" | "weapon" | "patrol"
local buildKind = nil     -- building kind (build mode) or weapon kind (weapon mode)
local patrolBoat = nil    -- boat id while choosing where it patrols
local selectedCell = nil  -- own building whose reach is being shown
local pending = nil       -- { cell, at, kind }
local hud
local myVote = nil

local function clearAim()
	pending = nil
	overlay:setAim(nil, nil)
end

local updateRanges
local function setMode(newMode, kind)
	mode, buildKind = newMode, kind
	if mode ~= "patrol" then patrolBoat = nil end
	clearAim()
	selectedCell = nil
	hud:showTray(mode == "build", mode == "build" and buildKind or nil)
	hud:showWeapons(mode == "weapon", mode == "weapon" and buildKind or nil)
	hud.tools.build.BackgroundColor3 = mode == "build" and Color3.fromRGB(92, 74, 30) or Color3.fromRGB(34, 44, 58)
	hud.tools.weapons.BackgroundColor3 = mode == "weapon" and Color3.fromRGB(120, 48, 44) or Color3.fromRGB(34, 44, 58)
	updateRanges(nil)
end

-- Reach circles: where the chosen building/bomb would act, plus our existing defences.
local hoverCell = nil
updateRanges = function(cell)
	if cell ~= nil then hoverCell = cell end
	local list = {}
	local gold, red, blue = Color3.fromRGB(240, 196, 92), Color3.fromRGB(235, 90, 80), Color3.fromRGB(120, 200, 255)
	if mode == "build" then
		for c, b in pairs(state.buildings) do
			if b.owner == state.you and Config.Buildings[b.kind].defensive then
				list[#list + 1] = { c, BuildingStats.reach(Config, b.kind, b.level), blue }
			end
		end
		local r = buildKind and BuildingStats.reach(Config, buildKind, 1)
		if r and hoverCell and Map.land[hoverCell] then list[#list + 1] = { hoverCell, r, gold } end
	elseif mode == "weapon" and buildKind then
		local w = Config.Weapons[buildKind]
		if w.launcher == "airfield" then
			for c, b in pairs(state.buildings) do
				if b.owner == state.you and b.kind == "airfield" then list[#list + 1] = { c, BuildingStats.reach(Config, "airfield", b.level), blue } end
			end
		end
		if hoverCell then list[#list + 1] = { hoverCell, w.radius, red } end
	elseif selectedCell and state.buildings[selectedCell] then
		local b = state.buildings[selectedCell]
		local r = BuildingStats.reach(Config, b.kind, b.level)
		if r then list[#list + 1] = { selectedCell, r, gold } end
	end
	overlay:setRanges(list)
end

local function nationName(id)
	local n = state.nations[id]
	return n and n.name or "?"
end

local function troopsToSend()
	local me = state.me
	return me and math.floor(me.troops * state.percent) or 0
end

local function relationText(rel)
	return ({ ally = "🤝 Aliado", war = "⚔ Em guerra", neutral = "Neutro" })[rel] or rel
end

local function nationPopover(screenPos, id)
	local n = state.nations[id]
	if not n or id == state.you then return end
	local rel = state:relation(state.you, id)
	local body = string.format("👥 %s · %.1f%% do mundo\n%s", Protocol.formatK(n.troops), n.land / Map.landCount * 100, relationText(rel))
	local buttons = {}
	if state.you then
		if rel == "ally" then
			buttons[#buttons + 1] = { "Cancelar aliança", function() send(Actions.BreakAlliance, id) end, true }
		else
			buttons[#buttons + 1] = { "🤝 Aliança", function() send(Actions.Ally, id) end }
			if rel ~= "war" then
				buttons[#buttons + 1] = { "⚔ Guerra", function() send(Actions.War, id) end, true }
			end
		end
	end
	hud:showPopover(screenPos, n.name, body, buttons)
end

local function aimOrder(cell)
	local o = state.owner[cell]
	local rel = o &gt; 0 and state:relation(state.you, o) or "neutral"
	local origin = state:nearestBorder(state.you, cell)
	local color = Color3.fromRGB(255, 255, 255)
	local text
	if rel == "ally" then
		text = "Aliado: cancele a aliança para atacar"
		color = Color3.fromRGB(120, 200, 255)
	elseif o == 0 then
		text = "Clique de novo: expandir com " .. Protocol.formatK(troopsToSend())
	else
		text = "Clique de novo: atacar " .. nationName(o) .. " com " .. Protocol.formatK(troopsToSend())
		color = Color3.fromRGB(255, 140, 110)
	end
	overlay:setAim(origin, cell, text, color)
end

local function handleClick(p, button)
	hud:hidePopover()
	if not mode and selectedCell then
		selectedCell = nil
		updateRanges(nil)
	end
	local cell = camera:screenToCell(p)
	if not cell then return end
	local owner = state.owner[cell]
	local phase = state.match.phase

	if button == 2 then
		if owner &gt; 0 then nationPopover(p, owner) end
		return
	end
	if not state.you then
		if phase == "spawn" or phase == "playing" then
			if owner == -1 then hud:toast("Escolha uma célula de terra.", "bad") return end
			send(Actions.Spawn, cell)
		else
			hud:toast("Aguardando a próxima rodada.")
		end
		return
	end

	if mode == "build" then
		if buildKind then send(Actions.Build, cell, buildKind) else hud:toast("Escolha uma construção na lista.") end
		return
	elseif mode == "patrol" then
		if Map.land[cell] then hud:toast("Escolha um ponto na água para o barco patrulhar.", "bad") return end
		send(Actions.Patrol, patrolBoat, cell)
		setMode(nil)
		return
	elseif mode == "weapon" then
		if not buildKind then hud:toast("Escolha uma arma na lista.") return end
		local w = Config.Weapons[buildKind]
		local now = os.clock()
		if pending and pending.kind == "weapon" and Map:distance(pending.cell, cell) &lt;= Config.View.ConfirmRadius
			and now - pending.at &lt;= Config.View.ConfirmTimeout then
			send(Actions.Weapon, pending.cell, buildKind, state.percent)
			setMode(nil)
			return
		end
		pending = { cell = cell, at = now, kind = "weapon" }
		overlay:setAim(nil, cell, string.format("Clique de novo para lançar %s %s · 💰 %s", w.icon, w.name, Protocol.formatK(w.gold)), Color3.fromRGB(255, 90, 80))
		return
	end

	-- clicking one of our boats selects it; the next click on water sets its patrol
	local mx, my = camera:screenToMap(p)
	local boat = state:boatNear(state.you, mx, my, math.max(1.5, 12 / camera.scale))
	if boat then
		setMode("patrol")
		patrolBoat = boat[1]
		hud:toast("Barco selecionado: clique na água onde ele deve patrulhar.")
		return
	end

	if owner == state.you then
		clearAim()
		local b = state.buildings[cell]
		if b then
			local def = Config.Buildings[b.kind]
			local body = def.purpose .. "\n" .. table.concat(BuildingStats.lines(Config, b.kind, b.level), " · ")
			if b.off then body = "⚡ Desligada por EMP.\n" .. body end
			local buttons = {}
			local cost = BuildingStats.upgradeCost(Config, b.kind, b.level)
			if cost then
				body = body .. "\nNível " .. (b.level + 1) .. ": " .. table.concat(BuildingStats.lines(Config, b.kind, b.level + 1), " · ")
				buttons[#buttons + 1] = { "⬆ Melhorar · 💰 " .. Protocol.formatK(cost), function() send(Actions.Upgrade, cell) end }
			end
			if b.kind == "port" then
				buttons[#buttons + 1] = { "🚢 Barco · 💰 " .. Protocol.formatK(Config.Naval.BoatGold), function() send(Actions.Warship, cell) end }
			end
			hud:showPopover(p, def.icon .. " " .. def.name .. " · Nível " .. b.level, body, buttons)
			selectedCell = cell
			updateRanges(nil)
		end
		return
	end
	if owner == -1 then
		clearAim()
		hud:toast("Água não pode ser conquistada. Clique numa costa para invadir com um porto.")
		return
	end

	local now = os.clock()
	if not Config.View.TwoClickConfirm or (pending and pending.kind == "order"
		and Map:distance(pending.cell, cell) &lt;= Config.View.ConfirmRadius and now - pending.at &lt;= Config.View.ConfirmTimeout) then
		local target = pending and pending.cell or cell
		clearAim()
		send(Actions.Target, target, state.percent)
		return
	end
	pending = { cell = cell, at = now, kind = "order" }
	aimOrder(cell)
	if owner &gt; 0 then nationPopover(p, owner) end
end

local function handleKey(key)
	local K = Enum.KeyCode
	if key == K.Escape then
		setMode(nil)
		hud:hidePopover()
	elseif key == K.Home or key == K.F then
		camera:fit()
	elseif key == K.B then
		setMode(mode ~= "build" and "build" or nil)
	elseif key == K.Space and state.you and state.nations[state.you] then
		camera:focusCell(state.nations[state.you].capital, math.max(camera.scale, camera:minScale() * 3))
	else
		local numbers = { K.One, K.Two, K.Three, K.Four, K.Five }
		for index, k in ipairs(numbers) do
			if key == k and Config.TroopPercents[index] then
				state.percent = Config.TroopPercents[index]
				hud:setPercent(state.percent)
				if pending and pending.kind == "order" then aimOrder(pending.cell) end
			end
		end
	end
end

local helpText = table.concat({
	"&lt;b&gt;Objetivo:&lt;/b&gt; dominar " .. math.floor(Config.Match.VictoryPercent * 100) .. "% das terras do mundo.",
	"&lt;b&gt;Começar:&lt;/b&gt; clique numa terra livre para fundar sua capital.",
	"&lt;b&gt;Expandir/atacar:&lt;/b&gt; escolha o % de tropas e clique no destino. A fronteira avança sozinha.",
	"&lt;b&gt;Construções:&lt;/b&gt; 🏗 mostra para que serve cada uma e o alcance no mapa. Clique numa construção sua para melhorar o nível.",
	"&lt;b&gt;Mar:&lt;/b&gt; construa um porto e clique numa costa do outro lado. No porto, compre barcos de defesa; clique num barco e depois na água para escolher a patrulha.",
	"&lt;b&gt;Bombas:&lt;/b&gt; 💣 aparece quando você tem base aérea ou silo. Clique no alvo e confirme com um segundo clique.",
	"&lt;b&gt;Câmera:&lt;/b&gt; arraste para mover, roda do mouse/pinça para zoom, WASD, F para ver o mundo, Espaço para sua capital.",
	"&lt;b&gt;Atalhos:&lt;/b&gt; 1–5 percentual, B construir, Esc cancelar, botão direito numa nação para diplomacia.",
}, "\n")

hud = HUD.new(state, gui, {
	onPercent = function(p)
		state.percent = p
		hud:setPercent(p)
		if pending and pending.kind == "order" then aimOrder(pending.cell) end
	end,
	onCancel = function() send(Actions.Cancel, nil) end,
	onTool = function(name)
		if name == "build" then setMode(mode ~= "build" and "build" or nil)
		elseif name == "weapons" then
			setMode(mode ~= "weapon" and "weapon" or nil)
		elseif name == "ranking" then hud:toggleRanking()
		elseif name == "fit" then camera:fit()
		elseif name == "help" then hud:showCenter("Mundial War", helpText, true) end
	end,
	onBuild = function(kind)
		if buildKind == kind then setMode("build", nil) else setMode("build", kind) end
	end,
	onVote = function(mode)
		myVote = mode
		send(Actions.Vote, mode)
		hud:refreshMenu(myVote)
	end,
	onWeapon = function(kind)
		if buildKind == kind then setMode("weapon", nil) else setMode("weapon", kind) end
	end,
})

InputController.new(camera, Config, {
	onClick = handleClick,
	onKey = handleKey,
	onHover = function(p)
		if debugOverlay then debugOverlay:hover(p) end
		if mode == "build" or mode == "weapon" then updateRanges(camera:screenToCell(p)) end
	end,
})

-- Banner: phase, countdown and the active mode, refreshed four times per second.
task.spawn(function()
	while gui.Parent do
		local phase = state.match.phase
		local text
		if mode == "build" then
			text = buildKind and ("🏗 " .. Config.Buildings[buildKind].name .. " — clique numa célula sua · Esc sai") or "🏗 Escolha uma construção"
		elseif mode == "weapon" then
			text = buildKind and (Config.Weapons[buildKind].icon .. " Escolha o alvo · Esc cancela") or "💣 Escolha uma arma"
		elseif mode == "patrol" then
			text = "🚢 Clique na água onde o barco deve patrulhar · Esc cancela"
		elseif phase == "spawn" then
			local left = math.ceil(state:timeLeft())
			if state.match.mode == "extreme" then
				text = state.you and ("A guerra começa em " .. left .. "s") or ("🔥 Clique num país para governá-lo · " .. left .. "s")
			else
				text = state.you and ("A guerra começa em " .. left .. "s") or ("Clique numa terra livre para fundar sua nação · " .. left .. "s")
			end
		elseif phase == "playing" and not state.you then
			text = state.match.mode == "extreme" and "🔥 Clique num país controlado pela IA para governá-lo"
				or "Clique numa terra livre para fundar uma nova nação"
		elseif phase == "vote" then
			text = nil
		elseif phase == "waiting" then
			text = "Preparando o mundo…"
		end
		hud:setBanner(text)
		hud:refreshMenu(myVote)
		task.wait(0.25)
	end
end)

-- Replication ------------------------------------------------------------------------------
local firstInit = true
local lastPhase, lastRound = nil, nil

local function onMatch(match)
	if match.phase == "ended" and match.winner and lastPhase ~= "ended" then
		local w = match.winner
		local mine = w.id == state.you
		hud:showCenter(mine and "VITÓRIA!" or "FIM DA PARTIDA",
			string.format("&lt;b&gt;%s&lt;/b&gt; conquistou %.1f%% do mundo.\nNova rodada em instantes.", w.name, w.share * 100), false)
	elseif match.phase ~= "ended" and lastPhase == "ended" then
		hud:hideCenter()
	end
	if lastRound and match.round ~= lastRound then
		clearAim()
		setMode(nil)
		myVote = nil
	end
	lastPhase, lastRound = match.phase, match.round
end

eventRemote.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then return end
	local k = data.k
	if k == Events.Init then
		state:applyInit(data)
		onMatch(data.match)
		if firstInit then
			firstInit = false
			camera:fit()
			if data.debug and not debugOverlay then debugOverlay = DebugOverlay.new(state, camera, gui, world) end
		end
		hud:refreshRanking()
		hud:refreshMe()
	elseif k == Events.Tick then
		state:applyDelta(data)
	elseif k == Events.Nations then
		state:applyNations(data)
		if data.match then onMatch(data.match) end
		hud:refreshRanking()
	elseif k == Events.Orders then
		state:applyOrders(data)
	elseif k == Events.Notice then
		hud:toast(data.text, data.kind)
	elseif k == Events.Diplomacy then
		state:applyDiplomacy(data)
		if data.request then
			local from = data.request
			hud:allianceRequest(from, data.expires,
				function() send(Actions.Ally, from) end,
				function() send(Actions.Decline, from) end)
		end
	elseif k == Events.Match then
		state.match = { phase = data.phase, round = data.round, left = data.left, winner = data.winner, mode = data.mode, votes = data.votes }
		state.matchAt = os.clock()
		onMatch(state.match)
	elseif k == Events.Impact then
		state:applyImpact(data)
	elseif k == "me" then
		state:applyMe(data)
		hud:refreshMe()
	end
end)

state:on("nationList", function()
	hud:refreshRanking()
	if not state.you then hud:refreshMe() end
end)

send(Actions.Sync)
</ProtectedString><token name="RunContext">0</token></Properties><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">CameraController</string><ProtectedString name="Source">-- Mundial War · strategy camera over the 2D map: pan, zoom toward the cursor, bounds.
-- The map frame is moved/resized; nothing in the 3D world is involved.
local CameraController = {}
CameraController.__index = CameraController

function CameraController.new(viewport, world, Map, Config)
	local self = setmetatable({}, CameraController)
	self.viewport = viewport      -- full-screen clipping frame
	self.world = world            -- frame sized W*scale x H*scale holding map + overlays
	self.Map = Map
	self.Config = Config
	self.scale = 1
	self.cx, self.cy = Map.W / 2, Map.H / 2
	self.listeners = {}
	viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local wasFit = self.scale &lt;= self:minScale() + 1e-3
		if wasFit then self:fit() else self:apply() end
	end)
	return self
end

function CameraController:onChanged(fn)
	table.insert(self.listeners, fn)
end

function CameraController:minScale()
	local size = self.viewport.AbsoluteSize
	if size.X &lt;= 0 or size.Y &lt;= 0 then return 1 end
	-- whole world visible; the ocean-coloured viewport fills any remaining margin
	return math.min(size.X / self.Map.W, size.Y / self.Map.H)
end

function CameraController:maxScale()
	return math.max(self:minScale() * 2, self.Config.View.MaxPixelsPerCell)
end

local function clamp(v, lo, hi)
	if v &lt; lo then return lo end
	if v &gt; hi then return hi end
	return v
end

-- Keeps the map covering the viewport: no scrolling into empty space.
function CameraController:clampCenter()
	local size = self.viewport.AbsoluteSize
	local halfW, halfH = size.X / (2 * self.scale), size.Y / (2 * self.scale)
	if halfW * 2 &gt;= self.Map.W then
		self.cx = self.Map.W / 2
	else
		self.cx = clamp(self.cx, halfW, self.Map.W - halfW)
	end
	if halfH * 2 &gt;= self.Map.H then
		self.cy = self.Map.H / 2
	else
		self.cy = clamp(self.cy, halfH, self.Map.H - halfH)
	end
end

function CameraController:apply()
	self.scale = clamp(self.scale, self:minScale(), self:maxScale())
	self:clampCenter()
	local size = self.viewport.AbsoluteSize
	local s = self.scale
	self.world.Size = UDim2.fromOffset(self.Map.W * s, self.Map.H * s)
	self.world.Position = UDim2.fromOffset(size.X / 2 - self.cx * s, size.Y / 2 - self.cy * s)
	for _, fn in ipairs(self.listeners) do fn(s) end
end

function CameraController:fit()
	self.scale = self:minScale()
	self.cx, self.cy = self.Map.W / 2, self.Map.H / 2
	self:apply()
end

-- Screen position (same space as GuiObject.AbsolutePosition) -&gt; fractional cell coordinates.
function CameraController:screenToMap(p)
	local origin = self.world.AbsolutePosition
	return (p.X - origin.X) / self.scale, (p.Y - origin.Y) / self.scale
end

function CameraController:screenToCell(p)
	local x, y = self:screenToMap(p)
	return self.Map:index(math.floor(x), math.floor(y))
end

function CameraController:zoomAt(p, factor)
	local before = self.scale
	local mx, my = self:screenToMap(p)
	self.scale = clamp(self.scale * factor, self:minScale(), self:maxScale())
	if self.scale == before then return end
	-- keep the map point under the cursor fixed
	local origin = self.viewport.AbsolutePosition
	local size = self.viewport.AbsoluteSize
	local sx, sy = p.X - origin.X, p.Y - origin.Y
	self.cx = mx - (sx - size.X / 2) / self.scale
	self.cy = my - (sy - size.Y / 2) / self.scale
	self:apply()
end

function CameraController:pan(dx, dy)
	self.cx = self.cx - dx / self.scale
	self.cy = self.cy - dy / self.scale
	self:apply()
end

function CameraController:focusCell(cell, scale)
	local x, y = self.Map:xy(cell)
	self.cx, self.cy = x + 0.5, y + 0.5
	if scale then self.scale = scale end
	self:apply()
end

-- Level of detail: 0 world view, 1 regional, 2 local.
function CameraController:lod()
	local L = self.Config.View.LOD
	local zoom = self.scale / self:minScale()
	if zoom &gt;= L.Local then return 2 end
	if zoom &gt;= L.Regional then return 1 end
	return 0
end

return CameraController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">ClientState</string><ProtectedString name="Source">-- Mundial War · client-side mirror of what the server replicates. Renders only; decides nothing.
local ClientState = {}
ClientState.__index = ClientState

function ClientState.new(Map, Protocol, Config, Palette, Stats)
	local self = setmetatable({}, ClientState)
	self.Map, self.Protocol, self.Config, self.Palette, self.Stats = Map, Protocol, Config, Palette, Stats
	self.owner = {}
	for i = 1, Map.N do self.owner[i] = Map.land[i] and 0 or -1 end
	self.nations = {}          -- id -&gt; { info + troops, land, labelCell, labelSize }
	self.buildings = {}        -- cell -&gt; { kind, owner }
	self.relations = {}        -- "a:b" -&gt; kind
	self.orders = {}           -- list { id, nation, target, troops, front, anchor, origin }
	self.fleets = {}           -- id -&gt; { id, nation, troops, path, speed, target, progress, t0 }
	self.boats = {}           -- list { id, nation, x, y, health, patrolCell, level }
	self.missiles = {}         -- id -&gt; { id, kind, nation, from, to, speed, progress, t0 }
	self.fires = {}            -- list { id, centerCell, radius }
	self.cargos = {}           -- list { id, nation, cell }
	self.match = { phase = "waiting", round = 0, left = 0 }
	self.matchAt = 0
	self.you = nil
	self.me = nil              -- private HUD numbers
	self.percent = Config.DefaultTroopPercent
	self.listeners = {}
	return self
end

function ClientState:on(name, fn)
	self.listeners[name] = self.listeners[name] or {}
	table.insert(self.listeners[name], fn)
end

function ClientState:fire(name, ...)
	for _, fn in ipairs(self.listeners[name] or {}) do fn(...) end
end

local function key(a, b)
	if a &gt; b then a, b = b, a end
	return a .. ":" .. b
end

function ClientState:relation(a, b)
	if not a or not b then return "neutral" end
	if a == b then return "self" end
	return self.relations[key(a, b)] or "neutral"
end

function ClientState:nationColor(id)
	local n = self.nations[id]
	return n and self.Palette.Nations[n.color] or self.Palette.Neutral
end

function ClientState:applyInit(data)
	local Map = self.Map
	for i = 1, Map.N do self.owner[i] = Map.land[i] and 0 or -1 end
	self.Protocol.decodeRuns(data.owners, self.owner)
	self.nations = {}
	for _, info in ipairs(data.nations) do
		info.troops, info.land, info.labelCell, info.labelSize = 0, 0, info.capital, 1
		self.nations[info.id] = info
	end
	self.buildings = {}
	for _, b in ipairs(data.buildings) do self.buildings[b[1]] = { kind = b[2], owner = b[3], level = b[4] or 1, off = b[5] == true } end
	self.relations = {}
	for _, r in ipairs(data.relations) do self.relations[key(r[1], r[2])] = r[3] end
	self.orders = {}
	self.fleets = {}
	local now = os.clock()
	for _, f in ipairs(data.fleets or {}) do
		self.fleets[f[1]] = { id = f[1], nation = f[2], troops = f[3], path = f[4], speed = f[5], target = f[6], progress = f[7], air = f[8] == true, t0 = now }
	end
	self.boats = data.boats or {}
	self.fires = data.fires or {}
	self.cargos = data.cargos or {}
	self.missiles = {}
	for _, m in ipairs(data.missiles or {}) do
		self.missiles[m[1]] = { id = m[1], kind = m[2], nation = m[3], from = m[4], to = m[5], speed = m[6], progress = m[7], t0 = now }
	end
	self.match = data.match
	self.matchAt = now
	self.you = data.you
	self.me = nil
	self.debug = data.debug
	self:fire("init")
end

function ClientState:applyDelta(data)
	local changed = data.d
	if changed then
		local cells = {}
		for k = 1, #changed, 2 do
			self.owner[changed[k]] = changed[k + 1]
			cells[#cells + 1] = changed[k]
		end
		self:fire("owners", cells)
	end
	if data.b then
		for _, b in ipairs(data.b) do
			if b[2] then self.buildings[b[1]] = { kind = b[2], owner = b[3], level = b[4] or 1, off = b[5] == true } else self.buildings[b[1]] = nil end
		end
		self:fire("buildings")
	end
end

function ClientState:applyNations(data)
	if data.add then
		local info = data.add
		info.troops, info.land, info.labelCell, info.labelSize = 0, 0, info.capital, 1
		self.nations[info.id] = info
		self:fire("nationList")
		return
	end
	if data.remove then
		self.nations[data.remove] = nil
		if self.you == data.remove then
			self.you = nil
			self.me = nil
		end
		self:fire("nationList")
		return
	end
	if data.list then
		for _, row in ipairs(data.list) do
			local n = self.nations[row[1]]
			if n then
				n.troops, n.land, n.labelCell, n.labelSize, n.capital = row[2], row[3], row[4], row[5], row[6]
			end
		end
		if data.match then
			self.match = data.match
			self.matchAt = os.clock()
		end
		self:fire("nations")
	end
end

function ClientState:applyOrders(data)
	local now = os.clock()
	if data.fleet then
		local f = data.fleet
		self.fleets[f[1]] = { id = f[1], nation = f[2], troops = f[3], path = f[4], speed = f[5], target = f[6], progress = 1, air = f[7] == true, t0 = now }
	end
	if data.fleetEnd then self.fleets[data.fleetEnd] = nil end
	if data.orders then self.orders = data.orders end
	if data.fleets then
		for _, row in ipairs(data.fleets) do
			local f = self.fleets[row[1]]
			if f then f.troops, f.progress, f.t0 = row[3], row[4], now end
		end
	end
	if data.boats then self.boats = data.boats end
	if data.fires then self.fires = data.fires end
	if data.cargos then self.cargos = data.cargos end
	if data.bots then self.botStates = data.bots end
	self:fire("orders")
end

function ClientState:applyDiplomacy(data)
	if data.rel then
		local k = key(data.a, data.b)
		self.relations[k] = data.rel ~= "neutral" and data.rel or nil
		self:fire("relations", data.a, data.b, data.rel)
	end
	if data.request then self:fire("allianceRequest", data.request, data.expires) end
end

function ClientState:applyImpact(data)
	local now = os.clock()
	if data.launch then
		local m = data.launch
		self.missiles[m[1]] = { id = m[1], kind = m[2], nation = m[3], from = m[4], to = m[5], speed = m[6], progress = 0, t0 = now }
	end
	if data.hit then
		self.missiles[data.hit[1]] = nil
		self:fire("impact", data.hit[2], data.hit[3], data.hit[4])
	end
end

function ClientState:applyMe(data)
	self.me = data
	if data.id and self.you ~= data.id then
		self.you = data.id
		self:fire("nationList")
	end
	self:fire("me")
end

function ClientState:timeLeft()
	return math.max(0, (self.match.left or 0) - (os.clock() - self.matchAt))
end

-- Own boat closest to map point (x, y) within `radius` cells, or nil.
function ClientState:boatNear(nid, x, y, radius)
	local best, bestD = nil, radius * radius
	for _, b in ipairs(self.boats) do
		if b[2] == nid then
			local d = (b[3] - x) ^ 2 + (b[4] - y) ^ 2
			if d &lt;= bestD then best, bestD = b, d end
		end
	end
	return best
end

-- Nearest cell of `nid` to `cell` that touches other land (arrow origin for an order).
function ClientState:nearestBorder(nid, cell)
	local Map, owner = self.Map, self.owner
	local cx, cy = Map:xy(cell)
	local best, bestD = nil, math.huge
	for i = 1, Map.N do
		if owner[i] == nid then
			local x, y = Map:xy(i)
			local d = (x - cx) * (x - cx) + (y - cy) * (y - cy)
			if d &lt; bestD then best, bestD = i, d end
		end
	end
	return best
end

return ClientState
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">DebugOverlay</string><ProtectedString name="Source">-- Mundial War · DEBUG_MODE overlay: cell under cursor, chunk grid, orders and bot states.
-- Only created when the server says GameConfig.DEBUG_MODE is on.
local DebugOverlay = {}
DebugOverlay.__index = DebugOverlay

local CHUNK = 64

function DebugOverlay.new(state, camera, gui, world)
	local self = setmetatable({}, DebugOverlay)
	self.state, self.camera = state, camera
	self.text = Instance.new("TextLabel")
	self.text.Name = "Debug"
	self.text.AnchorPoint = Vector2.new(0, 1)
	self.text.Position = UDim2.new(0, 12, 1, -84)
	self.text.Size = UDim2.fromOffset(330, 150)
	self.text.BackgroundColor3 = Color3.new(0, 0, 0)
	self.text.BackgroundTransparency = 0.4
	self.text.TextColor3 = Color3.fromRGB(140, 255, 160)
	self.text.Font = Enum.Font.Code
	self.text.TextSize = 12
	self.text.TextXAlignment = Enum.TextXAlignment.Left
	self.text.TextYAlignment = Enum.TextYAlignment.Top
	self.text.ZIndex = 60
	self.text.Parent = gui
	local grid = Instance.new("Frame")
	grid.Name = "ChunkGrid"
	grid.BackgroundTransparency = 1
	grid.Size = UDim2.fromScale(1, 1)
	grid.ZIndex = 3
	grid.Parent = world
	local Map = state.Map
	for x = CHUNK, Map.W - 1, CHUNK do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
		f.BackgroundTransparency = 0.6
		f.Position = UDim2.fromScale(x / Map.W, 0)
		f.Size = UDim2.new(0, 1, 1, 0)
		f.Parent = grid
	end
	for y = CHUNK, Map.H - 1, CHUNK do
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
		f.BackgroundTransparency = 0.6
		f.Position = UDim2.fromScale(0, y / Map.H)
		f.Size = UDim2.new(1, 0, 0, 1)
		f.Parent = grid
	end
	return self
end

function DebugOverlay:hover(p)
	local state, Map = self.state, self.state.Map
	local cell = self.camera:screenToCell(p)
	if not cell then return end
	local x, y = Map:xy(cell)
	local country = Map.countries[Map.country[cell]]
	local owner = state.owner[cell]
	local n = state.nations[owner]
	local lines = {
		string.format("cell %d  (%d, %d)  chunk %d,%d", cell, x, y, math.floor(x / CHUNK), math.floor(y / CHUNK)),
		string.format("country %s  coast %s", country and country.code or "-", tostring(Map.coast[cell] == true)),
		string.format("owner %d %s", owner, n and n.name or ""),
		string.format("zoom %.2f px/cell  lod %d", self.camera.scale, self.camera:lod()),
		string.format("orders %d  fleets %d", #state.orders, (function() local c = 0 for _ in pairs(state.fleets) do c = c + 1 end return c end)()),
	}
	local bots = {}
	for _, b in ipairs(state.botStates or {}) do
		local bn = state.nations[b[1]]
		if bn and #bots &lt; 6 then bots[#bots + 1] = string.sub(bn.name, 1, 12) .. ":" .. b[2] end
	end
	if #bots &gt; 0 then lines[#lines + 1] = table.concat(bots, "  ") end
	self.text.Text = table.concat(lines, "\n")
end

return DebugOverlay
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">HUD</string><ProtectedString name="Source">-- Mundial War · minimal interface around the map: player card, troop %, tools, ranking,
-- popovers and notices. Everything sits on the screen edges; the map stays the screen.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local HUD = {}
HUD.__index = HUD

local FONT = Enum.Font.GothamMedium
local BOLD = Enum.Font.GothamBold
local PANEL = Color3.fromRGB(16, 22, 30)
local PANEL_T = 0.12
local TEXT = Color3.fromRGB(236, 238, 240)
local MUTED = Color3.fromRGB(150, 160, 172)
local ACCENT = Color3.fromRGB(240, 196, 92)
local GOOD = Color3.fromRGB(110, 200, 130)
local BAD = Color3.fromRGB(235, 110, 100)

local function make(class, parent, props)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end

local function panel(parent, props)
	local f = make("Frame", parent, props)
	f.BackgroundColor3 = PANEL
	f.BackgroundTransparency = PANEL_T
	f.BorderSizePixel = 0
	make("UICorner", f, { CornerRadius = UDim.new(0, 8) })
	return f
end

local function button(parent, text, props)
	local b = make("TextButton", parent, props)
	b.Text = text
	b.Font = props and props.Font or BOLD
	b.TextSize = props and props.TextSize or 14
	b.TextColor3 = TEXT
	b.BackgroundColor3 = props and props.BackgroundColor3 or Color3.fromRGB(34, 44, 58)
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	make("UICorner", b, { CornerRadius = UDim.new(0, 6) })
	return b
end

local function rgb(c) return Color3.fromRGB(c[1], c[2], c[3]) end

function HUD.new(state, gui, handlers)
	local self = setmetatable({}, HUD)
	self.state, self.gui, self.h = state, gui, handlers
	self.Config, self.Protocol = state.Config, state.Protocol
	local player = Players.LocalPlayer

	-- Player card (bottom-left) ----------------------------------------------------
	local card = panel(gui, { Name = "PlayerCard", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Size = UDim2.fromOffset(238, 64), ZIndex = 20 })
	local avatar = make("ImageLabel", card, { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = Color3.fromRGB(60, 70, 84), BorderSizePixel = 0, ZIndex = 21 })
	make("UICorner", avatar, { CornerRadius = UDim.new(1, 0) })
	self.avatarStroke = make("UIStroke", avatar, { Thickness = 2, Color = TEXT })
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok then avatar.Image = url end
	end)
	make("TextLabel", card, { Position = UDim2.fromOffset(64, 6), Size = UDim2.new(1, -70, 0, 18), BackgroundTransparency = 1, Font = BOLD, TextSize = 14, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = player.DisplayName, ZIndex = 21 })
	self.troopsText = make("TextLabel", card, { Position = UDim2.fromOffset(64, 25), Size = UDim2.new(1, -70, 0, 17), BackgroundTransparency = 1, Font = FONT, TextSize = 13, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = "👥 —", ZIndex = 21 })
	self.goldText = make("TextLabel", card, { Position = UDim2.fromOffset(64, 43), Size = UDim2.new(1, -70, 0, 16), BackgroundTransparency = 1, Font = FONT, TextSize = 13, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, Text = "💰 —", ZIndex = 21 })

	-- Troop percentage (bottom-centre) ------------------------------------------------
	local bar = panel(gui, { Name = "Percent", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 20 })
	self.percentBar = bar
	make("UIListLayout", bar, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	make("UIPadding", bar, { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) })
	self.percentButtons = {}
	for index, p in ipairs(self.Config.TroopPercents) do
		local b = button(bar, math.floor(p * 100) .. "%", { Size = UDim2.fromOffset(48, 30), LayoutOrder = index, TextSize = 13, ZIndex = 21 })
		b.Activated:Connect(function() self.h.onPercent(p) end)
		self.percentButtons[p] = b
	end
	self.cancelButton = button(bar, "✖", { Size = UDim2.fromOffset(40, 30), LayoutOrder = 10, BackgroundColor3 = Color3.fromRGB(110, 46, 44), ZIndex = 21 })
	self.cancelButton.Activated:Connect(function() self.h.onCancel() end)

	-- Tools (bottom-right) ---------------------------------------------------------------
	local tools = panel(gui, { Name = "Tools", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 20 })
	make("UIListLayout", tools, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	make("UIPadding", tools, { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5) })
	self.tools = {}
	local toolList = {
		{ "build", "🏗", "Construir" }, { "weapons", "💣", "Bombas e ataques" },
		{ "ranking", "🏆", "Ranking" }, { "fit", "🌍", "Ver o mundo" }, { "help", "?", "Ajuda" },
	}
	for index, t in ipairs(toolList) do
		local b = button(tools, t[2], { Size = UDim2.fromOffset(34, 30), LayoutOrder = index, TextSize = 16, ZIndex = 21 })
		b.Activated:Connect(function() self.h.onTool(t[1]) end)
		self.tools[t[1]] = b
	end
	-- weapons appear only after building an air base or a silo
	self.tools.weapons.Visible = false

	-- Build and weapon trays (above the tools): a grid of choices plus an explanation line ----
	local function tray(name, order, defs, onPick)
		local t = panel(gui, { Name = name, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -60), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 30 })
		make("UIPadding", t, { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) })
		make("UIListLayout", t, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		local grid = make("Frame", t, { LayoutOrder = 1, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 31 })
		make("UIGridLayout", grid, { CellSize = UDim2.fromOffset(141, 44), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		local buttons = {}
		for index, kind in ipairs(order) do
			local b = button(grid, "", { LayoutOrder = index, ZIndex = 31, TextSize = 12 })
			b.RichText = true
			b.TextXAlignment = Enum.TextXAlignment.Left
			make("UIPadding", b, { PaddingLeft = UDim.new(0, 8) })
			b.Activated:Connect(function() onPick(kind) end)
			buttons[kind] = b
		end
		local info = make("TextLabel", t, { LayoutOrder = 2, BackgroundTransparency = 1, TextColor3 = MUTED, Font = FONT, TextSize = 12, TextWrapped = true, RichText = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = "", ZIndex = 31 })
		return t, buttons, info
	end
	self.tray, self.trayButtons, self.trayInfo = tray("BuildTray", self.Config.BuildingOrder, self.Config.Buildings, function(kind) self.h.onBuild(kind) end)
	self.weaponTray, self.weaponButtons, self.weaponInfo = tray("WeaponTray", self.Config.WeaponOrder, self.Config.Weapons, function(kind) self.h.onWeapon(kind) end)

	-- Top banner (phase / mode) and notices -------------------------------------------------
	self.banner = panel(gui, { Name = "Banner", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 20, Visible = false })
	make("UIPadding", self.banner, { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) })
	self.bannerText = make("TextLabel", self.banner, { Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Font = BOLD, TextSize = 14, TextColor3 = ACCENT, ZIndex = 21 })
	self.toasts = make("Frame", gui, { Name = "Notices", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.fromOffset(460, 120), ZIndex = 25 })
	make("UIListLayout", self.toasts, { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })

	-- Ranking (top-right) and alliance requests ---------------------------------------------------
	self.ranking = panel(gui, { Name = "Ranking", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(210, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 20 })
	make("UIPadding", self.ranking, { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })
	make("UIListLayout", self.ranking, { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	self.rankRows = {}
	for k = 1, 8 do
		local row = make("TextLabel", self.ranking, { LayoutOrder = k, Size = UDim2.new(1, 0, 0, 17), BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, RichText = true, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", ZIndex = 21 })
		self.rankRows[k] = row
	end
	self.requests = make("Frame", gui, { Name = "Requests", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -230, 0, 10), Size = UDim2.fromOffset(250, 200), ZIndex = 25 })
	make("UIListLayout", self.requests, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })

	-- Popover (nation / cell) ------------------------------------------------------------------
	self.popover = panel(gui, { Name = "Popover", Size = UDim2.fromOffset(220, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 40 })
	make("UIPadding", self.popover, { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
	make("UIListLayout", self.popover, { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder })
	self.popTitle = make("TextLabel", self.popover, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = BOLD, TextSize = 14, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 41 })
	self.popBody = make("TextLabel", self.popover, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, RichText = true, ZIndex = 41 })
	self.popButtons = make("Frame", self.popover, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 41 })
	make("UIGridLayout", self.popButtons, { CellSize = UDim2.new(0.5, -3, 0, 28), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder })

	-- Victory / help overlays ----------------------------------------------------------------------
	self.center = panel(gui, { Name = "Center", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(420, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 50 })
	make("UIPadding", self.center, { PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) })
	make("UIListLayout", self.center, { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	self.centerTitle = make("TextLabel", self.center, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Font = BOLD, TextSize = 28, TextColor3 = ACCENT, ZIndex = 51 })
	self.centerBody = make("TextLabel", self.center, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = FONT, TextSize = 14, TextColor3 = TEXT, TextWrapped = true, RichText = true, ZIndex = 51 })
	self.centerClose = button(self.center, "Fechar", { LayoutOrder = 3, Size = UDim2.fromOffset(120, 30), ZIndex = 51 })
	self.centerClose.Activated:Connect(function() self.center.Visible = false end)

	-- narrow screens (phones/tablets): lift the percentage bar above the player card
	local function layout()
		local narrow = gui.AbsoluteSize.X &lt; 1000
		bar.Position = narrow and UDim2.new(0.5, 0, 1, -84) or UDim2.new(0.5, 0, 1, -12)
		if gui.AbsoluteSize.Y &lt;= 420 then self.ranking.Visible = false end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	layout()

	-- Mode menu: shown during the vote that opens every round -----------------------------------
	self.menu = panel(gui, { Name = "ModeMenu", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(560, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 60 })
	make("UIPadding", self.menu, { PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) })
	make("UIListLayout", self.menu, { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	make("TextLabel", self.menu, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Font = BOLD, TextSize = 28, TextColor3 = ACCENT, Text = "MUNDIAL WAR", ZIndex = 61 })
	self.menuTimer = make("TextLabel", self.menu, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = FONT, TextSize = 13, TextColor3 = MUTED, Text = "Escolha o modo da próxima partida", ZIndex = 61 })
	local cards = make("Frame", self.menu, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 61 })
	make("UIListLayout", cards, { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	self.modeCards = {}
	for index, mode in ipairs(self.Config.ModeOrder) do
		local def = self.Config.Modes[mode]
		local card = make("Frame", cards, { LayoutOrder = index, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(28, 38, 52), BorderSizePixel = 0, ZIndex = 61 })
		make("UICorner", card, { CornerRadius = UDim.new(0, 8) })
		local stroke = make("UIStroke", card, { Thickness = 2, Color = ACCENT, Transparency = 1 })
		make("UIPadding", card, { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
		make("UIListLayout", card, { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
		make("TextLabel", card, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Font = BOLD, TextSize = 17, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, Text = def.icon .. " " .. def.name, ZIndex = 62 })
		make("TextLabel", card, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = MUTED, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Text = def.description, ZIndex = 62 })
		local votes = make("TextLabel", card, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = ACCENT, TextXAlignment = Enum.TextXAlignment.Left, Text = "0 votos", ZIndex = 62 })
		local vote = button(card, "Votar", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 30), ZIndex = 62 })
		vote.Activated:Connect(function() self.h.onVote(mode) end)
		self.modeCards[mode] = { stroke = stroke, votes = votes }
	end

	self:setPercent(state.percent)
	return self
end

function HUD:setPercent(p)
	for value, b in pairs(self.percentButtons) do
		local on = math.abs(value - p) &lt; 1e-6
		b.BackgroundColor3 = on and ACCENT or Color3.fromRGB(34, 44, 58)
		b.TextColor3 = on and Color3.fromRGB(30, 24, 10) or TEXT
	end
end

function HUD:toast(text, kind)
	if not text or text == "" then return end
	local color = kind == "bad" and BAD or kind == "good" and GOOD or kind == "war" and Color3.fromRGB(255, 140, 110) or TEXT
	local children = {}
	for _, c in ipairs(self.toasts:GetChildren()) do
		if c:IsA("TextLabel") then children[#children + 1] = c end
	end
	if #children &gt;= 3 then children[1]:Destroy() end
	local t = make("TextLabel", self.toasts, {
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.1, Font = FONT, TextSize = 13, TextColor3 = color, Text = text,
		LayoutOrder = math.floor(os.clock() * 100) % 1000000, ZIndex = 26,
	})
	make("UICorner", t, { CornerRadius = UDim.new(0, 6) })
	make("UIPadding", t, { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
	task.delay(4, function()
		if t.Parent then
			local tween = TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Connect(function() t:Destroy() end)
		end
	end)
end

function HUD:setBanner(text)
	self.banner.Visible = text ~= nil and text ~= ""
	self.bannerText.Text = text or ""
end

function HUD:refreshMe()
	local state = self.state
	local me = state.me
	local F = self.Protocol.formatK
	if not me or not state.you then
		self.troopsText.Text = "👥 —"
		self.goldText.Text = "💰 —"
		self.cancelButton.Visible = false
		return
	end
	self.troopsText.Text = string.format("👥 &lt;b&gt;%s&lt;/b&gt; &lt;font color=\"#96a0ac\"&gt;/ %s  +%s/s&lt;/font&gt;", F(me.troops), F(me.max), F(me.rate))
	self.goldText.Text = string.format("💰 &lt;b&gt;%s&lt;/b&gt; &lt;font color=\"#96a0ac\"&gt;+%s/s · %.1f%% do mundo&lt;/font&gt;", F(me.gold), F(me.goldRate), me.share * 100)
	if me.mode == "extreme" then
		self.goldText.Text = string.format("💰 &lt;b&gt;%s&lt;/b&gt; &lt;font color=\"#96a0ac\"&gt;+%s/s&lt;/font&gt;  🛢 &lt;b&gt;%s&lt;/b&gt; &lt;font color=\"#96a0ac\"&gt;+%s/s&lt;/font&gt;", F(me.gold), F(me.goldRate), F(me.oil), F(me.oilRate))
	end
	-- show only what exists in the current mode
	for kind, b in pairs(self.trayButtons) do
		local m = self.Config.Buildings[kind].mode
		b.Visible = m == nil or m == me.mode
	end
	for kind, b in pairs(self.weaponButtons) do
		local m = self.Config.Weapons[kind].mode
		b.Visible = m == nil or m == me.mode
	end
	self.avatarStroke.Color = rgb(state:nationColor(state.you))
	local mine = 0
	for _, o in ipairs(state.orders) do
		if o[2] == state.you then mine = mine + 1 end
	end
	self.cancelButton.Visible = mine &gt; 0
	self.cancelButton.Text = mine &gt; 1 and ("✖" .. mine) or "✖"
	-- weapons only once something can launch them
	self.tools.weapons.Visible = me.cooldowns ~= nil and (me.cooldowns.airfield ~= nil or me.cooldowns.silo ~= nil)
	if self.tray.Visible then self:refreshTray() end
	if self.weaponTray.Visible then self:refreshWeapons() end
end

function HUD:refreshTray()
	local me = self.state.me
	for kind, b in pairs(self.trayButtons) do
		local def = self.Config.Buildings[kind]
		local cost = me and me.costs and me.costs[kind] or def.cost
		local affordable = me and me.gold &gt;= cost
		b.Text = string.format("%s &lt;b&gt;%s&lt;/b&gt;\n&lt;font size=\"11\" color=\"%s\"&gt;💰 %s&lt;/font&gt;", def.icon, def.name, affordable and "#f0c45c" or "#8a8f96", self.Protocol.formatK(cost))
		b.BackgroundColor3 = (self.selectedBuild == kind) and Color3.fromRGB(92, 74, 30) or Color3.fromRGB(34, 44, 58)
		b.TextTransparency = affordable and 0 or 0.35
	end
	local kind = self.selectedBuild
	if kind then
		local def = self.Config.Buildings[kind]
		local lines = self.state.Stats.lines(self.Config, kind, 1)
		self.trayInfo.Text = "&lt;b&gt;" .. def.name .. "&lt;/b&gt;: " .. def.purpose .. "\n" .. table.concat(lines, " · ")
	else
		self.trayInfo.Text = "Escolha uma construção para ver para que serve e o alcance; depois clique numa célula sua."
	end
end

function HUD:refreshWeapons()
	local me = self.state.me
	for kind, b in pairs(self.weaponButtons) do
		local w = self.Config.Weapons[kind]
		local ready = me and me.cooldowns and me.cooldowns[w.launcher]
		local affordable = me and me.gold &gt;= w.gold and ready ~= nil
		local status = ready == nil and ("requer " .. self.Config.Buildings[w.launcher].name)
			or (ready &gt; 0 and string.format("recarga %ds", math.ceil(ready)) or ("💰 " .. self.Protocol.formatK(w.gold)))
		b.Text = string.format("%s &lt;b&gt;%s&lt;/b&gt;\n&lt;font size=\"11\" color=\"%s\"&gt;%s&lt;/font&gt;", w.icon, w.name, affordable and "#f0c45c" or "#8a8f96", status)
		b.BackgroundColor3 = (self.selectedWeapon == kind) and Color3.fromRGB(120, 48, 44) or Color3.fromRGB(34, 44, 58)
		b.TextTransparency = affordable and 0 or 0.35
	end
	local w = self.selectedWeapon and self.Config.Weapons[self.selectedWeapon]
	self.weaponInfo.Text = w and ("&lt;b&gt;" .. w.name .. "&lt;/b&gt;: " .. w.purpose .. " Raio " .. w.radius .. ". Clique no alvo e confirme com um segundo clique.")
		or "Escolha uma arma. Aviões saem da base aérea; bombas EMP, atômica e de hidrogênio, do silo."
end

function HUD:showWeapons(visible, selected)
	self.weaponTray.Visible = visible
	self.selectedWeapon = selected
	if visible then self:refreshWeapons() end
end

function HUD:showTray(visible, selected)
	self.tray.Visible = visible
	self.selectedBuild = selected
	if visible then self:refreshTray() end
end

function HUD:refreshRanking()
	local state = self.state
	local list = {}
	for id, n in pairs(state.nations) do list[#list + 1] = n end
	table.sort(list, function(a, b) return a.land &gt; b.land end)
	local total = state.Map.landCount
	for k, row in ipairs(self.rankRows) do
		local n = list[k]
		if n then
			local c = state.Palette.Nations[n.color] or state.Palette.Neutral
			local hex = string.format("#%02x%02x%02x", c[1], c[2], c[3])
			local you = n.id == state.you
			row.Text = string.format("&lt;font color=\"%s\"&gt;■&lt;/font&gt; %s%s &lt;font color=\"#96a0ac\"&gt;%.1f%% · %s&lt;/font&gt;",
				hex, you and "&lt;b&gt;" or "", n.name .. (you and "&lt;/b&gt;" or ""), n.land / total * 100, self.Protocol.formatK(n.troops))
			row.Visible = true
		else
			row.Visible = false
		end
	end
end

function HUD:toggleRanking()
	self.ranking.Visible = not self.ranking.Visible
end

-- Popover near a screen point with a title, text and buttons { {label, fn, danger} }.
function HUD:showPopover(screenPos, title, body, buttons)
	self.popTitle.Text = title
	self.popBody.Text = body or ""
	for _, c in ipairs(self.popButtons:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	for index, b in ipairs(buttons or {}) do
		local btn = button(self.popButtons, b[1], { LayoutOrder = index, TextSize = 12, ZIndex = 42, BackgroundColor3 = b[3] and Color3.fromRGB(120, 48, 44) or Color3.fromRGB(40, 58, 76) })
		btn.Activated:Connect(function()
			self:hidePopover()
			b[2]()
		end)
	end
	local size = self.gui.AbsoluteSize
	local x = math.clamp(screenPos.X + 16, 8, math.max(8, size.X - 236))
	local y = math.clamp(screenPos.Y - 20, 50, math.max(50, size.Y - 220))
	self.popover.Position = UDim2.fromOffset(x, y)
	self.popover.Visible = true
end

function HUD:hidePopover()
	self.popover.Visible = false
end

function HUD:showCenter(title, body, closable)
	self.centerTitle.Text = title
	self.centerBody.Text = body
	self.centerClose.Visible = closable ~= false
	self.center.Visible = true
end

function HUD:hideCenter()
	self.center.Visible = false
end

function HUD:allianceRequest(fromId, seconds, onAccept, onDecline)
	local n = self.state.nations[fromId]
	if not n then return end
	local card = panel(self.requests, { Size = UDim2.new(1, 0, 0, 62), ZIndex = 26 })
	make("TextLabel", card, { Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 18), BackgroundTransparency = 1, Font = BOLD, TextSize = 13, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, Text = "🤝 " .. n.name .. " propõe aliança", TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 27 })
	local yes = button(card, "Aceitar", { Position = UDim2.fromOffset(10, 28), Size = UDim2.new(0.5, -14, 0, 26), BackgroundColor3 = Color3.fromRGB(46, 110, 64), TextSize = 12, ZIndex = 27 })
	local no = button(card, "Recusar", { Position = UDim2.new(0.5, 4, 0, 28), Size = UDim2.new(0.5, -14, 0, 26), TextSize = 12, ZIndex = 27 })
	yes.Activated:Connect(function() card:Destroy() onAccept() end)
	no.Activated:Connect(function() card:Destroy() onDecline() end)
	task.delay(seconds or 30, function() if card.Parent then card:Destroy() end end)
end


function HUD:refreshMenu(myVote)
	local match = self.state.match
	local show = match.phase == "vote"
	self.menu.Visible = show
	if not show then return end
	self.menuTimer.Text = "Escolha o modo da próxima partida · " .. math.ceil(self.state:timeLeft()) .. "s"
	for mode, c in pairs(self.modeCards) do
		local n = match.votes and match.votes[mode] or 0
		c.votes.Text = n .. (n == 1 and " voto" or " votos")
		c.stroke.Transparency = myVote == mode and 0 or 1
	end
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">InputController</string><ProtectedString name="Source">-- Mundial War · mouse, keyboard and touch → camera moves and map clicks.
-- Never relies on hover for anything essential, so phones and tablets work the same way.
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")

local InputController = {}
InputController.__index = InputController

local function v2(p) return Vector2.new(p.X, p.Y) end

function InputController.new(camera, Config, handlers)
	local self = setmetatable({}, InputController)
	self.camera, self.Config, self.h = camera, Config, handlers
	self.press = nil
	self.touches = {}
	self.pinch = nil
	local threshold = Config.View.DragThreshold

	UserInputService.InputBegan:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			if processed then return end
			self.touches[input] = v2(input.Position)
			local count = 0
			for _ in pairs(self.touches) do count = count + 1 end
			if count == 1 then
				self.press = { start = v2(input.Position), last = v2(input.Position), moved = false, button = 1, input = input }
			elseif count == 2 then
				self.press = nil
				local a, b = nil, nil
				for _, p in pairs(self.touches) do if not a then a = p else b = p end end
				self.pinch = { dist = (a - b).Magnitude, mid = (a + b) / 2 }
			end
			return
		end
		if processed then return end
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
			local button = t == Enum.UserInputType.MouseButton1 and 1 or t == Enum.UserInputType.MouseButton2 and 2 or 3
			self.press = { start = v2(input.Position), last = v2(input.Position), moved = false, button = button }
		elseif t == Enum.UserInputType.Keyboard then
			self.h.onKey(input.KeyCode)
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseWheel then
			if processed then return end
			local mouse = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
			local step = Config.View.ZoomStep
			camera:zoomAt(mouse, input.Position.Z &gt; 0 and step or 1 / step)
		elseif t == Enum.UserInputType.MouseMovement then
			local p = v2(input.Position)
			if self.press and not self.press.input then
				if not self.press.moved and (p - self.press.start).Magnitude &gt; threshold then
					self.press.moved = true
				end
				if self.press.moved then
					local d = p - self.press.last
					camera:pan(d.X, d.Y)
				end
				self.press.last = p
			end
			self.h.onHover(p)
		elseif t == Enum.UserInputType.Touch and self.touches[input] then
			local p = v2(input.Position)
			self.touches[input] = p
			if self.pinch then
				local a, b = nil, nil
				for _, q in pairs(self.touches) do if not a then a = q elseif not b then b = q end end
				if a and b then
					local dist = (a - b).Magnitude
					local mid = (a + b) / 2
					if self.pinch.dist &gt; 0 then camera:zoomAt(mid, dist / self.pinch.dist) end
					camera:pan(mid.X - self.pinch.mid.X, mid.Y - self.pinch.mid.Y)
					self.pinch.dist, self.pinch.mid = dist, mid
				end
			elseif self.press and self.press.input == input then
				if not self.press.moved and (p - self.press.start).Magnitude &gt; threshold * 2 then
					self.press.moved = true
				end
				if self.press.moved then
					local d = p - self.press.last
					camera:pan(d.X, d.Y)
				end
				self.press.last = p
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch then
			local press = self.press
			self.touches[input] = nil
			local count = 0
			for _ in pairs(self.touches) do count = count + 1 end
			if count &lt; 2 then self.pinch = nil end
			if press and press.input == input then
				self.press = nil
				if not press.moved then self.h.onClick(v2(input.Position), 1) end
			end
			return
		end
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
			local press = self.press
			self.press = nil
			if press and not press.input and not press.moved then
				self.h.onClick(v2(input.Position), press.button)
			end
		end
	end)

	-- keyboard panning (WASD / arrows) and +/- zoom, frame-rate independent
	RunService.RenderStepped:Connect(function(dt)
		if UserInputService:GetFocusedTextBox() then return end
		local dx, dy = 0, 0
		local K = Enum.KeyCode
		local down = function(k) return UserInputService:IsKeyDown(k) end
		if down(K.A) or down(K.Left) then dx = dx + 1 end
		if down(K.D) or down(K.Right) then dx = dx - 1 end
		if down(K.W) or down(K.Up) then dy = dy + 1 end
		if down(K.S) or down(K.Down) then dy = dy - 1 end
		if dx ~= 0 or dy ~= 0 then
			local speed = Config.View.KeyboardPanSpeed * dt
			camera:pan(dx * speed, dy * speed)
		end
		local zoom = 0
		if down(K.Equals) or down(K.KeypadPlus) then zoom = 1 end
		if down(K.Minus) or down(K.KeypadMinus) then zoom = -1 end
		if zoom ~= 0 then
			local size = camera.viewport.AbsoluteSize
			local center = camera.viewport.AbsolutePosition + size / 2
			camera:zoomAt(center, 1 + zoom * 2 * dt)
		end
	end)
	return self
end

return InputController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">MapRenderer</string><ProtectedString name="Source">-- Mundial War · paints the territory map. One pixel per cell in a single EditableImage
-- (one draw call, unaffected by graphics quality). Falls back to pooled row Frames when
-- EditableImage is unavailable (e.g. "Enable Mesh / Image APIs" not turned on).
local AssetService = game:GetService("AssetService")
local RunService = game:GetService("RunService")

local MapRenderer = {}
MapRenderer.__index = MapRenderer

local BORDER_SHADE = 0.58
local COUNTRY_SHADE = 0.9

function MapRenderer.new(state, parent)
	local self = setmetatable({}, MapRenderer)
	self.state = state
	self.Map = state.Map
	self.Palette = state.Palette
	self.dirty = {}
	self.dirtyCount = 0
	self.fullDirty = true
	local W, H = self.Map.W, self.Map.H

	local image = Instance.new("ImageLabel")
	image.Name = "Territory"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.ResampleMode = Enum.ResamplerMode.Pixelated
	image.ZIndex = 1
	image.Parent = parent
	self.image = image

	local ok, editable = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(W, H) })
	end)
	if ok and editable then
		local bound = pcall(function()
			image.ImageContent = Content.fromObject(editable)
		end)
		if bound then
			self.editable = editable
			self.buffer = buffer.create(W * H * 4)
		end
	end
	if not self.editable then
		warn("[MundialWar] EditableImage indisponível; usando renderizador de Frames. Ative 'Enable Mesh / Image APIs' nas configurações da experiência para o modo rápido.")
		image.Visible = false
		self.rowsFrame = Instance.new("Frame")
		self.rowsFrame.Name = "TerritoryRows"
		self.rowsFrame.BackgroundTransparency = 1
		self.rowsFrame.Size = UDim2.fromScale(1, 1)
		self.rowsFrame.ZIndex = 1
		self.rowsFrame.Parent = parent
		self.rowPools = {}
		self.dirtyRows = {}
	end
	self:recolor()

	state:on("init", function()
		self:recolor()
		self.fullDirty = true
	end)
	state:on("nationList", function()
		-- colours only; the cells of a new or removed nation arrive as territory deltas
		self:recolor()
	end)
	state:on("owners", function(cells)
		for _, i in ipairs(cells) do self:markAround(i) end
	end)
	self.connection = RunService.RenderStepped:Connect(function()
		self:flush()
	end)
	return self
end

-- Pre-computes fill/border/country-line colours for every nation id.
function MapRenderer:recolor()
	local P = self.Palette
	self.colors = {}
	for id, n in pairs(self.state.nations) do
		local base = P.Nations[n.color] or P.Neutral
		self.colors[id] = {
			fill = base,
			border = P.shade(base, BORDER_SHADE),
			line = P.shade(base, COUNTRY_SHADE),
		}
	end
	self.neutralColors = {
		fill = P.Neutral, line = P.CountryLine,
		water = P.Water, waterCoast = P.WaterCoast,
	}
	-- free land fades smoothly toward snow at high latitudes (no hard line at the polar circle)
	self.rowNeutral = {}
	for y = 0, self.Map.H - 1 do
		local t = math.max(0, math.min(1, (math.abs(self.Map.latitude[y]) - 56) / 24))
		self.rowNeutral[y] = P.mix(P.Neutral, P.NeutralPolar, t)
	end
end

function MapRenderer:markAround(i)
	local W, N = self.Map.W, self.Map.N
	local list = { i, i - W, i + W }
	local x = (i - 1) % W
	if x &gt; 0 then list[#list + 1] = i - 1 end
	if x &lt; W - 1 then list[#list + 1] = i + 1 end
	for _, j in ipairs(list) do
		if j &gt;= 1 and j &lt;= N and not self.dirty[j] then
			self.dirty[j] = true
			self.dirtyCount = self.dirtyCount + 1
		end
	end
end

-- Colour of one cell: water, neutral land (with faint country lines), or a nation
-- (darker band on its outer border so neighbouring empires read as separate shapes).
function MapRenderer:cellColor(i)
	local Map, owner = self.Map, self.state.owner
	local W, N = Map.W, Map.N
	local o = owner[i]
	local x = (i - 1) % W
	local c = self.neutralColors
	if o == -1 then
		return Map.landNear and Map.landNear[i] and c.waterCoast or c.water
	end
	local country = Map.country[i]
	local otherOwner, otherCountry = false, false
	local j, oj
	for k = 1, 4 do
		if k == 1 then j = x &gt; 0 and i - 1 or nil
		elseif k == 2 then j = x &lt; W - 1 and i + 1 or nil
		elseif k == 3 then j = i &gt; W and i - W or nil
		else j = i &lt;= N - W and i + W or nil end
		if j then
			oj = owner[j]
			if oj ~= -1 then
				if oj ~= o then otherOwner = true end
				if Map.country[j] ~= country then otherCountry = true end
			end
		end
	end
	if o == 0 then
		if otherCountry then return c.line end
		return self.rowNeutral[(i - 1 - x) / W]
	end
	local nc = self.colors[o]
	if not nc then return c.fill end
	if otherOwner then return nc.border end
	if otherCountry then return nc.line end
	return nc.fill
end

function MapRenderer:paintFull()
	local Map = self.Map
	if not Map.landNear then
		Map.landNear = {}
		for i = 1, Map.N do
			if not Map.land[i] then
				local x = (i - 1) % Map.W
				if (x &gt; 0 and Map.land[i - 1]) or (x &lt; Map.W - 1 and Map.land[i + 1])
					or (i &gt; Map.W and Map.land[i - Map.W]) or (i &lt;= Map.N - Map.W and Map.land[i + Map.W]) then
					Map.landNear[i] = true
				end
			end
		end
	end
	if self.editable then
		local buf = self.buffer
		for i = 1, Map.N do
			local c = self:cellColor(i)
			local o = (i - 1) * 4
			buffer.writeu8(buf, o, c[1])
			buffer.writeu8(buf, o + 1, c[2])
			buffer.writeu8(buf, o + 2, c[3])
			buffer.writeu8(buf, o + 3, 255)
		end
		self.editable:WritePixelsBuffer(Vector2.zero, Vector2.new(Map.W, Map.H), buf)
	else
		for y = 0, Map.H - 1 do self.dirtyRows[y] = true end
	end
	self.dirty, self.dirtyCount = {}, 0
end

function MapRenderer:paintDirty()
	local Map = self.Map
	local W = Map.W
	if self.editable then
		local buf = self.buffer
		local minX, minY, maxX, maxY = W, Map.H, -1, -1
		for i in pairs(self.dirty) do
			local c = self:cellColor(i)
			local o = (i - 1) * 4
			buffer.writeu8(buf, o, c[1])
			buffer.writeu8(buf, o + 1, c[2])
			buffer.writeu8(buf, o + 2, c[3])
			local x = (i - 1) % W
			local y = (i - 1 - x) / W
			if x &lt; minX then minX = x end
			if x &gt; maxX then maxX = x end
			if y &lt; minY then minY = y end
			if y &gt; maxY then maxY = y end
		end
		if maxX &gt;= minX then
			local w, h = maxX - minX + 1, maxY - minY + 1
			if w * h &gt; Map.N / 3 then
				self.editable:WritePixelsBuffer(Vector2.zero, Vector2.new(W, Map.H), buf)
			else
				local rect = buffer.create(w * h * 4)
				for row = 0, h - 1 do
					buffer.copy(rect, row * w * 4, buf, ((minY + row) * W + minX) * 4, w * 4)
				end
				self.editable:WritePixelsBuffer(Vector2.new(minX, minY), Vector2.new(w, h), rect)
			end
		end
	else
		for i in pairs(self.dirty) do
			local x = (i - 1) % W
			self.dirtyRows[(i - 1 - x) / W] = true
		end
	end
	self.dirty, self.dirtyCount = {}, 0
end

-- Fallback: one Frame per run of equal colour in a row, pooled and reused.
function MapRenderer:paintRow(y)
	local Map = self.Map
	local W, H = Map.W, Map.H
	local pool = self.rowPools[y]
	if not pool then pool = {} self.rowPools[y] = pool end
	local used, x = 0, 0
	while x &lt; W do
		local c = self:cellColor(y * W + x + 1)
		local stop = x + 1
		while stop &lt; W do
			local d = self:cellColor(y * W + stop + 1)
			if d[1] ~= c[1] or d[2] ~= c[2] or d[3] ~= c[3] then break end
			stop = stop + 1
		end
		used = used + 1
		local f = pool[used]
		if not f then
			f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.Parent = self.rowsFrame
			pool[used] = f
		end
		f.Position = UDim2.fromScale(x / W, y / H)
		f.Size = UDim2.new((stop - x) / W, 1, 1 / H, 1)
		f.BackgroundColor3 = Color3.fromRGB(c[1], c[2], c[3])
		f.Visible = true
		x = stop
	end
	for k = used + 1, #pool do pool[k].Visible = false end
end

function MapRenderer:flush()
	if self.fullDirty then
		self.fullDirty = false
		self:paintFull()
	elseif self.dirtyCount &gt; 0 then
		self:paintDirty()
	end
	if self.dirtyRows then
		local count = 0
		for y in pairs(self.dirtyRows) do
			self.dirtyRows[y] = nil
			self:paintRow(y)
			count = count + 1
			if count &gt;= 12 then break end
		end
	end
end

return MapRenderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">OverlayRenderer</string><ProtectedString name="Source">-- Mundial War · everything drawn on top of the territory: nation names, capitals,
-- structures, fronts, fleets, missiles and the aiming arrow. Items live inside the
-- world frame with scale positions, so panning costs nothing; sizes follow the zoom (LOD).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local OverlayRenderer = {}
OverlayRenderer.__index = OverlayRenderer

local FONT = Enum.Font.GothamBold
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(20, 26, 34)

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function make(class, parent, props)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

function OverlayRenderer.new(state, camera, world)
	local self = setmetatable({}, OverlayRenderer)
	self.state, self.camera, self.Map = state, camera, state.Map
	self.Config, self.Protocol = state.Config, state.Protocol
	self.layer = make("Frame", world, { Name = "Overlay", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	self.labels, self.capitals, self.icons, self.orderItems = {}, {}, {}, {}
	self.fleetItems, self.missileItems, self.shipItems = {}, {}, {}
	self.fireItems, self.cargoItems = {}, {}
	self.thumbs = {}
	self.aim = nil
	self.needsLayout = true

	state:on("init", function() self:rebuildAll() end)
	-- a nation joined or fell: create/remove only its own items (ids restart each round,
	-- which is handled by the full rebuild on "init")
	state:on("nationList", function() self.needsLayout = true end)
	state:on("nations", function() self:updateLabels() end)
	state:on("buildings", function() self:updateBuildings() end)
	state:on("orders", function() self:updateOrders() end)
	state:on("relations", function() self:updateLabels() end)
	state:on("impact", function(kind, cell, stopped) self:flash(kind, cell, stopped) end)
	camera:onChanged(function() self.needsLayout = true end)
	RunService.RenderStepped:Connect(function()
		if self.needsLayout then
			self.needsLayout = false
			self:updateLabels()
			self:updateBuildings()
			self:updateOrders()
		end
		self:animate()
	end)
	return self
end

function OverlayRenderer:pos(cell, dx, dy)
	local x, y = self.Map:xy(cell)
	return UDim2.fromScale((x + 0.5 + (dx or 0)) / self.Map.W, (y + 0.5 + (dy or 0)) / self.Map.H)
end

function OverlayRenderer:posXY(x, y)
	return UDim2.fromScale(x / self.Map.W, y / self.Map.H)
end

-- A straight line between two map points (cell units) that scales with the world frame.
function OverlayRenderer:line(frame, ax, ay, bx, by, thickness)
	local dx, dy = bx - ax, by - ay
	local length = math.sqrt(dx * dx + dy * dy)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = self:posXY((ax + bx) / 2, (ay + by) / 2)
	frame.Size = UDim2.new(length / self.Map.W, 0, 0, thickness or 2)
	frame.Rotation = math.deg(math.atan2(dy, dx))
end

function OverlayRenderer:center(cell)
	local x, y = self.Map:xy(cell)
	return x + 0.5, y + 0.5
end

function OverlayRenderer:rebuildAll()
	for _, l in pairs(self.labels) do l.frame:Destroy() end
	for _, c in pairs(self.capitals) do c:Destroy() end
	for _, icon in pairs(self.icons) do icon:Destroy() end
	self.labels, self.capitals, self.icons = {}, {}, {}
	self:updateLabels()
	self:updateBuildings()
	self:updateOrders()
end

-- Nation name/avatar/troops over the centre of each nation's largest block.
function OverlayRenderer:updateLabels()
	local state, cam = self.state, self.camera
	local lod = cam:lod()
	local scale = cam.scale
	local alive = {}
	for id, n in pairs(state.nations) do
		alive[id] = true
		local item = self.labels[id]
		if not item then
			local frame = make("Frame", self.layer, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 6 })
			local list = make("UIListLayout", frame, { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 0) })
			list.SortOrder = Enum.SortOrder.LayoutOrder
			local head = make("Frame", frame, { BackgroundTransparency = 1, LayoutOrder = 1, AutomaticSize = Enum.AutomaticSize.X })
			make("UIListLayout", head, { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder })
			local avatar = make("ImageLabel", head, { BackgroundColor3 = rgb(state:nationColor(id)), BorderSizePixel = 0, LayoutOrder = 1, ZIndex = 6 })
			make("UICorner", avatar, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", avatar, { Color = WHITE, Thickness = 1.5 })
			local initial = make("TextLabel", avatar, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = FONT, TextColor3 = WHITE, TextScaled = true, Text = string.sub(n.name, 1, (utf8.offset(n.name, 2) or 2) - 1), ZIndex = 7 })
			local name = make("TextLabel", head, { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Font = FONT, TextColor3 = INK, TextStrokeColor3 = Color3.fromRGB(245, 242, 232), TextStrokeTransparency = 0.25, Text = n.name, LayoutOrder = 2, ZIndex = 6 })
			local troops = make("TextLabel", frame, { BackgroundTransparency = 1, Font = FONT, TextColor3 = INK, TextStrokeColor3 = Color3.fromRGB(245, 242, 232), TextStrokeTransparency = 0.35, LayoutOrder = 2, ZIndex = 6 })
			item = { frame = frame, head = head, avatar = avatar, initial = initial, name = name, troops = troops }
			self.labels[id] = item
			if n.userId and n.userId &gt; 0 then
				task.spawn(function()
					local thumb = self.thumbs[n.userId]
					if not thumb then
						local ok, url = pcall(function()
							return Players:GetUserThumbnailAsync(n.userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
						end)
						if ok then thumb = url self.thumbs[n.userId] = url end
					end
					if thumb and avatar.Parent then
						avatar.Image = thumb
						initial.Visible = false
					end
				end)
			end
			local cap = make("TextLabel", self.layer, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Text = "★", Font = FONT, TextColor3 = WHITE, TextStrokeColor3 = INK, TextStrokeTransparency = 0.2, ZIndex = 5 })
			self.capitals[id] = cap
		end
		-- size follows the on-screen size of the territory, clamped
		local area = math.max(1, n.labelSize or n.land or 1)
		local px = math.sqrt(area) * scale
		local font = math.clamp(px * 0.16, 9, 30)
		local isYou = id == state.you
		local visible = n.land &gt; 0 and (isYou or (lod == 0 and px &gt; 30) or (lod == 1 and px &gt; 20) or lod == 2)
		item.frame.Visible = visible
		if visible then
			item.frame.Position = self:pos(n.labelCell or n.capital)
			item.frame.Size = UDim2.fromOffset(math.max(60, font * 10), font * 2.4)
			item.head.Size = UDim2.fromOffset(0, font * 1.3)
			item.avatar.Size = UDim2.fromOffset(font * 1.25, font * 1.25)
			item.name.TextSize = font
			item.name.Size = UDim2.fromOffset(0, font * 1.3)
			local rel = state:relation(state.you, id)
			item.name.Text = (rel == "ally" and "🤝 " or rel == "war" and "⚔ " or "") .. n.name
			item.troops.Visible = isYou or lod &gt;= 1 or font &gt;= 14
			item.troops.TextSize = math.max(9, font * 0.85)
			item.troops.Size = UDim2.fromOffset(font * 6, font * 1.1)
			item.troops.Text = self.Protocol.formatK(n.troops)
		end
		local cap = self.capitals[id]
		cap.Visible = n.land &gt; 0 and (lod &gt;= 1 or isYou)
		cap.Position = self:pos(n.capital)
		cap.TextSize = math.clamp(scale * 1.6, 10, 22)
		cap.Size = UDim2.fromOffset(cap.TextSize, cap.TextSize)
		cap.TextColor3 = isYou and Color3.fromRGB(255, 226, 120) or WHITE
	end
	for id, item in pairs(self.labels) do
		if not alive[id] then
			item.frame:Destroy()
			self.labels[id] = nil
			if self.capitals[id] then self.capitals[id]:Destroy() self.capitals[id] = nil end
		end
	end
end

function OverlayRenderer:updateBuildings()
	local state, cam = self.state, self.camera
	local lod = cam:lod()
	local defs = self.Config.Buildings
	local size = math.floor(math.clamp(cam.scale * 1.7, 12, 28))
	local sizeChanged = size ~= self.iconSize or lod ~= self.iconLod
	self.iconSize, self.iconLod = size, lod
	for cell, b in pairs(state.buildings) do
		local icon = self.icons[cell]
		local fresh = false
		if not icon or icon:GetAttribute("Kind") ~= b.kind then
			if icon then icon:Destroy() end
			icon = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Font = FONT, TextScaled = true, ZIndex = 4 })
			make("UICorner", icon, { CornerRadius = UDim.new(0.3, 0) })
			make("UIStroke", icon, { Color = WHITE, Thickness = 1, Transparency = 0.2 })
			icon:SetAttribute("Kind", b.kind)
			icon.Text = defs[b.kind] and defs[b.kind].icon or "?"
			icon.Position = self:pos(cell)
			self.icons[cell] = icon
			fresh = true
		end
		if fresh or icon:GetAttribute("Owner") ~= b.owner or icon:GetAttribute("Level") ~= b.level or icon:GetAttribute("Off") ~= b.off then
			icon:SetAttribute("Owner", b.owner)
			icon:SetAttribute("Level", b.level)
			icon:SetAttribute("Off", b.off)
			icon.BackgroundColor3 = b.off and Color3.fromRGB(70, 70, 70) or rgb(state.Palette.shade(state:nationColor(b.owner), 0.75))
			local badge = icon:FindFirstChild("Level") or make("TextLabel", icon, { Name = "Level", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1.15, 1.15), Size = UDim2.fromScale(0.55, 0.55), BackgroundColor3 = INK, TextColor3 = Color3.fromRGB(240, 196, 92), Font = FONT, TextScaled = true, BorderSizePixel = 0, ZIndex = 5 })
			badge.Text = tostring(b.level)
			badge.Visible = b.level &gt; 1
		end
		if fresh or sizeChanged then
			icon.Size = UDim2.fromOffset(size, size)
			-- world view hides structures; our own appear once zoomed in a little
			icon.Visible = lod &gt;= 1
		end
	end
	for cell, icon in pairs(self.icons) do
		if not state.buildings[cell] then
			icon:Destroy()
			self.icons[cell] = nil
		end
	end
end

local function pool(list, key, factory)
	local item = list[key]
	if not item then
		item = factory()
		list[key] = item
	end
	item.used = true
	return item
end

local function release(list)
	for key, item in pairs(list) do
		if item.used then
			item.used = false
		else
			for _, inst in pairs(item) do
				if typeof(inst) == "Instance" then inst:Destroy() end
			end
			list[key] = nil
		end
	end
end

-- Fronts: arrow from where the order left our border to the clicked point, plus the
-- troops still in the field next to the active front cell.
function OverlayRenderer:updateOrders()
	local state, cam = self.state, self.camera
	local lod = cam:lod()
	for _, o in ipairs(state.orders) do
		local id, nation, target, troops, front, anchor, origin = o[1], o[2], o[3], o[4], o[5], o[6], o[7]
		local mine = nation == state.you
		local item = pool(self.orderItems, id, function()
			return {
				line = make("Frame", self.layer, { BorderSizePixel = 0, ZIndex = 3, BackgroundTransparency = 0.25 }),
				ring = make("Frame", self.layer, { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }),
				label = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.25, TextColor3 = WHITE, Font = FONT, ZIndex = 7, AutomaticSize = Enum.AutomaticSize.X }),
			}
		end)
		if not item.ring:FindFirstChild("Stroke") then
			make("UICorner", item.ring, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", item.ring, { Name = "Stroke", Thickness = 2, Color = WHITE })
			make("UICorner", item.label, { CornerRadius = UDim.new(0, 4) })
		end
		local color = rgb(state:nationColor(nation))
		local showArrow = mine and origin and origin &gt; 0
		item.line.Visible = showArrow
		item.ring.Visible = mine
		if showArrow then
			local ax, ay = self:center(origin)
			local bx, by = self:center(anchor)
			self:line(item.line, ax, ay, bx, by, 2)
			item.line.BackgroundColor3 = color
		end
		item.ring.Position = self:pos(anchor)
		item.ring.Size = UDim2.fromOffset(14, 14)
		item.ring.Stroke.Color = color
		local showLabel = front and front &gt; 0 and (mine or lod &gt;= 1 or troops &gt;= 5000)
		item.label.Visible = showLabel
		if showLabel then
			item.label.Position = self:pos(front, 0, -0.6)
			item.label.TextSize = mine and 13 or 11
			item.label.Text = (target == 0 and " ➜ " or " ⚔ ") .. self.Protocol.formatK(troops) .. " "
			item.label.Size = UDim2.fromOffset(0, mine and 18 or 15)
			item.label.BackgroundColor3 = mine and Color3.fromRGB(30, 44, 60) or INK
		end
	end
	release(self.orderItems)

	for _, w in ipairs(state.boats) do
		local id, nation, x, y, health, patrol = w[1], w[2], w[3], w[4], w[5], w[6]
		local mine = nation == state.you
		local item = pool(self.shipItems, id, function()
			local it = {
				icon = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Text = "🚢", TextScaled = true, Font = FONT, ZIndex = 6 }),
				bar = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0), BorderSizePixel = 0, BackgroundColor3 = INK, ZIndex = 6 }),
				ring = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3 }),
			}
			make("Frame", it.bar, { Name = "Fill", BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(110, 200, 130), ZIndex = 7 })
			make("UICorner", it.ring, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", it.ring, { Name = "Stroke", Thickness = 1, Transparency = 0.4 })
			return it
		end)
		local s = math.clamp(cam.scale * 1.8, 14, 26)
		local visible = lod &gt;= 1 or mine
		-- glide between the 0.4 s server updates
		if item.x ~= x or item.y ~= y then
			item.x, item.y = x, y
			local info = TweenInfo.new(self.Config.Tick.PublicOrders, Enum.EasingStyle.Linear)
			TweenService:Create(item.icon, info, { Position = self:posXY(x, y) }):Play()
			TweenService:Create(item.bar, info, { Position = self:posXY(x, y + 0.9) }):Play()
		end
		item.icon.Size = UDim2.fromOffset(s, s)
		item.icon.Visible = visible
		item.bar.Size = UDim2.fromOffset(s, 3)
		item.bar.Visible = visible
		item.bar.Fill.Size = UDim2.fromScale(math.clamp(health / self.Config.Naval.BoatHealth, 0, 1), 1)
		item.bar.Fill.BackgroundColor3 = rgb(state:nationColor(nation))
		-- our own boats show their patrol circle
		item.ring.Visible = mine and patrol ~= nil
		if patrol then
			local r = self.Config.Naval.BoatOrbit + 1
			item.ring.Position = self:pos(patrol)
			item.ring.Size = UDim2.fromScale(r * 2 / self.Map.W, r * 2 / self.Map.H)
			item.ring.Stroke.Color = rgb(state:nationColor(nation))
		end
	end
	release(self.shipItems)

	-- fires: a translucent blaze that grows with the server's radius
	for _, f in ipairs(state.fires or {}) do
		local id, center, radius = f[1], f[2], f[3]
		local item = pool(self.fireItems, id, function()
			local it = { glow = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 120, 30), BackgroundTransparency = 0.45, ZIndex = 4 }) }
			make("UICorner", it.glow, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", it.glow, { Color = Color3.fromRGB(255, 70, 20), Thickness = 2 })
			local core = make("Frame", it.glow, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.55, 0.55), BackgroundColor3 = Color3.fromRGB(255, 200, 60), BackgroundTransparency = 0.35, ZIndex = 4 })
			make("UICorner", core, { CornerRadius = UDim.new(1, 0) })
			return it
		end)
		item.glow.Position = self:pos(center)
		item.glow.Size = UDim2.fromScale(radius * 2 / self.Map.W, radius * 2 / self.Map.H)
	end
	release(self.fireItems)

	-- cargo ships carrying gold home
	for _, c in ipairs(state.cargos or {}) do
		local id, nation, cell = c[1], c[2], c[3]
		local item = pool(self.cargoItems, id, function()
			return { icon = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Text = "🚤", TextScaled = true, Font = FONT, ZIndex = 5 }) }
		end)
		local size = math.clamp(cam.scale * 1.3, 10, 18)
		item.icon.Size = UDim2.fromOffset(size, size)
		item.icon.Visible = lod &gt;= 1 or nation == state.you
		if item.cell ~= cell then
			item.cell = cell
			TweenService:Create(item.icon, TweenInfo.new(self.Config.Tick.PublicOrders, Enum.EasingStyle.Linear), { Position = self:pos(cell) }):Play()
		end
	end
	release(self.cargoItems)
end

-- Fleets and missiles move every frame between server updates.
function OverlayRenderer:animate()
	local state, Map = self.state, self.Map
	local now = os.clock()
	for id, f in pairs(state.fleets) do
		local item = pool(self.fleetItems, id, function()
			local it = {
				icon = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = INK, BackgroundTransparency = 0.2, TextColor3 = WHITE, Font = FONT, TextSize = 12, ZIndex = 8, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 18) }),
				route = make("Frame", self.layer, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3 }),
			}
			make("UICorner", it.icon, { CornerRadius = UDim.new(0, 4) })
			-- simplified route polyline (one segment every 6 water cells)
			local color = rgb(state:nationColor(f.nation))
			local path = f.path
			local step = 6
			local prev = path[1]
			for k = 1 + step, #path + step - 1, step do
				local cell = path[math.min(k, #path)]
				local seg = make("Frame", it.route, { BorderSizePixel = 0, BackgroundColor3 = color, BackgroundTransparency = 0.35, ZIndex = 3 })
				local ax, ay = self:center(prev)
				local bx, by = self:center(cell)
				self:line(seg, ax, ay, bx, by, 2)
				prev = cell
			end
			return it
		end)
		local progress = math.min(#f.path, f.progress + (now - f.t0) * f.speed)
		local k = math.max(1, math.floor(progress))
		local a, b = f.path[k], f.path[math.min(#f.path, k + 1)]
		local ax, ay = self:center(a)
		local bx, by = self:center(b)
		local t = progress - k
		item.icon.Position = self:posXY(ax + (bx - ax) * t, ay + (by - ay) * t)
		item.icon.Text = (f.air and " 🪂 " or " ⛵ ") .. self.Protocol.formatK(f.troops) .. " "
		item.route.Visible = f.nation == state.you or self.camera:lod() &gt;= 1
	end
	release(self.fleetItems)
	for id, m in pairs(state.missiles) do
		local item = pool(self.missileItems, id, function()
			local it = {
				icon = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Text = (self.Config.Weapons[m.kind] or { icon = "✈" }).icon, TextColor3 = Color3.fromRGB(255, 230, 120), TextStrokeTransparency = 0, Font = FONT, TextSize = 20, ZIndex = 9 }),
				target = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 8 }),
			}
			make("UICorner", it.target, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", it.target, { Color = Color3.fromRGB(230, 60, 50), Thickness = 2 })
			return it
		end)
		local ax, ay = self:center(m.from)
		local bx, by = self:center(m.to)
		local dist = math.max(1, math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2))
		local t = math.min(1, (m.progress + (now - m.t0) * m.speed) / dist)
		item.icon.Position = self:posXY(ax + (bx - ax) * t, ay + (by - ay) * t)
		local radius = (self.Config.Weapons[m.kind] or { radius = 3 }).radius
		item.target.Position = self:pos(m.to)
		item.target.Size = UDim2.fromScale(radius * 2 / Map.W, radius * 2 / Map.H)
	end
	release(self.missileItems)
end

function OverlayRenderer:flash(kind, cell, stopped)
	local radius = (self.Config.Weapons[kind] or { radius = 3 }).radius
	local ring = make("Frame", self.layer, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = self:pos(cell), ZIndex = 9,
		BackgroundColor3 = stopped and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(255, 210, 120),
		BackgroundTransparency = 0.1, Size = UDim2.fromScale(0, 0),
	})
	make("UICorner", ring, { CornerRadius = UDim.new(1, 0) })
	local target = UDim2.fromScale(radius * 2.4 / self.Map.W, radius * 2.4 / self.Map.H)
	local tween = TweenService:Create(ring, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = target, BackgroundTransparency = 1 })
	tween:Play()
	tween.Completed:Connect(function() ring:Destroy() end)
end

-- Reach circles: { { cell, radius, color } } (build preview, selected building, own defences).
function OverlayRenderer:setRanges(list)
	self.rangeItems = self.rangeItems or {}
	for k, r in ipairs(list) do
		local ring = self.rangeItems[k]
		if not ring then
			ring = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0.88, ZIndex = 3 })
			make("UICorner", ring, { CornerRadius = UDim.new(1, 0) })
			make("UIStroke", ring, { Name = "Stroke", Thickness = 1.5, Transparency = 0.15 })
			self.rangeItems[k] = ring
		end
		ring.Visible = true
		ring.Position = self:pos(r[1])
		ring.Size = UDim2.fromScale(r[2] * 2 / self.Map.W, r[2] * 2 / self.Map.H)
		ring.BackgroundColor3 = r[3]
		ring.Stroke.Color = r[3]
	end
	for k = #list + 1, #self.rangeItems do self.rangeItems[k].Visible = false end
end

-- Aim preview for the two-click order: arrow from our nearest border to the target.
function OverlayRenderer:setAim(fromCell, toCell, text, color)
	if not self.aim then
		self.aim = {
			line = make("Frame", self.layer, { BorderSizePixel = 0, ZIndex = 8, BackgroundTransparency = 0.1 }),
			ring = make("Frame", self.layer, { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 8, Size = UDim2.fromOffset(18, 18) }),
			label = make("TextLabel", self.layer, { AnchorPoint = Vector2.new(0.5, 1), BackgroundColor3 = INK, BackgroundTransparency = 0.1, TextColor3 = WHITE, Font = FONT, TextSize = 13, ZIndex = 9, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22) }),
		}
		make("UICorner", self.aim.ring, { CornerRadius = UDim.new(1, 0) })
		make("UIStroke", self.aim.ring, { Name = "Stroke", Thickness = 2.5, Color = WHITE })
		make("UICorner", self.aim.label, { CornerRadius = UDim.new(0, 5) })
		make("UIPadding", self.aim.label, { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) })
	end
	local aim = self.aim
	if not toCell then
		aim.line.Visible, aim.ring.Visible, aim.label.Visible = false, false, false
		return
	end
	aim.ring.Visible, aim.label.Visible = true, true
	aim.ring.Position = self:pos(toCell)
	aim.ring.Stroke.Color = color or WHITE
	aim.line.Visible = fromCell ~= nil
	if fromCell then
		local ax, ay = self:center(fromCell)
		local bx, by = self:center(toCell)
		self:line(aim.line, ax, ay, bx, by, 3)
		aim.line.BackgroundColor3 = color or WHITE
	end
	aim.label.Text = text
	aim.label.Position = self:pos(toCell, 0, -1.2)
end

return OverlayRenderer
</ProtectedString></Properties></Item></Item></Item></Item></roblox>